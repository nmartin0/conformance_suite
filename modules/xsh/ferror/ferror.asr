# XSH ferror()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.ferror.001
anchor     functions/ferror.html#RETURN VALUE
anchor     functions/ferror.html#DESCRIPTION
class      required
since      1988
says       ferror() is 0 on a stream reading "ab" when it is opened and after
           it has been read to end-of-file (feof() non-zero); on another
           stream on the same file, after fgetc() on its closed descriptor
           has returned EOF (the descriptor then restored with dup2()), it is
           non-zero, and 0 again after clearerr().
test       t/001-indicator.c

assertion  XSH.ferror.002
anchor     functions/ferror.html#DESCRIPTION
class      required
since      2008
says       With errno set to ERANGE, ferror() on a stream whose error
           indicator is clear, and on one where it is set, leaves errno
           ERANGE.
note       Added by POSIX.1-2008 TC1 (Austin Group defect 401).
test       t/002-errno-kept.c

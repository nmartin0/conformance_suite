assertion  XSH.wcstoul.001
anchor     functions/wcstoul.html#DESCRIPTION
anchor     functions/wcstoul.html#RETURN VALUE
class      required
says       wcstoul() and wcstoull(): base 10 strings "0", "7", "42", "0042",
           "+17" give 0, 7, 42, 42, 17 with the end pointer at the null; base
           0 "123" gives 123.
test       t/001-decimal.c

assertion  XSH.wcstoul.002
anchor     functions/wcstoul.html#DESCRIPTION
anchor     functions/wcstoul.html#RETURN VALUE
class      required
says       wcstoul() and wcstoull(): base 2 "1011" gives 11; base 8 "777"
           gives 511; base 16 "ff", "FF", "0xff", "0XfF" give 255; base 36
           "zz" and "ZZ" give 1295; base 12 "b9" gives 141.
test       t/002-bases.c

assertion  XSH.wcstoul.003
anchor     functions/wcstoul.html#DESCRIPTION
anchor     functions/wcstoul.html#RETURN VALUE
class      required
says       wcstoul() and wcstoull() with base 0: "0x1F" and "0X1f" give 31,
           "017" gives 15, "0" gives 0, "10" gives 10; "08" converts only the
           "0" and ends at the 8; "0x" and "0xg" convert only the "0" and end
           at the x.
test       t/003-base-zero.c

assertion  XSH.wcstoul.004
anchor     functions/wcstoul.html#DESCRIPTION
anchor     functions/wcstoul.html#RETURN VALUE
class      required
says       wcstoul() and wcstoull(): digits not below the base end the number:
           base 2 "1012" gives 5 ending at '2'; base 8 "789" gives 7 ending at
           '8'; base 16 "1fg" gives 31 ending at 'g'; base 10 "12ab" gives 12
           ending at 'a'; base 16 "0x" gives 0 ending at the 'x'.
test       t/004-digit-limits.c

assertion  XSH.wcstoul.005
anchor     functions/wcstoul.html#DESCRIPTION
anchor     functions/wcstoul.html#RETURN VALUE
class      required
says       wcstoul() and wcstoull() skip leading white space of the POSIX
           locale (space, tab, newline, vertical tab, form feed, carriage
           return, singly or in a run) before "12" (also before "+12") and put
           the end pointer at the null; white space after the digits is left
           unconsumed.
test       t/005-white-space.c

assertion  XSH.wcstoul.006
anchor     functions/wcstoul.html#DESCRIPTION
anchor     functions/wcstoul.html#RETURN VALUE
class      required
says       wcstoul() and wcstoull(): "99 bottles" (base 10) gives 99 with the
           end pointer at the space; "5-3" gives 5 ending at '-'; "1_000"
           gives 1 ending at '_'.
test       t/006-end-pointer.c

assertion  XSH.wcstoul.007
anchor     functions/wcstoul.html#DESCRIPTION
anchor     functions/wcstoul.html#RETURN VALUE
anchor     functions/wcstoul.html#ERRORS
class      required
says       wcstoul() and wcstoull(): for "", "   ", "xyz", "+", "-", "+ 1" the
           result is 0, the end pointer equals the start of the whole string
           (white space included), and errno is 0 or EINVAL.
test       t/007-no-conversion.c

assertion  XSH.wcstoul.008
anchor     functions/wcstoul.html#RETURN VALUE
anchor     functions/wcstoul.html#ERRORS
class      required
says       wcstoul() and wcstoull(): a decimal string of 41 nines gives the
           maximum of the type with ERANGE; with a leading minus it gives the
           maximum as well (negation is done in the unsigned type) with
           ERANGE; the end pointer is after the digits.
test       t/008-overflow.c

assertion  XSH.wcstoul.009
anchor     functions/wcstoul.html#DESCRIPTION
anchor     functions/wcstoul.html#RETURN VALUE
anchor     functions/wcstoul.html#ERRORS
class      required
says       wcstoul() and wcstoull(): the decimal string of the type's maximum
           converts exactly with errno unchanged; the string one above it
           gives the maximum with ERANGE.
test       t/009-limits.c

assertion  XSH.wcstoul.010
anchor     functions/wcstoul.html#DESCRIPTION
class      required
says       wcstoul() and wcstoull(): a successful conversion leaves errno at
           the value it had before (EDOM is stored before the call).
test       t/010-errno-kept.c

assertion  XSH.wcstoul.011
anchor     functions/wcstoul.html#DESCRIPTION
anchor     functions/wcstoul.html#RETURN VALUE
class      required
says       wcstoul() and wcstoull() with a null end pointer return 77 for
           "77xyz" and 0 for "junk" without crashing.
test       t/011-null-endptr.c

assertion  XSH.wcstoul.012
anchor     functions/wcstoul.html#ERRORS
class      disputed
says       wcstoul() and wcstoull() with base 37, base 1 and base -1 on "10"
           fail with errno EINVAL.
note       disputed (new): the page defines subject sequences only for base 0
           and for 2 to 36 and requires EINVAL when the base is 'not
           supported'; it does not say that every other base is unsupported,
           so an implementation might give base 1 or 37 a meaning without
           violating the text. The test requires EINVAL for 1, 37 and -1.
test       t/012-bad-base.c

assertion  XSH.wcstoul.013
anchor     functions/wcstoul.html#DESCRIPTION
anchor     functions/wcstoul.html#RETURN VALUE
class      required
says       wcstoul() and wcstoull(): a minus sign negates in the unsigned
           type: "-1" gives the maximum of the type and "-2" the maximum minus
           one, both with errno unchanged; "-0" gives 0; base 16 "-0x1" gives
           the maximum.
test       t/013-negative.c

# XSH pthread_condattr_getpshared(), pthread_condattr_setpshared()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# An out-of-range value is a may-fail error and is not tested.

assertion  XSH.pthread_condattr_getpshared.001
anchor     functions/pthread_condattr_getpshared.html#DESCRIPTION
anchor     functions/pthread_condattr_getpshared.html#RETURN VALUE
class      conditional
when       TSH
since      2001
says       In a newly initialized attributes object,
           pthread_condattr_getpshared() returns 0 and stores
           PTHREAD_PROCESS_PRIVATE.
test       t/001-default.c

assertion  XSH.pthread_condattr_getpshared.002
anchor     functions/pthread_condattr_getpshared.html#DESCRIPTION
anchor     functions/pthread_condattr_getpshared.html#RETURN VALUE
class      conditional
when       TSH
since      2001
says       pthread_condattr_setpshared() with PTHREAD_PROCESS_SHARED,
           PTHREAD_PROCESS_PRIVATE and PTHREAD_PROCESS_SHARED again each
           returns 0, and pthread_condattr_getpshared() then returns 0
           and stores the value set.
test       t/002-round-trip.c

assertion  XSH.pthread_condattr_getpshared.003
anchor     functions/pthread_condattr_getpshared.html#DESCRIPTION
anchor     functions/V2_chap02.html#2.9.9
class      conditional
when       TSH
since      2001
says       A condition variable (with its mutex) initialized with
           PTHREAD_PROCESS_SHARED in memory shared with a child process
           works between the two: a child blocked in
           pthread_cond_wait() is woken by pthread_cond_signal() in the
           parent and sees the predicate the parent set.
test       t/003-between-processes.c
timeout    60

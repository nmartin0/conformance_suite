# XSH psiginfo() and psignal()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.psiginfo.001
anchor     functions/psiginfo.html#DESCRIPTION
class      required
since      2008
says       psignal(SIGUSR1, "pc") writes to standard error "pc: " followed by
           a non-empty description of SIGUSR1 on one line ending in a
           newline.
test       t/001-psignal-format.c

assertion  XSH.psiginfo.002
anchor     functions/psiginfo.html#DESCRIPTION
class      required
since      2008
says       psignal(SIGUSR1, NULL) and psignal(SIGUSR1, "") each write the
           description and a newline, with no leading ": ", and the same
           description as psignal(SIGUSR1, "pc").
uses       XSH.psiginfo.001
test       t/002-no-message.c

assertion  XSH.psiginfo.003
anchor     functions/psiginfo.html#DESCRIPTION
class      disputed
since      2008
says       For a siginfo_t filled by sigwaitinfo() for SIGUSR1 sent by kill(),
           psiginfo(&si, "pc") writes the same line as psignal(SIGUSR1,
           "pc").
uses       XSH.psiginfo.001
note       Whether psiginfo() may add details from the siginfo_t (glibc
           adds the sender) to the description is unclear (standard
           question Q-19), so a FAIL is logged as INSPECT.
test       t/003-psiginfo-format.c

assertion  XSH.psiginfo.004
anchor     functions/psiginfo.html#DESCRIPTION
class      required
since      2008
says       With errno set to EINTR and standard error not yet oriented,
           successful psignal() and psiginfo() calls leave errno EINTR and
           fwide(stderr, 0) still 0.
uses       XSH.psiginfo.001
note       A siginfo_t made by hand with si_signo and si_code SI_USER is
           used for psiginfo().
test       t/004-errno-orientation.c

assertion  XSH.psiginfo.005
anchor     functions/psiginfo.html#DESCRIPTION
class      required
since      2008
says       With file descriptor 2 closed, psignal() sets the error indicator of
           stderr (ferror()) and sets errno to a non-zero value.
uses       XSH.psiginfo.001
note       pc_note() writes to standard error, so nothing is written
           there while fd 2 is closed.
test       t/005-error.c

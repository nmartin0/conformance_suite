# XSH pthread_condattr_init(), pthread_condattr_destroy()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# The two attributes the standard requires are the clock and the
# process-shared attribute. The clock's default is named on the
# pthread_cond_timedwait page (CLOCK_REALTIME). Waits run in a helper
# thread and are given 10 s, so that a wrong clock fails the test instead
# of hanging it.

assertion  XSH.pthread_condattr_init.001
anchor     functions/pthread_condattr_init.html#DESCRIPTION
anchor     functions/pthread_condattr_init.html#RETURN VALUE
class      required
since      2008
says       pthread_condattr_init() returns 0, pthread_condattr_destroy()
           of the initialized object returns 0, and the destroyed object
           can be initialized again (0) and destroyed again (0).
test       t/001-init-destroy.c

assertion  XSH.pthread_condattr_init.002
anchor     functions/pthread_condattr_init.html#DESCRIPTION
anchor     functions/pthread_cond_timedwait.html#DESCRIPTION
class      required
since      2008
says       pthread_condattr_init() sets the clock attribute to its
           default: on storage holding other bytes (0x00, 0xFF, 0xA5),
           and on an object that was changed to CLOCK_MONOTONIC and
           destroyed, pthread_condattr_getclock() returns 0 and stores
           CLOCK_REALTIME.
test       t/002-default-clock.c

assertion  XSH.pthread_condattr_init.003
anchor     functions/pthread_condattr_init.html#DESCRIPTION
anchor     functions/pthread_condattr_getpshared.html#DESCRIPTION
class      conditional
when       TSH
since      2008
says       As in 002, the process-shared attribute of a new or
           re-initialized object reads PTHREAD_PROCESS_PRIVATE.
test       t/003-default-pshared.c

assertion  XSH.pthread_condattr_init.004
anchor     functions/pthread_condattr_init.html#DESCRIPTION
class      required
since      2008
says       A condition variable initialized from an attributes object
           keeps the object's clock when the object is changed (to
           CLOCK_REALTIME) and destroyed afterwards: a
           pthread_cond_timedwait() with an absolute time 150 ms ahead on
           CLOCK_MONOTONIC returns ETIMEDOUT, and not before that time
           has passed on CLOCK_MONOTONIC.
test       t/004-cond-unaffected.c

# XSH sem_post()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Which waiter is released is unspecified except under the real-time
# schedulers (PS), which need privileges and are not tried. EINVAL for an
# invalid semaphore is a permission.

assertion  XSH.sem_post.001
anchor     functions/sem_post.html#DESCRIPTION
anchor     functions/sem_post.html#RETURN VALUE
class      required
says       With no thread blocked, sem_post() returns 0 and adds one to the
           value: from 0, two posts give two successful sem_trywait()
           calls and then EAGAIN; from 2, one post gives three.
test       t/001-increments.c

assertion  XSH.sem_post.002
anchor     functions/sem_post.html#DESCRIPTION
class      required
says       sem_post() on a semaphore with value 0 releases a thread blocked
           in sem_wait() (which returns 0 and was not released before the
           post); the post is consumed, so the value is still 0 afterwards.
test       t/002-wakes-waiter.c

assertion  XSH.sem_post.003
anchor     functions/sem_post.html#DESCRIPTION
class      required
says       With two threads blocked in sem_wait(), one sem_post() lets
           exactly one of them return; a second lets the other.
note       The count is taken once one thread has returned (10 s at
           most) and 300 ms more have passed; a second thread returning by
           then is a FAIL, and no thread returning at all is also a FAIL.
timeout    90
test       t/003-wakes-one.c

assertion  XSH.sem_post.004
anchor     functions/sem_post.html#ERRORS/EOVERFLOW
class      required
since      2024
says       sem_post() on a semaphore whose value is {SEM_VALUE_MAX} returns
           -1 with errno EOVERFLOW.
note       UNRESOLVED where {SEM_VALUE_MAX} is indeterminate.
test       t/004-overflow.c

assertion  XSH.sem_post.005
anchor     functions/sem_post.html#DESCRIPTION
class      required
says       sem_post() called from a signal-catching function returns 0 and
           adds one to the value.
test       t/005-from-handler.c

# XSH pthread_barrierattr_init(), pthread_barrierattr_destroy()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# The only attribute the standard names is the process-shared attribute
# (TSH).

assertion  XSH.pthread_barrierattr_init.001
anchor     functions/pthread_barrierattr_init.html#DESCRIPTION
anchor     functions/pthread_barrierattr_init.html#RETURN VALUE
class      required
since      2008
says       pthread_barrierattr_init() returns 0,
           pthread_barrierattr_destroy() of the initialized object
           returns 0, and the destroyed object can be initialized again
           (0) and destroyed again (0).
test       t/001-init-destroy.c

assertion  XSH.pthread_barrierattr_init.002
anchor     functions/pthread_barrierattr_init.html#DESCRIPTION
anchor     functions/pthread_barrierattr_getpshared.html#DESCRIPTION
class      conditional
when       TSH
since      2008
says       pthread_barrierattr_init() sets the process-shared attribute
           to its default: on storage holding other bytes (0x00, 0xFF,
           0xA5), and on an object that was set to
           PTHREAD_PROCESS_SHARED and destroyed,
           pthread_barrierattr_getpshared() returns 0 and stores
           PTHREAD_PROCESS_PRIVATE.
test       t/002-default-pshared.c

assertion  XSH.pthread_barrierattr_init.003
anchor     functions/pthread_barrierattr_init.html#DESCRIPTION
class      required
since      2008
says       A barrier initialized from an attributes object (count 2) keeps
           working when the object is destroyed afterwards: two threads
           calling pthread_barrier_wait() both return, one with
           PTHREAD_BARRIER_SERIAL_THREAD and the other with 0.
test       t/003-barrier-unaffected.c

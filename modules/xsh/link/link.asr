# XSH link() and linkat()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.link.001
anchor     functions/link.html#DESCRIPTION
class      required
since      1988
says       link("f", "g") returns 0; afterwards g names the same file as f
           (same st_dev and st_ino, same contents) and both report
           st_nlink 2.
test       t/001-second-name.c

assertion  XSH.link.002
anchor     functions/link.html#DESCRIPTION
class      required
since      1988
says       After link("f", "g") and unlink("f"), g still names the file with
           its contents and st_nlink 1.
uses       XSH.unlink.001
test       t/002-survives-original.c

assertion  XSH.link.003
anchor     functions/link.html#DESCRIPTION
class      required
since      1988
says       After link() puts a new entry in directory d, stat() reports a
           later st_ctim for the file and later st_mtim and st_ctim for d
           (the test links a fresh file every 10 ms for up to 3 s until
           the times move, so no file needs many links).
timeout    20
test       t/003-times.c

assertion  XSH.link.004
anchor     functions/link.html#DESCRIPTION
class      required
since      2008
says       linkat(AT_FDCWD, "sl", AT_FDCWD, "g", AT_SYMLINK_FOLLOW), with sl
           a symbolic link to f, makes g a name of f (a regular file with
           f's st_ino).
test       t/004-linkat-follow.c

assertion  XSH.link.005
anchor     functions/link.html#DESCRIPTION
class      required
since      2008
says       linkat(AT_FDCWD, "sl", AT_FDCWD, "g", 0), with sl a symbolic link,
           makes g a second name of the symbolic link (S_ISLNK, sl's
           st_ino, st_nlink 2).
test       t/005-linkat-nofollow.c

assertion  XSH.link.006
anchor     functions/link.html#DESCRIPTION
class      required
since      2008
says       linkat(fd1, "f", fd2, "g", 0), with fd1 open on directory d1 and
           fd2 on d2, makes d2/g a name of d1/f; nothing is created in the
           working directory.
test       t/006-linkat-relative.c

assertion  XSH.link.007
anchor     functions/link.html#DESCRIPTION
class      required
since      2008
says       linkat(AT_FDCWD, "f", AT_FDCWD, "g", 0) makes g a name of f, as
           link() does; one AT_FDCWD with one directory descriptor also
           works.
test       t/007-linkat-fdcwd.c

assertion  XSH.link.008
anchor     functions/link.html#DESCRIPTION
class      required
since      1988
says       link("f", path2) fails with EEXIST when path2 is an existing file,
           a dangling symbolic link, a directory, or a symbolic link to a
           directory; nothing is replaced, nothing is created inside the
           directory, and f's st_nlink stays 1.
test       t/008-eexist.c

assertion  XSH.link.009
anchor     functions/link.html#ERRORS
class      required
since      1988
says       link() fails with ENOENT when path1 does not exist, when path1
           or path2 is the empty string, and when path2's directory does
           not exist; no name is created.
test       t/009-enoent.c

assertion  XSH.link.010
anchor     functions/link.html#ERRORS
class      disputed
since      2008
says       link("f/x", "g") with f a regular file fails with ENOTDIR.
note       disputed (Q-8): the name also names no existing file, so
           ENOENT applies too and XSH 2.3 lets either error be reported;
           every reference system reports the more specific one.
test       t/010-enotdir.c

assertion  XSH.link.011
anchor     functions/link.html#ERRORS/ENOENT
class      required
since      2008
says       link("f", "new/"), with f a regular file and no "new", fails with
           ENOENT or ENOTDIR and creates nothing; link("f", "e/"), with e
           an existing file, fails, and not with ENOENT.
test       t/011-path2-slash.c

assertion  XSH.link.012
anchor     functions/link.html#ERRORS/EPERM
class      required
since      1988
says       For a process without appropriate privileges, link("c/d", "c/d2")
           with c/d a directory fails with EPERM (whether privileged
           processes may link directories is not tested).
note       Run as root, the test gives the directory to the unprivileged
           child (user 65534), so access to the existing file (Q-24,
           EACCES) is not in question and only EPERM applies. A child
           that still has privileges gives UNRESOLVED.
test       t/012-directory.c

assertion  XSH.link.013
anchor     functions/link.html#ERRORS
class      required
since      2001
says       link("f", "a/g"), with a -> b and b -> a, fails with ELOOP: path2's
           prefix goes through a loop of symbolic links.
note       Only ELOOP applies: the prefix component a exists (as a
           symbolic link), so link()'s ENOENT for a missing prefix
           component does not hold. The path1 case is XSH.link.026.
test       t/013-eloop.c

assertion  XSH.link.014
anchor     functions/link.html#ERRORS
class      disputed
says       link(name, "g"), with name a component longer than {NAME_MAX}
           bytes, fails with ENAMETOOLONG.
note       disputed (Q-8): the name also names no existing file, so
           ENOENT applies too and XSH 2.3 lets either error be reported;
           every reference system reports the more specific one. "since"
           left out, as for XSH.open.017: the error is unconditional
           only since _POSIX_NO_TRUNC had to be other than -1.
test       t/014-enametoolong.c

assertion  XSH.link.015
anchor     functions/link.html#ERRORS
class      required
since      2008
says       linkat() with a relative path and its descriptor not open (fd1
           for path1, or fd2 for path2) fails with EBADF.
test       t/015-linkat-ebadf.c

assertion  XSH.link.016
anchor     functions/link.html#ERRORS
class      required
since      2008
says       linkat() with a relative path and its descriptor open on a
           regular file (fd1 for path1, or fd2 for path2) fails with
           ENOTDIR.
test       t/016-linkat-enotdir.c

assertion  XSH.link.017
anchor     functions/link.html#ERRORS/EACCES
class      required
since      1988
says       For a process without appropriate privileges, link() of its own
           file to "w/g" fails with EACCES when directory w denies write
           permission, and link("s/f", ...) when directory s denies search
           permission; nothing is created.
test       t/017-eacces.c

assertion  XSH.link.018
anchor     functions/link.html#ERRORS/EACCES
class      required
since      2008
says       For a process without appropriate privileges, linkat(fd, "f",
           AT_FDCWD, "c/g", 0), with c writable by it and d/f its own file,
           fails with EACCES when fd was opened O_RDONLY on d and d's
           permissions were then changed to deny search.
test       t/018-linkat-eacces-fd.c

assertion  XSH.link.019
anchor     functions/link.html#DESCRIPTION
class      disputed
since      1988
says       A process without appropriate privileges that links a file it
           does not own but may read (mode 0644) into a directory it may
           write either succeeds or, if the implementation requires more
           access to the file, fails with EACCES.
needs      root
note       disputed (Q-24): the standard does not say what access to the
           existing file an implementation may require, or whether a
           security policy may refuse with EPERM; Linux
           (fs.protected_hardlinks) and FreeBSD
           (security.bsd.hardlink_check_uid) refuse with EPERM.
test       t/019-other-users-file.c

assertion  XSH.link.020
anchor     functions/link.html#DESCRIPTION
class      required
since      1988
says       link("sl", "g"), with sl a symbolic link to f, succeeds, and g is
           then a second name of either sl (the link itself) or f (which
           one is implementation-defined).
test       t/020-symlink.c

assertion  XSH.link.021
anchor     functions/link.html#DESCRIPTION
class      required
since      2008
says       For a process without appropriate privileges, linkat(fd, "f",
           AT_FDCWD, "c/g", 0) succeeds when fd was opened with O_SEARCH on
           d and d's permissions were then changed to deny search.
note       O_SEARCH itself is a header item (Tier 0); without it this
           test is UNRESOLVED.
test       t/021-linkat-search.c

assertion  XSH.link.022
anchor     functions/link.html#DESCRIPTION
class      required
since      2008
says       linkat() with absolute path1 and path2 succeeds whatever fd1 and
           fd2 are: descriptors that are not open, or open on a regular
           file.
test       t/022-linkat-absolute.c

assertion  XSH.link.023
anchor     functions/link.html#ERRORS/ENOENT
class      required
since      2008
says       linkat(AT_FDCWD, "dl", AT_FDCWD, "g", AT_SYMLINK_FOLLOW), with dl a
           symbolic link to a name that does not exist, fails with ENOENT
           and creates nothing.
test       t/023-follow-dangling.c

assertion  XSH.link.024
anchor     functions/link.html#ERRORS/ENOTDIR
class      required
since      2008
says       With f a regular file, link("f", "f/g") (f in the prefix of
           path2) and link("f/", "g") (path1 with a trailing slash) fail
           with ENOTDIR.
note       Only ENOTDIR applies: f exists, so neither of link()'s ENOENT
           conditions holds. The f/x case, where ENOENT may apply too,
           is XSH.link.010.
test       t/024-enotdir-existing.c

assertion  XSH.link.025
anchor     functions/link.html#ERRORS/ENAMETOOLONG
class      required
says       link("f", name), with name a component longer than {NAME_MAX}
           bytes, fails with ENAMETOOLONG.
note       Only ENAMETOOLONG applies: a missing path2 is not one of
           link()'s ENOENT conditions. The long path1 case is
           XSH.link.014. "since" is left out, as for XSH.open.017: the
           error is unconditional only since _POSIX_NO_TRUNC had to be
           other than -1.
test       t/025-enametoolong-new.c

assertion  XSH.link.026
anchor     functions/link.html#ERRORS
class      disputed
since      2001
says       link("a/x", "g"), with a -> b and b -> a, fails with ELOOP.
note       disputed (Q-8): no file named by path1 exists, since its
           resolution never ends, so link()'s ENOENT for a path1 that
           does not exist applies literally too, and XSH 2.3 lets
           either error be reported; every reference system reports
           ELOOP.
test       t/026-eloop-path1.c

# XSH fputwc()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.fputwc.001
anchor     functions/fputwc.html#DESCRIPTION
anchor     functions/fputwc.html#RETURN VALUE
class      required
says       fputwc(L'h') and fputwc(L'i') on a stream opened "w" return L'h' and
           L'i', ftell() after each is 1 and 2, and after fclose() the file holds
           exactly "hi".
test       t/001-writes.c

assertion  XSH.fputwc.002
anchor     functions/fputwc.html#DESCRIPTION
class      required
says       On a stream opened "r+" on a file "abcd", after fseek(f, 2, SEEK_SET),
           fputwc(L'X') returns L'X' and after fclose() the file holds "abXd".
test       t/002-position.c

assertion  XSH.fputwc.003
anchor     functions/fputwc.html#DESCRIPTION
class      required
says       On a stream opened "a" on a file "ab", after fseek(f, 0, SEEK_SET),
           fputwc(L'c') returns L'c' and after fclose() the file holds "abc".
test       t/003-append.c

assertion  XSH.fputwc.004
anchor     functions/fputwc.html#DESCRIPTION
class      required
says       After the modification time of a file is set to 2001-09-09, fputwc()
           on a stream opened "r+" on it followed by fflush() leaves the
           modification time later.
test       t/004-mtime.c

assertion  XSH.fputwc.005
anchor     functions/fputwc.html#DESCRIPTION
class      required
says       With errno set to ERANGE beforehand, a successful fputwc() leaves
           errno at ERANGE.
test       t/005-errno-kept.c

assertion  XSH.fputwc.006
anchor     functions/fputwc.html#ERRORS/EBADF
anchor     functions/fputwc.html#RETURN VALUE
class      required
says       On a stream opened "w" whose descriptor was closed (unbuffered where
           setvbuf() allows it, otherwise written until the buffer needs
           flushing), the failing fputwc() returns WEOF, sets errno to EBADF and
           sets the error indicator.
test       t/006-ebadf-closed.c

assertion  XSH.fputwc.007
anchor     functions/fputwc.html#ERRORS/EBADF
anchor     functions/fputwc.html#RETURN VALUE
class      required
says       On a stream opened "r" (unbuffered where allowed, otherwise written
           until the buffer needs flushing), the failing fputwc() returns WEOF,
           sets errno to EBADF and sets the error indicator.
test       t/007-ebadf-read-only.c

assertion  XSH.fputwc.008
anchor     functions/fputwc.html#ERRORS/EPIPE
anchor     functions/fputwc.html#RETURN VALUE
class      required
says       With SIGPIPE blocked, on a stream on the write end of a pipe whose
           read end is closed, the failing fputwc() returns WEOF, sets errno to
           EPIPE and sets the error indicator.
test       t/008-epipe.c

assertion  XSH.fputwc.009
anchor     functions/fputwc.html#ERRORS/EAGAIN
anchor     functions/fputwc.html#RETURN VALUE
class      required
says       On a stream on the write end of a full pipe with O_NONBLOCK set, the
           failing fputwc() returns WEOF, sets errno to EAGAIN and sets the error
           indicator.
test       t/009-eagain.c

assertion  XSH.fputwc.010
anchor     functions/fputwc.html#ERRORS/EILSEQ
anchor     functions/fputwc.html#RETURN VALUE
class      required
since      2024
says       In a UTF-8 locale, fputwc() of a wide-character code that wcrtomb()
           rejects (found by trying a few candidates) on an unbuffered stream
           returns WEOF, sets errno to EILSEQ and sets the error indicator.
note       The error indicator for EILSEQ is required by the Issue 8 text (defect
           1769).
test       t/010-eilseq.c

assertion  XSH.fputwc.011
anchor     functions/fputwc.html#DESCRIPTION
anchor     functions/V2_chap02.html#2.5
class      required
says       In a UTF-8 locale, fputwc() of the wide character that mbrtowc() gives
           for the bytes 0xc3 0xa9 returns it, and after fclose() the file holds
           exactly those two bytes.
test       t/011-multibyte.c

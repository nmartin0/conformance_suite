# XSH wcspbrk()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Strings are in arrays; returned pointers are compared with the array addresses.

assertion  XSH.wcspbrk.001
anchor     functions/wcspbrk.html#DESCRIPTION
anchor     functions/wcspbrk.html#RETURN VALUE
class      required
says       On "hello world" wcspbrk() with "ow" and with "wo" returns ws+4
           (the first code of the first string that is in the set); with "h"
           it returns ws.
test       t/001-first.c

assertion  XSH.wcspbrk.002
anchor     functions/wcspbrk.html#DESCRIPTION
anchor     functions/wcspbrk.html#RETURN VALUE
class      required
says       wcspbrk() returns a null pointer when no code of the set occurs:
           "abc" with "xyz", "abc" with an empty set, and an empty string
           with "a".
test       t/002-none.c

assertion  XSH.wcspbrk.003
anchor     functions/wcspbrk.html#DESCRIPTION
class      required
since      2024
says       wcspbrk() leaves errno unchanged on valid input, both when it is
           0 and when it is EDOM.
test       t/003-errno-kept.c

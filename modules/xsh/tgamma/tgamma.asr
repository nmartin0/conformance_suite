# XSH tgamma(), tgammaf() and tgammal()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Values are tested only where the page fixes them (special values, signed
# zeros, infinities, NaN propagation, the stated errors). The accuracy of
# results is not tested. Arguments pass through volatile objects so that
# nothing is folded at compile time. Error reports follow math_errhandling:
# errno is tested only when (math_errhandling & MATH_ERRNO) is non-zero and
# the exception flags only when (math_errhandling & MATH_ERREXCEPT) is
# non-zero; a test of an error report is NOTINUSE if neither is. Rules shaded
# as IEC 60559 floating point (MX) are NOTINUSE where __STDC_IEC_559__ is not
# defined. The three types (name, name with f, name with l) are each tested.

assertion  XSH.tgamma.001
anchor     functions/tgamma.html#RETURN VALUE
anchor     basedefs/V1_chap04.html#4.23
class      required
says       tgamma of ordinary arguments (tgamma(3.5); tgamma(0.5);
           tgamma(-1.5)) returns without setting errno (which keeps its
           earlier value, 0 or ERANGE) and without raising an invalid,
           divide-by-zero or overflow exception.
test       t/001-ordinary-no-error.c

assertion  XSH.tgamma.002
anchor     functions/tgamma.html#RETURN VALUE
anchor     basedefs/V1_chap04.html#4.24
class      required
says       A quiet NaN argument gives a NaN result with no error (errno
           unchanged, no error exception).
test       t/002-nan.c

assertion  XSH.tgamma.003
anchor     functions/tgamma.html#RETURN VALUE
class      required
since      2001
says       tgamma(+Inf) returns +Inf.
test       t/003-plus-inf.c

assertion  XSH.tgamma.004
anchor     functions/tgamma.html#RETURN VALUE
class      required
since      2001
says       tgamma(-Inf) returns a NaN.
test       t/004-minus-inf-value.c

assertion  XSH.tgamma.005
anchor     functions/tgamma.html#ERRORS/Domain Error
anchor     basedefs/V1_chap04.html#4.23
class      required
since      2001
says       tgamma(-Inf) is a domain error: errno is EDOM where
           math_errhandling includes MATH_ERRNO, and the invalid exception is
           raised where it includes MATH_ERREXCEPT.
test       t/005-minus-inf-domain.c

assertion  XSH.tgamma.006
anchor     functions/tgamma.html#RETURN VALUE
class      required
since      2001
says       tgamma of the negative integers -1, -2, -3 and -100 returns a NaN.
test       t/006-negative-integer-value.c

assertion  XSH.tgamma.007
anchor     functions/tgamma.html#RETURN VALUE
anchor     functions/tgamma.html#ERRORS/Domain Error
anchor     basedefs/V1_chap04.html#4.23
class      required
since      2001
says       tgamma of the negative integers -1, -2, -3 and -100 is a domain
           error, reported as for any domain error.
test       t/007-negative-integer-domain.c

assertion  XSH.tgamma.008
anchor     functions/tgamma.html#RETURN VALUE
class      required
since      2001
says       tgamma(+0) returns +HUGE_VAL and tgamma(-0) returns -HUGE_VAL.
test       t/008-zero-value.c

assertion  XSH.tgamma.009
anchor     functions/tgamma.html#RETURN VALUE
anchor     functions/tgamma.html#ERRORS/Pole Error
anchor     basedefs/V1_chap04.html#4.23
class      required
since      2001
says       tgamma of +0 and -0 is a pole error: errno is ERANGE where
           math_errhandling includes MATH_ERRNO, and the divide-by-zero
           exception is raised where it includes MATH_ERREXCEPT.
test       t/009-zero-pole.c

assertion  XSH.tgamma.010
anchor     functions/tgamma.html#RETURN VALUE
anchor     functions/tgamma.html#ERRORS/Range Error
anchor     basedefs/V1_chap04.html#4.23
class      required
since      2001
says       tgamma of the exponent limit of the type (128, 1024 or 16384)
           returns +HUGE_VAL as an overflow range error: errno is ERANGE
           where math_errhandling includes MATH_ERRNO, and the overflow
           exception is raised where it includes MATH_ERREXCEPT.
test       t/010-overflow.c

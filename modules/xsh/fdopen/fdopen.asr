# XSH fdopen()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.fdopen.001
anchor     functions/fdopen.html#DESCRIPTION
class      required
since      1988
says       With fd open O_RDONLY on "0123" and lseek(fd, 2, SEEK_SET),
           fdopen(fd, "r") returns a stream whose fileno() is fd, whose
           ftell() is 2 and whose first read returns '2'.
test       t/001-associates.c

assertion  XSH.fdopen.002
anchor     functions/fdopen.html#DESCRIPTION
class      required
since      1988
says       With fd open O_RDWR on "abcdef" at offset 3, after fdopen(fd, "w") the
           file is still 6 bytes; fputs("Z") and fclose() leave "abcZef".
test       t/002-no-truncate.c

assertion  XSH.fdopen.003
anchor     functions/fdopen.html#DESCRIPTION
class      required
since      2024
says       With descriptors open O_RDWR|O_APPEND, streams from fdopen() with
           "r", "r+", "w" and "w+" leave O_APPEND set, and a write through the
           "w" stream after fseek(f, 0, SEEK_SET) goes to the end.
note       Austin Group defect 1526 (Issue 8) stated it.
test       t/003-append-kept.c

assertion  XSH.fdopen.004
anchor     functions/fdopen.html#DESCRIPTION
class      required
since      2024
says       With fd open O_RDWR on an existing file, fdopen(fd, "wx") and
           fdopen(fd2, "r+x") succeed, and a write through the first reaches
           the file.
note       Austin Group defects 411 and 1526.
test       t/004-exclusive-ignored.c

assertion  XSH.fdopen.005
anchor     functions/fdopen.html#DESCRIPTION
class      required
since      2024
says       With descriptors that have FD_CLOEXEC clear, fdopen() with "re",
           "we", "r+e", "re+" and "w+e" sets it.
note       Austin Group defects 411 and 1526.
test       t/005-cloexec-set.c

assertion  XSH.fdopen.006
anchor     functions/fdopen.html#DESCRIPTION
class      required
since      2024
says       fdopen() with "r" and "w" leaves FD_CLOEXEC clear on a descriptor
           that has it clear, and set on one opened with O_CLOEXEC.
note       Austin Group defects 411 and 1526.
test       t/006-cloexec-unchanged.c

assertion  XSH.fdopen.007
anchor     functions/fdopen.html#DESCRIPTION
class      required
since      1988
says       With fd open O_RDONLY at the end of a file, and fd2 open O_WRONLY,
           streams from fdopen(fd, "r") and fdopen(fd2, "w") have ferror()
           and feof() both 0.
test       t/007-indicators-clear.c

assertion  XSH.fdopen.008
anchor     functions/fdopen.html#DESCRIPTION
class      required
since      1988
says       With fd open O_RDWR on "abcd", the stream from fdopen(fd, "r+")
           reads 'a'; after fseek(f, 0, SEEK_CUR), fputc('X') and fclose()
           the file holds "aXcd". With "w+" on another such descriptor,
           fputs("YZ"), rewind() and reads return "YZcd" (no truncation).
test       t/008-update.c

assertion  XSH.fdopen.009
anchor     functions/fdopen.html#ERRORS/EMFILE
class      required
since      2008
says       With {STREAM_MAX} from sysconf() bounded and {STREAM_MAX} streams
           open (counting stdin, stdout and stderr), fdopen() on a new
           descriptor returns a null pointer with errno EMFILE.
note       SD5-XSH-ERN-149 (Issue 7) added this error.
test       t/009-stream-max.c

assertion  XSH.fdopen.010
anchor     functions/fdopen.html#DESCRIPTION
class      required
since      1988
says       With descriptors open O_RDWR|O_APPEND on "abc": a stream from
           fdopen(fd, "a") takes fputs("Z") into the file; one from
           fdopen(fd2, "a+") reads 'a' after rewind() and, after
           fseek(f, 0, SEEK_CUR) and fputs("Y"), the file holds "abcZY".
note       With O_APPEND already set, writes go to the end whatever the
           stream's position; O_APPEND staying set for 'a' is implied
           but not stated (Q-36).
test       t/010-append-modes.c

assertion  XSH.fdopen.011
anchor     functions/fdopen.html#DESCRIPTION
class      required
since      2001
says       fdopen() with "rb", "r+b", "rb+", "wb" and "w+b" on descriptors open
           O_RDWR returns streams whose fileno() is the descriptor.
note       Issue 6 changed the mode to include binary streams; any
           string valid for fopen() is allowed.
test       t/011-binary.c

assertion  XSH.fdopen.012
anchor     functions/fdopen.html#DESCRIPTION
class      required
since      1988
says       With descriptors open O_RDWR on "abcdef" at offset 2, streams from
           fdopen() with "r+", "w" and "w+" have ftell() 2; a write of 'Z'
           through the "w" stream lands at offset 2 ("abZdef").
test       t/012-position.c

assertion  XSH.fdopen.013
anchor     functions/fdopen.html#DESCRIPTION
class      disputed
since      1988
says       With descriptors open O_RDWR on "abcdef" at offset 2, streams from
           fdopen() with "a" and "a+" have ftell() 2, and the descriptor's
           offset is still 2.
note       disputed (Q-36): fdopen() sets the position from the
           descriptor's offset, but XSH 2.5 leaves the initial position
           of a stream opened in append mode implementation-defined; a
           FAIL is logged as INSPECT.
test       t/013-append-position.c

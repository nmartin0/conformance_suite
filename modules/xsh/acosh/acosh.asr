# XSH acosh(), acoshf() and acoshl()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Values are tested only where the page fixes them (special values, signed
# zeros, infinities, NaN propagation, the stated errors). The accuracy of
# results is not tested. Arguments pass through volatile objects so that
# nothing is folded at compile time. Error reports follow math_errhandling:
# errno is tested only when (math_errhandling & MATH_ERRNO) is non-zero and
# the exception flags only when (math_errhandling & MATH_ERREXCEPT) is
# non-zero; a test of an error report is NOTINUSE if neither is. Rules shaded
# as IEC 60559 floating point (MX) are NOTINUSE where __STDC_IEC_559__ is not
# defined. The three types (name, name with f, name with l) are each tested.

assertion  XSH.acosh.001
anchor     functions/acosh.html#RETURN VALUE
anchor     basedefs/V1_chap04.html#4.23
class      required
says       acosh of ordinary arguments (acosh(2.0); acosh(10.0)) returns
           without setting errno (which keeps its earlier value, 0 or ERANGE)
           and without raising an invalid, divide-by-zero or overflow
           exception.
test       t/001-ordinary-no-error.c

assertion  XSH.acosh.002
anchor     functions/acosh.html#RETURN VALUE
anchor     basedefs/V1_chap04.html#4.24
class      required
says       A quiet NaN argument gives a NaN result with no error (errno
           unchanged, no error exception).
test       t/002-nan.c

assertion  XSH.acosh.003
anchor     functions/acosh.html#RETURN VALUE
class      required
says       acosh(+1) returns +0.
test       t/003-one.c

assertion  XSH.acosh.004
anchor     functions/acosh.html#RETURN VALUE
class      required
says       acosh(+Inf) returns +Inf.
test       t/004-plus-inf.c

assertion  XSH.acosh.005
anchor     functions/acosh.html#RETURN VALUE
class      required
says       acosh(-Inf) returns a NaN.
test       t/005-minus-inf-value.c

assertion  XSH.acosh.006
anchor     functions/acosh.html#ERRORS/Domain Error
anchor     functions/acosh.html#RETURN VALUE
class      required
says       acosh() of the finite values 0.5, 0, -2 and the negated type
           maximum is a domain error: errno is EDOM where math_errhandling
           includes MATH_ERRNO, and the invalid exception is raised where it
           includes MATH_ERREXCEPT.
test       t/006-below-one-domain.c

assertion  XSH.acosh.007
anchor     functions/acosh.html#ERRORS/Domain Error
anchor     functions/acosh.html#RETURN VALUE
class      required
says       acosh(-Inf) is a domain error, reported as for any domain error.
test       t/007-minus-inf-domain.c

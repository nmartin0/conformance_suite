# XSH wcsstr()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Strings are in arrays; returned pointers are compared with the array addresses.

assertion  XSH.wcsstr.001
anchor     functions/wcsstr.html#DESCRIPTION
anchor     functions/wcsstr.html#RETURN VALUE
class      required
says       On "abcabcd" wcsstr() returns ws+1 for "bc", ws+5 for "cd", ws
           for the whole string and ws+6 for "d"; on "aaab" it returns ws+1
           for "aab".
test       t/001-first.c

assertion  XSH.wcsstr.002
anchor     functions/wcsstr.html#RETURN VALUE
class      required
says       With an empty second string wcsstr() returns the first argument,
           also when the first string is empty.
test       t/002-empty.c

assertion  XSH.wcsstr.003
anchor     functions/wcsstr.html#DESCRIPTION
anchor     functions/wcsstr.html#RETURN VALUE
class      required
says       wcsstr() returns a null pointer when the string is absent:
           "abcabc" with "bd", "abc" with "abcd", and the array {a, b, null,
           c, d} with "bc" (a match cannot span the null code).
test       t/003-absent.c

assertion  XSH.wcsstr.004
anchor     functions/wcsstr.html#DESCRIPTION
class      required
since      2024
says       wcsstr() leaves errno unchanged on valid input, both when it is 0
           and when it is EDOM.
test       t/004-errno-kept.c

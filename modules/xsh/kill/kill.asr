# XSH kill()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.kill.001
anchor     functions/kill.html#DESCRIPTION
class      required
since      1988
says       kill() with a child's process ID sends the signal to it (the
           child's handler runs) and returns 0.
test       t/001-to-pid.c

assertion  XSH.kill.002
anchor     functions/kill.html#DESCRIPTION
class      required
since      1988
says       kill() with signal 0 returns 0 for an existing child and sends it
           no signal.
test       t/002-null-signal.c

assertion  XSH.kill.003
anchor     functions/kill.html#DESCRIPTION
class      required
since      1988
says       kill(0, sig) sends the signal to every process in the sender's
           process group, the sender included (two children in the group
           and the sender each get it once), and not to a child in another
           group.
test       t/003-own-group.c

assertion  XSH.kill.004
anchor     functions/kill.html#DESCRIPTION
class      required
since      1988
says       kill(-pgid, sig) sends the signal to every process in process
           group pgid (a child that leads it and its own child get it), and
           not to processes outside it (a child in the sender's group, the
           sender).
test       t/004-other-group.c

assertion  XSH.kill.005
anchor     functions/kill.html#DESCRIPTION
class      required
since      2001
says       kill(-1, sig) from an unprivileged process sends the signal to the
           processes it has permission to signal: another process of the
           same user gets it.
needs      root kill_uid
note       Sends kill(-1, SIGURG) as the profile's kill_uid, a user ID
           no other process may use: every process of that user on the
           machine gets the signal. The sender first proves it has no
           privilege left. SIGURG's default action is to ignore it.
test       t/005-all.c

assertion  XSH.kill.006
anchor     functions/kill.html#DESCRIPTION
class      required
since      1988
says       In a single-threaded process with nothing else pending,
           kill(getpid(), SIGUSR1) with SIGUSR1 unblocked runs its handler
           before kill() returns.
test       t/006-self-before-return.c

assertion  XSH.kill.007
anchor     functions/kill.html#ERRORS/EINVAL
class      required
since      1988
says       kill() with signal number -1 or sysconf(_SC_NSIG) (one above the
           highest supported signal) fails with EINVAL.
test       t/007-einval.c

assertion  XSH.kill.008
anchor     functions/kill.html#ERRORS/ESRCH
class      required
since      1988
says       kill() fails with ESRCH for the process ID of a group leader that
           has exited and been reaped while its group lives on (the ID
           cannot be reused while the group exists), and for minus the
           process ID of a live child that leads no group.
note       Signal 0 is used, so nothing can be sent anywhere even if the
           system misbehaves. The IDs cannot belong to another process
           (XBD 4.17).
test       t/008-esrch.c

assertion  XSH.kill.009
anchor     functions/kill.html#ERRORS/EPERM
class      required
since      1988
says       A process running as user 65534 that signals a process of user 0
           (its parent) fails with EPERM, and the signal is not sent.
needs      root
note       Assumes no extended security controls that hide processes
           apply to a plain user ID mismatch (such controls may report
           ESRCH).
test       t/009-eperm.c

assertion  XSH.kill.010
anchor     functions/kill.html#DESCRIPTION
class      required
since      1988
says       A process running as user 65534 may signal another process whose
           real and saved user IDs are 65534: kill() returns 0 and the
           signal arrives.
needs      root
test       t/010-same-user.c

assertion  XSH.kill.011
anchor     functions/kill.html#DESCRIPTION
class      required
since      1988
says       A process running as user 65534 may send SIGCONT to a process of
           user 0 in the same session (its parent): kill() returns 0 and
           the parent's SIGCONT handler runs.
needs      root
test       t/011-sigcont-session.c

assertion  XSH.kill.012
anchor     functions/kill.html#DESCRIPTION
class      required
since      2001
says       kill(-1, sig) from an unprivileged process signals the sender
           itself as well: only an unspecified set of system processes is
           left out.
needs      root kill_uid
note       Sends kill(-1, SIGURG) as the profile's kill_uid, a user ID
           no other process may use: every process of that user on the
           machine gets the signal. The sender first proves it has no
           privilege left. SIGURG's default action is to ignore it.
           Linux leaves the sender out (research 2.2).
nomutant   whether the sender is included is the kernel's choice; a
           wrapper cannot hide it without also changing XSH.kill.005
test       t/012-all-sender.c

assertion  XSH.kill.013
anchor     functions/kill.html#DESCRIPTION
class      required
since      2001
says       A process running as user 65534 in a session of its own may not
           send SIGCONT to a process of user 0 in another session (its
           parent): kill() fails with EPERM.
needs      root
test       t/013-sigcont-other-session.c

assertion  XSH.kill.014
anchor     functions/kill.html#DESCRIPTION
class      required
since      2001
says       A process running as user 65534 may not signal a process whose
           effective user ID is 65534 but whose real and saved user IDs
           are 0 (after seteuid(65534)): kill() fails with EPERM.
needs      root
test       t/014-receiver-real-saved.c

assertion  XSH.kill.015
anchor     functions/kill.html#DESCRIPTION
class      required
since      2008
says       kill(pid, 0) for a child that has terminated but has not been
           waited for returns 0: a zombie is still a process.
note       The RATIONALE (TC2, defect 765) says implementations giving
           ESRCH for a zombie do not conform, since the process lifetime
           covers zombies.
test       t/015-zombie.c

assertion  XSH.kill.016
anchor     functions/kill.html#DESCRIPTION
class      required
since      1988
says       In a process group of a process running as user 65534 (the
           sender), a process of user 65534 and one of user 65533,
           kill(0, SIGUSR1) by the sender returns 0; the process of user
           65534 gets the signal (within 5 s) and the one of user 65533
           does not.
needs      root
timeout    40
test       t/016-some-permitted.c

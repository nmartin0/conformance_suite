# XSH lchown()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.lchown.001
anchor     functions/lchown.html#DESCRIPTION
class      required
since      2001
says       With appropriate privileges, lchown("sl", 65534, 65534) changes the
           symbolic link sl's IDs and leaves its target f alone.
needs      root
test       t/001-link-itself.c

assertion  XSH.lchown.002
anchor     functions/lchown.html#DESCRIPTION
class      required
since      2001
says       With appropriate privileges, lchown("f", 65534, 65533) of a regular
           file sets its IDs as chown() would.
needs      root
test       t/002-not-a-link.c

assertion  XSH.lchown.003
anchor     functions/lchown.html#ERRORS/EPERM
class      required
since      2001
says       For a process without appropriate privileges, lchown() of a
           symbolic link it does not own, to (uid_t)-1 and its own group,
           fails with EPERM.
needs      root
test       t/003-eperm.c

assertion  XSH.lchown.004
anchor     functions/lchown.html#ERRORS
class      required
since      2001
says       lchown("missing") and lchown("") fail with ENOENT; lchown("f/x"),
           with f a regular file, fails with ENOTDIR.
test       t/004-errors.c

assertion  XSH.lchown.005
anchor     functions/lchown.html#ERRORS
class      required
since      2001
says       lchown("a/x"), with a -> b and b -> a, fails with ELOOP, and lchown()
           of a name longer than {NAME_MAX} bytes fails with ENAMETOOLONG.
note       Both names also name no existing file (ENOENT); the suite
           reads the more specific error as required (Q-8), as every
           reference system reports.
test       t/005-path-errors.c

assertion  XSH.lchown.006
anchor     functions/lchown.html#ERRORS/EACCES
class      required
since      2001
says       For a process without appropriate privileges, lchown() of its own
           symbolic link through a directory that denies search permission
           fails with EACCES.
test       t/006-eacces.c

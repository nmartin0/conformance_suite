# XSH posix_spawn_file_actions_addchdir() and posix_spawn_file_actions_addfchdir()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Both functions are new in Issue 8. Effects are shown by really spawning
# this program as a child image (the test file re-runs itself with
# "img <mode>" arguments and reports over a pipe); a directory is identified
# by device and file serial number, never by spelling. The functions return
# the error number; errno is not used.

assertion  XSH.posix_spawn_file_actions_addchdir.001
anchor     functions/posix_spawn_file_actions_addchdir.html#RETURN VALUE
anchor     functions/posix_spawn_file_actions_addchdir.html#DESCRIPTION
class      required
since      2024
says       posix_spawn_file_actions_addchdir() with the pathname of a directory
           returns 0.
test       t/001-chdir-ok.c

assertion  XSH.posix_spawn_file_actions_addchdir.002
anchor     functions/posix_spawn_file_actions_addchdir.html#DESCRIPTION
anchor     functions/posix_spawn.html#DESCRIPTION
class      required
since      2024
says       A child spawned with a chdir action has the named directory as its
           working directory (the same directory by device and serial
           number), and the parent's working directory is unchanged.
test       t/002-chdir-effect.c

assertion  XSH.posix_spawn_file_actions_addchdir.003
anchor     functions/posix_spawn_file_actions_addchdir.html#DESCRIPTION
anchor     functions/posix_spawn.html#DESCRIPTION
class      required
since      2024
says       A chdir action with a relative path and no earlier directory-changing
           action is relative to the parent's working directory.
test       t/003-chdir-relative.c

assertion  XSH.posix_spawn_file_actions_addchdir.004
anchor     functions/posix_spawn_file_actions_addchdir.html#DESCRIPTION
class      required
since      2024
says       A chdir action to a directory followed by a chdir action with a relative
           path ends in the child at that subdirectory of the first
           directory.
test       t/004-chdir-chained.c

assertion  XSH.posix_spawn_file_actions_addchdir.005
anchor     functions/posix_spawn_file_actions_addchdir.html#DESCRIPTION
class      required
since      2024
says       posix_spawn_file_actions_addchdir() copies the pathname: overwriting the
           caller's buffer after the call does not change the directory
           the child gets.
test       t/005-chdir-copies.c

assertion  XSH.posix_spawn_file_actions_addchdir.006
anchor     functions/posix_spawn_file_actions_addchdir.html#ERRORS
anchor     functions/posix_spawn.html#ERRORS
class      required
since      2024
says       posix_spawn_file_actions_addchdir() for a pathname that does not exist
           returns 0; a spawn with that action does not run the image:
           posix_spawn() returns an error number, or the child exits
           with status 127.
test       t/006-chdir-missing.c

assertion  XSH.posix_spawn_file_actions_addchdir.007
anchor     functions/posix_spawn_file_actions_addchdir.html#RETURN VALUE
anchor     functions/posix_spawn_file_actions_addchdir.html#DESCRIPTION
class      required
since      2024
says       posix_spawn_file_actions_addfchdir() with a descriptor open on a
           directory returns 0.
test       t/007-fchdir-ok.c

assertion  XSH.posix_spawn_file_actions_addchdir.008
anchor     functions/posix_spawn_file_actions_addchdir.html#DESCRIPTION
anchor     functions/posix_spawn.html#DESCRIPTION
class      required
since      2024
says       A child spawned with an fchdir action has as its working directory the
           directory the descriptor was open on, and the parent's
           working directory is unchanged.
test       t/008-fchdir-effect.c

assertion  XSH.posix_spawn_file_actions_addchdir.009
anchor     functions/posix_spawn_file_actions_addchdir.html#ERRORS/EBADF
class      required
since      2024
says       posix_spawn_file_actions_addfchdir() with a negative descriptor (-1, and
           the most negative int) returns EBADF.
test       t/009-fchdir-ebadf.c

assertion  XSH.posix_spawn_file_actions_addchdir.010
anchor     functions/posix_spawn_file_actions_addchdir.html#ERRORS
anchor     functions/posix_spawn.html#ERRORS
class      required
since      2024
says       posix_spawn_file_actions_addfchdir() with a non-negative number that is
           not open, and with a descriptor open on a regular file,
           returns 0 each time; a spawn with such an action does not run
           the image: posix_spawn() returns an error number, or the
           child exits with status 127.
test       t/010-fchdir-unusable.c

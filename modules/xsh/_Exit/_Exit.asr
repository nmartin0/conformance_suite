# XSH _Exit(), _exit()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Each test ends a child and judges from the parent.

assertion  XSH._Exit.001
anchor     functions/_Exit.html#DESCRIPTION
class      required
since      1988
says       Only the low 8 bits of the status given to _exit() are seen
           through wait() and waitpid() (0x1234 gives 0x34).
test       t/001-status-bits.c

assertion  XSH._Exit.002
anchor     functions/_Exit.html#DESCRIPTION
anchor     functions/waitid.html#DESCRIPTION
anchor     basedefs/signal.h.html#DESCRIPTION
class      required
since      2008
says       The full status value given to _exit() is available from
           waitid(): si_status is 0x1234 for _exit(0x1234).
note       Added by Austin Group defect 594 in POSIX.1-2008 Technical
           Corrigendum 2 (2016); before that only the low 8 bits were
           required. XBD <signal.h> says si_status is not limited to 8
           bits.
test       t/002-waitid-full.c

assertion  XSH._Exit.003
anchor     functions/_Exit.html#DESCRIPTION
class      required
since      2001
says       _Exit() and _exit() are functionally equivalent: both end the
           process with the given status and neither runs atexit()
           handlers.
test       t/003-same-as-_Exit.c

assertion  XSH._Exit.004
anchor     functions/_Exit.html#DESCRIPTION
class      required
since      1988
says       _exit() does not call functions registered with atexit().
test       t/004-no-handlers.c

assertion  XSH._Exit.005
anchor     functions/_Exit.html#DESCRIPTION
class      required
since      2008
says       _exit() does not flush open streams: data written with
           fputs() to a fully buffered file stream, without fflush(),
           does not reach the file.
note       In Issue 6 whether streams were flushed was implementation-
           defined; 'not flushed' came with Issue 7 (interpretation
           1003.1-2001 #085).
test       t/005-no-flush.c

assertion  XSH._Exit.006
anchor     functions/_Exit.html#DESCRIPTION
class      required
since      1988
says       Process termination closes the process's descriptors: when
           the only writer of a pipe exits, the reader sees end of file.
nomutant   descriptor closing at exit is kernel behaviour that a preload
           fault cannot keep open
test       t/006-fds-closed.c

assertion  XSH._Exit.007
anchor     functions/_Exit.html#DESCRIPTION
class      required
since      1988
says       When a child terminates, SIGCHLD is sent to its parent: with
           SIGCHLD caught and blocked, sigtimedwait() accepts it within
           10 s.
nomutant   SIGCHLD generation at exit is kernel behaviour
test       t/007-sigchld.c

assertion  XSH._Exit.008
anchor     functions/_Exit.html#DESCRIPTION
class      required
since      1988
says       A terminated child stays a zombie until its parent obtains
           its status: once waitid(WNOWAIT) shows it has terminated, its
           process ID still exists (kill() with signal 0 succeeds), and
           after the wait it is gone (ESRCH, or EPERM if the ID was
           reused).
nomutant   zombie lifetime is kernel behaviour
test       t/008-zombie.c

assertion  XSH._Exit.009
anchor     functions/_Exit.html#DESCRIPTION
class      conditional
when       XSI
since      2001
says       XSI: with SIGCHLD set to SIG_IGN in the parent, a terminating
           child's status is discarded: a wait() blocked for it fails
           with ECHILD, and the child's process ID is gone at once (no
           zombie).
nomutant   status discarding is kernel behaviour
note       XSH 2.12 states this unshaded, while 2.4.3 and the
           consequences list shade it XSI (standard issue SI-9); the
           test follows the shading.
test       t/009-sigchld-ignored.c

assertion  XSH._Exit.010
anchor     functions/_Exit.html#DESCRIPTION
class      required
since      2001
says       When a process's exit orphans a process group that has a
           stopped member, each process in that group is sent SIGHUP and
           SIGCONT; the stopped member receives both (in either order,
           since delivery order of pending signals is unspecified).
note       The middle process starts a new session, so the process that
           adopts g (an implementation-defined system process, or a
           reaper) cannot be in g's session; g's group is then orphaned
           when the middle process exits.
nomutant   the signals to an orphaned process group come from the kernel
test       t/010-orphaned-group.c

assertion  XSH._Exit.011
anchor     functions/_Exit.html#DESCRIPTION
class      required
since      2001
says       Threads ended by _exit(), the calling thread and another one,
           run neither their cancellation cleanup handlers nor their
           thread-specific data destructors.
nomutant   a preload cannot reach the application's cleanup stacks or
           keys
test       t/011-no-cleanup.c

assertion  XSH._Exit.012
anchor     functions/_Exit.html#DESCRIPTION
class      required
since      2001
says       _exit() calls no registered signal handlers: a pending,
           blocked signal with a handler is not delivered as the process
           ends, and no caught signal (SIGTERM, SIGHUP, SIGUSR2,
           SIGABRT) is raised.
test       t/012-no-signal-handlers.c

assertion  XSH._Exit.013
anchor     functions/_Exit.html#DESCRIPTION
class      required
since      2024
says       _exit() does not call functions registered with
           at_quick_exit().
note       at_quick_exit() is new in Issue 8.
test       t/013-no-quick-exit-handlers.c

assertion  XSH._Exit.014
anchor     functions/_Exit.html#DESCRIPTION
anchor     basedefs/signal.h.html#DESCRIPTION
class      required
since      2008
says       The full status value given to _exit() is in the siginfo_t
           passed to a SIGCHLD handler: si_status is 0x1234 for
           _exit(0x1234).
note       Added with XSH._Exit.002's rule (defect 594, TC2). Linux keeps
           only 8 bits here too (O.6).
test       t/014-sigchld-full.c

assertion  XSH._Exit.015
anchor     functions/_Exit.html#DESCRIPTION
class      required
since      2008
says       With two threads blocked in waitpid(-1, ...) (each having said it is
           about to wait before the only child is released) when the child
           exits with status 5, exactly one thread gets its process ID and
           status 5.
timeout    20
note       The rule came with POSIX.1-2008 TC2 (see XSH 2.12).
test       t/015-two-waiters.c

assertion  XSH._Exit.020
anchor     functions/_Exit.html#DESCRIPTION
class      disputed
since      2008
says       With two threads blocked in waitpid(-1, ...) when the only child
           exits, the thread that does not get the status fails with
           ECHILD.
timeout    20
note       disputed (Q-31): only the XSI case of SIGCHLD ignored says a
           still-blocked waiter fails with ECHILD; otherwise the text
           says one thread gets the status and is silent on the others.
test       t/020-other-waiter-echild.c

assertion  XSH._Exit.016
anchor     functions/_Exit.html#DESCRIPTION
class      conditional
when       XSI
since      2001
says       With an XSI shared memory segment attached by the parent and by a
           child (shm_nattch 2), after the child's _exit() and reaping
           shm_nattch is 1.
test       t/016-shm-detached.c

assertion  XSH._Exit.017
anchor     functions/_Exit.html#DESCRIPTION
class      conditional
when       XSI
since      2001
says       With an XSI semaphore set to 5, a child that raises it to 6 with
           SEM_UNDO and calls _exit() leaves semval 5 once it is reaped.
nomutant   The kernel applies the adjustment at exit; no interposed
           function stands between.
test       t/017-semadj.c

assertion  XSH._Exit.018
anchor     functions/_Exit.html#DESCRIPTION
class      conditional
when       MSG
since      2001
says       After a child registers for notification on a message queue through
           its inherited descriptor and calls _exit(), the parent's
           mq_notify() on the same queue succeeds (the registration went
           with the descriptor).
nomutant   The registration is released by the system at exit; no
           interposed function stands between.
test       t/018-mq-closed.c

assertion  XSH._Exit.019
anchor     functions/_Exit.html#DESCRIPTION
class      disputed
since      2008
says       A child that starts aio_write() of 64 KiB (SIGEV_NONE) and calls
           _exit() at once exits with status 0, and the file then holds the
           64 KiB.
note       disputed (Q-32): outstanding operations may be canceled at
           exit and which are is implementation-defined; a short file
           cannot be told from a cancellation after the process is gone,
           so it is logged as INSPECT. Whether completion signals are
           suppressed cannot be observed at all.
nomutant   The I/O completes in the system after the process is gone; no
           interposed function stands between.
test       t/019-aio-completes.c

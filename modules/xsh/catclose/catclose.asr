# XSH catclose()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Catalogs are made by gencat (the format is unspecified).

assertion  XSH.catclose.001
anchor     functions/catclose.html#RETURN VALUE
class      required
since      1988
says       catclose() of a descriptor returned by catopen() returns 0.
test       t/001-returns-zero.c

assertion  XSH.catclose.002
anchor     functions/catclose.html#DESCRIPTION
anchor     functions/catopen.html#DESCRIPTION
class      required
since      1988
says       Closing one of two open catalogs leaves the other one valid: a
           message is still retrieved from it.
test       t/002-other-stays-open.c

assertion  XSH.catclose.003
anchor     functions/catclose.html#DESCRIPTION
class      required
since      1988
says       After catopen() followed by catclose(), the set of open file
           descriptors is the same as before the open (a file descriptor
           used for the catalog descriptor is closed).
test       t/003-releases-descriptor.c

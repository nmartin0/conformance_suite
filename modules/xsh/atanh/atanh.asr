# XSH atanh(), atanhf() and atanhl()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Values are tested only where the page fixes them (special values, signed
# zeros, infinities, NaN propagation, the stated errors). The accuracy of
# results is not tested. Arguments pass through volatile objects so that
# nothing is folded at compile time. Error reports follow math_errhandling:
# errno is tested only when (math_errhandling & MATH_ERRNO) is non-zero and
# the exception flags only when (math_errhandling & MATH_ERREXCEPT) is
# non-zero; a test of an error report is NOTINUSE if neither is. Rules shaded
# as IEC 60559 floating point (MX) are NOTINUSE where __STDC_IEC_559__ is not
# defined. The three types (name, name with f, name with l) are each tested.

assertion  XSH.atanh.001
anchor     functions/atanh.html#RETURN VALUE
anchor     basedefs/V1_chap04.html#4.23
class      required
says       atanh of ordinary arguments (atanh(0.5); atanh(-0.25)) returns
           without setting errno (which keeps its earlier value, 0 or ERANGE)
           and without raising an invalid, divide-by-zero or overflow
           exception.
test       t/001-ordinary-no-error.c

assertion  XSH.atanh.002
anchor     functions/atanh.html#RETURN VALUE
anchor     basedefs/V1_chap04.html#4.24
class      required
says       A quiet NaN argument gives a NaN result with no error (errno
           unchanged, no error exception).
test       t/002-nan.c

assertion  XSH.atanh.003
anchor     functions/atanh.html#RETURN VALUE
class      required
says       atanh(+0) returns +0 and atanh(-0) returns -0.
test       t/003-zero.c

assertion  XSH.atanh.004
anchor     functions/atanh.html#RETURN VALUE
anchor     functions/atanh.html#ERRORS/Pole Error
anchor     basedefs/V1_chap04.html#4.23
class      required
says       atanh(+1) returns +HUGE_VAL and atanh(-1) returns -HUGE_VAL as a
           pole error: errno is ERANGE where math_errhandling includes
           MATH_ERRNO, and the divide-by-zero exception is raised where it
           includes MATH_ERREXCEPT.
test       t/004-pole.c

assertion  XSH.atanh.005
anchor     functions/atanh.html#ERRORS/Domain Error
anchor     functions/atanh.html#RETURN VALUE
class      required
says       atanh() of the finite values 2, -2 and the type maximum is a
           domain error: errno is EDOM where math_errhandling includes
           MATH_ERRNO, and the invalid exception is raised where it includes
           MATH_ERREXCEPT.
test       t/005-beyond-one-domain.c

assertion  XSH.atanh.006
anchor     functions/atanh.html#RETURN VALUE
class      required
says       atanh(+Inf) and atanh(-Inf) return a NaN.
test       t/006-inf-value.c

assertion  XSH.atanh.007
anchor     functions/atanh.html#ERRORS/Domain Error
anchor     functions/atanh.html#RETURN VALUE
class      required
says       atanh(+Inf) and atanh(-Inf) are domain errors, reported as for any
           domain error.
test       t/007-inf-domain.c

assertion  XSH.atanh.008
anchor     functions/atanh.html#RETURN VALUE
class      required
says       atanh of a positive and of a negative subnormal value returns a
           value no greater in magnitude than the type minimum (the argument
           itself is such a value).
test       t/008-subnormal.c

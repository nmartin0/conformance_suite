# XSH listen()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# The size of the listen queue is only a hint and is never tested.

assertion  XSH.listen.001
anchor     functions/listen.html#DESCRIPTION
anchor     functions/V2_chap02.html#2.10.16
class      required
since      2001
says       listen() on a bound AF_UNIX stream socket returns 0, and
           SO_ACCEPTCONN, zero before, is non-zero afterwards.
test       t/001-marks-listening.c

assertion  XSH.listen.002
anchor     functions/listen.html#DESCRIPTION
class      required
since      2001
says       Backlog values up to SOMAXCONN are supported, and a backlog
           of 0 or below 0 is accepted too: each call returns 0.
test       t/002-backlog-values.c

assertion  XSH.listen.003
anchor     functions/listen.html#ERRORS/EDESTADDRREQ
class      required
since      2001
says       listen() on an unbound stream socket (AF_UNIX and TCP)
           either succeeds or fails with EDESTADDRREQ.
note       Which of the two happens depends on whether the protocol
           supports listening unbound.
test       t/003-unbound.c

assertion  XSH.listen.004
anchor     functions/listen.html#ERRORS/EINVAL
class      required
since      2001
says       listen() on a connected socket fails with EINVAL.
test       t/004-einval-connected.c

assertion  XSH.listen.005
anchor     functions/listen.html#ERRORS/ENOTSOCK
class      required
since      2001
says       listen() on a regular-file descriptor or a pipe end fails
           with ENOTSOCK.
test       t/005-enotsock.c

assertion  XSH.listen.006
anchor     functions/listen.html#ERRORS/EBADF
class      required
since      2001
says       listen() on -1 or on a closed descriptor fails with EBADF.
test       t/006-ebadf.c

assertion  XSH.listen.007
anchor     functions/listen.html#ERRORS/EOPNOTSUPP
class      required
since      2001
says       listen() on a bound datagram socket fails with EOPNOTSUPP.
test       t/007-eopnotsupp-datagram.c

assertion  XSH.listen.008
anchor     functions/listen.html#DESCRIPTION
anchor     functions/listen.html#RETURN VALUE
class      required
since      2001
says       A second listen() on a socket that already listens succeeds
           (no listed error applies).
test       t/008-listen-twice.c

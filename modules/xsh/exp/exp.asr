# XSH exp(), expf() and expl()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Values are tested only where the page fixes them (special values, signed
# zeros, infinities, NaN propagation, the stated errors). The accuracy of
# results is not tested. Arguments pass through volatile objects so that
# nothing is folded at compile time. Error reports follow math_errhandling:
# errno is tested only when (math_errhandling & MATH_ERRNO) is non-zero and
# the exception flags only when (math_errhandling & MATH_ERREXCEPT) is
# non-zero; a test of an error report is NOTINUSE if neither is. Rules shaded
# as IEC 60559 floating point (MX) are NOTINUSE where __STDC_IEC_559__ is not
# defined. The three types (name, name with f, name with l) are each tested.

assertion  XSH.exp.001
anchor     functions/exp.html#RETURN VALUE
anchor     basedefs/V1_chap04.html#4.23
class      required
says       exp of ordinary arguments (exp(1.0); exp(-1.0); exp(0.5)) returns
           without setting errno (which keeps its earlier value, 0 or ERANGE)
           and without raising an invalid, divide-by-zero or overflow
           exception.
test       t/001-ordinary-no-error.c

assertion  XSH.exp.002
anchor     functions/exp.html#RETURN VALUE
anchor     basedefs/V1_chap04.html#4.24
class      required
says       A quiet NaN argument gives a NaN result with no error (errno
           unchanged, no error exception).
test       t/002-nan.c

assertion  XSH.exp.003
anchor     functions/exp.html#RETURN VALUE
class      required
says       exp(+0) and exp(-0) return 1.
test       t/003-zero.c

assertion  XSH.exp.004
anchor     functions/exp.html#RETURN VALUE
class      required
says       exp(-Inf) returns +0 and exp(+Inf) returns +Inf.
test       t/004-inf.c

assertion  XSH.exp.005
anchor     functions/exp.html#RETURN VALUE
anchor     functions/exp.html#ERRORS
anchor     basedefs/V1_chap04.html#4.23
class      required
says       exp of a large positive argument returns +HUGE_VAL as an overflow
           range error: errno is ERANGE where math_errhandling includes
           MATH_ERRNO, and the overflow exception is raised where it includes
           MATH_ERREXCEPT.
test       t/005-overflow.c

assertion  XSH.exp.006
anchor     functions/exp.html#RETURN VALUE
class      required
says       exp of a large negative argument (a result too small to be
           represented) returns a value no greater in magnitude than the type
           minimum, and exactly zero where IEC 60559 floating point is
           supported.
test       t/006-underflow-value.c

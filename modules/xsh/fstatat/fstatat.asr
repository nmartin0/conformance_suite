# XSH fstatat(), lstat() and stat()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.fstatat.001
anchor     functions/fstatat.html#DESCRIPTION
class      required
since      1988
says       stat() of a regular file returns 0 and fills the structure:
           S_ISREG(st_mode), the permission bits it was created with,
           st_size its length, st_nlink 1, st_uid the effective user ID,
           st_gid the effective group ID or the directory's group, and
           st_dev and st_ino those of the same file opened.
uses       XSH.fstat.001
test       t/001-stat-regular.c

assertion  XSH.fstatat.002
anchor     functions/fstatat.html#DESCRIPTION
class      required
since      1988
says       stat() of a file whose permission bits are all clear succeeds
           for a process without appropriate privileges, and reports
           those bits (no read, write or execute permission on the file
           is needed).
test       t/002-no-permission-needed.c

assertion  XSH.fstatat.003
anchor     functions/fstatat.html#DESCRIPTION
class      required
since      2001
says       stat() of a symbolic link to a regular file reports the file it
           names: S_ISREG, the target's size, st_dev and st_ino.
test       t/003-stat-follows-link.c

assertion  XSH.fstatat.004
anchor     functions/fstatat.html#DESCRIPTION
class      required
since      2001
says       lstat() of a symbolic link returns 0 with S_ISLNK(st_mode),
           st_size the length of the link's contents (no null byte),
           st_nlink 1, st_uid the effective user ID, st_gid the effective
           group ID or the directory's group, and an st_ino different
           from the target's.
test       t/004-lstat-link.c

assertion  XSH.fstatat.005
anchor     functions/fstatat.html#DESCRIPTION
class      required
since      2001
says       lstat() of a regular file and of a directory reports what stat()
           reports: the same type, permission bits, size, st_dev and
           st_ino.
test       t/005-lstat-not-link.c

assertion  XSH.fstatat.006
anchor     functions/fstatat.html#DESCRIPTION
class      required
since      1988
says       stat() reports S_ISDIR for a directory, S_ISFIFO for a FIFO and
           S_ISSOCK for a bound UNIX-domain socket, and only that type
           macro is true for each.
note       That bind() of an AF_UNIX address makes a file of type socket
           is implied by bind()'s EACCES (the name needs writing in a
           directory) and EROFS (the name would reside on a read-only
           file system), not stated (Q-45).
test       t/006-file-types.c

assertion  XSH.fstatat.007
anchor     functions/fstatat.html#DESCRIPTION
class      required
since      1988
says       After link() gives a file a second name, stat() of either name
           reports st_nlink 2.
test       t/007-nlink.c

assertion  XSH.fstatat.008
anchor     basedefs/V1_chap04.html#4.12
class      required
since      2008
says       After a write() to a file, stat() reports st_mtim and st_ctim
           later than before the write, within the system's time
           granularity (the test writes again every 10 ms for up to 3 s
           until the times move).
timeout    20
test       t/008-times-updated.c

assertion  XSH.fstatat.009
anchor     functions/fstatat.html#DESCRIPTION
class      required
since      2008
says       fstatat(fd, "name", buf, 0), with fd open on a directory, reports
           the file "name" in that directory, not one of that name in the
           working directory.
test       t/009-fstatat-relative.c

assertion  XSH.fstatat.010
anchor     functions/fstatat.html#DESCRIPTION
class      required
since      2008
says       fstatat() of a symbolic link reports the link with
           AT_SYMLINK_NOFOLLOW (S_ISLNK, the link's st_ino) and the target
           without it.
test       t/010-fstatat-nofollow.c

assertion  XSH.fstatat.011
anchor     functions/fstatat.html#DESCRIPTION
class      required
since      2008
says       fstatat(AT_FDCWD, path, buf, 0) reports what stat(path) does, and
           with AT_SYMLINK_NOFOLLOW what lstat(path) does (type, size,
           st_dev and st_ino).
test       t/011-fstatat-fdcwd.c

assertion  XSH.fstatat.012
anchor     functions/fstatat.html#DESCRIPTION
class      required
since      2008
says       fstatat() with an absolute path reports that file whatever fd is:
           a directory descriptor, a regular file's descriptor, or a
           descriptor that is not open.
test       t/012-fstatat-absolute.c

assertion  XSH.fstatat.013
anchor     functions/fstatat.html#DESCRIPTION
class      required
since      2008
says       fstatat() relative to a directory opened with O_SEARCH, whose
           permissions were then changed to deny search, succeeds for a
           process without appropriate privileges.
note       O_SEARCH itself is a header item (Tier 0); without it this
           test is UNRESOLVED.
test       t/013-fstatat-search.c

assertion  XSH.fstatat.014
anchor     basedefs/V1_chap04.html#4.16
class      required
since      2008
says       stat("link/"), lstat("link/") and fstatat(AT_FDCWD, "link/", buf,
           AT_SYMLINK_NOFOLLOW), where link is a symbolic link to a
           directory, all report the directory: a trailing slash makes the
           link be followed.
test       t/014-symlink-dir-slash.c

assertion  XSH.fstatat.015
anchor     functions/fstatat.html#ERRORS
class      required
since      1988
says       stat(), lstat() and fstatat() of a name that does not exist,
           and stat() of a path through a missing directory, fail with
           ENOENT.
test       t/015-enoent.c

assertion  XSH.fstatat.016
anchor     functions/fstatat.html#ERRORS
class      required
since      1988
says       stat(), lstat() and fstatat() of the empty string fail with
           ENOENT, also with fd a directory descriptor (the empty string
           does not name fd's directory).
test       t/016-empty.c

assertion  XSH.fstatat.017
anchor     functions/fstatat.html#ERRORS
class      disputed
since      1988
says       stat("file/x") and lstat("file/x"), where file is a regular file,
           fail with ENOTDIR; so do fstatat(fd, "file/x") and
           fstatat(fd, "file/") with fd open on a directory holding a
           regular file named file.
note       disputed (Q-8): the name also names no existing file, so
           ENOENT applies too and XSH 2.3 lets either error be reported;
           every reference system reports the more specific one.
test       t/017-enotdir-prefix.c

assertion  XSH.fstatat.018
anchor     functions/fstatat.html#ERRORS
class      required
since      2008
says       stat("file/") and lstat("file/"), where file is a regular file,
           and stat("flink/"), where flink is a symbolic link to it, fail
           with ENOTDIR.
test       t/018-enotdir-slash.c

assertion  XSH.fstatat.019
anchor     functions/fstatat.html#ERRORS
class      required
since      2001
says       stat() of a symbolic link that leads back to itself (a -> b,
           b -> a) fails with ELOOP.
test       t/019-eloop.c

assertion  XSH.fstatat.020
anchor     functions/fstatat.html#ERRORS
class      disputed
says       stat() of a path whose last component is longer than {NAME_MAX}
           bytes fails with ENAMETOOLONG.
note       disputed (Q-8): the name also names no existing file, so
           ENOENT applies too and XSH 2.3 lets either error be reported;
           every reference system reports the more specific one. "since"
           left out, as for XSH.open.017: the error is unconditional
           only since _POSIX_NO_TRUNC had to be other than -1.
test       t/020-enametoolong.c

assertion  XSH.fstatat.021
anchor     functions/fstatat.html#ERRORS
class      required
since      2008
says       fstatat(fd, "f", buf, 0) with fd a descriptor that is not open
           fails with EBADF.
test       t/021-fstatat-ebadf.c

assertion  XSH.fstatat.022
anchor     functions/fstatat.html#ERRORS
class      required
since      2008
says       fstatat(fd, "f", buf, 0) with fd open on a regular file fails with
           ENOTDIR.
test       t/022-fstatat-enotdir.c

assertion  XSH.fstatat.023
anchor     functions/fstatat.html#DESCRIPTION
class      required
since      2001
says       With dl a symbolic link to a name that does not exist, stat("dl")
           fails with ENOENT, while lstat("dl") and fstatat(AT_FDCWD, "dl",
           buf, AT_SYMLINK_NOFOLLOW) report the link (S_ISLNK).
test       t/023-dangling.c

assertion  XSH.fstatat.024
anchor     functions/fstatat.html#ERRORS/EACCES
class      required
since      1988
says       For a process without appropriate privileges, stat("d/f"),
           lstat("d/f") and fstatat(AT_FDCWD, "d/f", buf, 0) fail with
           EACCES when directory d denies search permission.
test       t/024-eacces-prefix.c

assertion  XSH.fstatat.025
anchor     functions/fstatat.html#ERRORS/EACCES
class      required
since      2008
says       For a process without appropriate privileges, fstatat(fd, "f",
           buf, 0) fails with EACCES when fd was opened O_RDONLY on a
           directory whose permissions were then changed to deny search.
test       t/025-fstatat-eacces-fd.c

assertion  XSH.fstatat.026
anchor     functions/fstatat.html#ERRORS/ENOTDIR
class      required
since      2008
says       fstatat(fd, "file/", &st, 0), stat("file/") and
           lstat("file/") with file a regular file fail with ENOTDIR.
note       Only ENOTDIR applies: the last component exists. The file/x
           cases are XSH.fstatat.017.
test       t/026-trailing-slash-file.c

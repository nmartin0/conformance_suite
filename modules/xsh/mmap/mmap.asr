# XSH mmap()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Page sizes come from sysconf(_SC_PAGESIZE). Offsets are page multiples
# (the implementation may require that); error tests arrange for exactly
# one error condition (XSH 2.3). Tests that need a signal touch memory in
# a child process with SIGSEGV and SIGBUS at their default actions.

assertion  XSH.mmap.001
anchor     functions/mmap.html#DESCRIPTION
anchor     functions/mmap.html#RETURN VALUE
class      required
since      2001
says       mmap(NULL, one page, PROT_READ, MAP_SHARED, fd, one page) of a
           three-page file returns an address other than MAP_FAILED at
           which the bytes are those of the file from offset one page.
test       t/001-file-offset.c

assertion  XSH.mmap.002
anchor     functions/mmap.html#DESCRIPTION
anchor     functions/V2_chap02.html#2.8.3.2
class      required
since      2001
says       Stores through a MAP_SHARED, PROT_READ|PROT_WRITE mapping of a
           file change the file: another process that then maps the file
           MAP_SHARED sees them, and after munmap() read() returns them;
           the file's size does not change.
note       The test reads the file with read() only after munmap(), so
           it does not depend on when an implementation without a unified
           buffer cache updates the file.
test       t/002-shared-changes-object.c

assertion  XSH.mmap.003
anchor     functions/mmap.html#DESCRIPTION
class      required
since      2001
says       A store through a MAP_PRIVATE mapping of a file is seen by the
           caller through that mapping but not by read() of the file
           (before or after munmap()) nor by another process's MAP_SHARED
           mapping of it.
note       NOTINUSE where MAP_PRIVATE fails with ENOTSUP (ERRORS lets an
           implementation not support it).
test       t/003-private-not-shared.c

assertion  XSH.mmap.004
anchor     functions/mmap.html#DESCRIPTION
anchor     functions/mmap.html#ERRORS/EACCES
class      required
since      2001
says       A MAP_PRIVATE, PROT_READ|PROT_WRITE mapping of a descriptor open
           only for reading succeeds, shows the file and takes stores,
           which do not reach the file.
note       Write permission is needed only for MAP_SHARED with PROT_WRITE.
           NOTINUSE where MAP_PRIVATE fails with ENOTSUP.
test       t/004-private-readonly-fd.c

assertion  XSH.mmap.005
anchor     functions/mmap.html#DESCRIPTION
class      required
since      2024
says       mmap() with MAP_ANONYMOUS, and with its synonym MAP_ANON, fildes
           -1 and off 0, maps new memory of len bytes (len two pages and
           one byte here) that is all zero and takes stores, for
           MAP_SHARED and for MAP_PRIVATE.
note       A MAP_PRIVATE form that fails with ENOTSUP is only noted.
test       t/005-anonymous.c

assertion  XSH.mmap.006
anchor     functions/mmap.html#DESCRIPTION
class      required
since      2024
says       A MAP_SHARED anonymous mapping is shared with a child made by
           fork(): the child sees the parent's earlier store, and the
           parent sees the child's.
test       t/006-anon-shared-fork.c

assertion  XSH.mmap.007
anchor     functions/mmap.html#DESCRIPTION
anchor     functions/mmap.html#ERRORS/EINVAL
class      required
says       mmap() with len 0 returns MAP_FAILED with errno EINVAL, for a
           file and for MAP_ANONYMOUS.
note       Added to the 2001 edition by Technical Corrigendum 2, so no
           edition year is given.
test       t/007-len-zero.c

assertion  XSH.mmap.008
anchor     functions/mmap.html#ERRORS/EINVAL
class      required
since      2001
says       mmap() of a readable file with flags 0 (neither MAP_SHARED nor
           MAP_PRIVATE) returns MAP_FAILED with errno EINVAL.
test       t/008-no-type-einval.c

assertion  XSH.mmap.009
anchor     functions/mmap.html#ERRORS/EBADF
class      required
since      2001
says       mmap() without MAP_ANONYMOUS of a descriptor that is not open
           returns MAP_FAILED with errno EBADF.
test       t/009-ebadf.c

assertion  XSH.mmap.010
anchor     functions/mmap.html#ERRORS/EACCES
class      required
since      2001
says       mmap(PROT_READ, MAP_SHARED) of a descriptor open only for
           writing, and mmap(PROT_READ|PROT_WRITE, MAP_SHARED) of one open
           only for reading, each return MAP_FAILED with errno EACCES.
note       DESCRIPTION words the second case as something the application
           ensures, while ERRORS requires the error; the error is tested,
           as for SI-68 (extended to this page).
test       t/010-eacces.c

assertion  XSH.mmap.011
anchor     functions/mmap.html#ERRORS/ENODEV
anchor     functions/mmap.html#ERRORS/ENXIO
anchor     functions/mmap.html#DESCRIPTION
class      required
since      2001
says       mmap(PROT_READ, MAP_SHARED) of the read end of a pipe returns
           MAP_FAILED with errno ENODEV or ENXIO, unless this
           implementation supports mapping pipes (then NOTINUSE).
note       Support for file types other than regular files and memory
           objects is unspecified, so a successful mapping is allowed.
           ENXIO is accepted too: an implementation can hold that no
           range [off,off+len) is valid for a pipe, and XSH 2.3 lets it
           report either error (VARIANT mmap.pipe_enxio).
test       t/011-enodev-pipe.c

assertion  XSH.mmap.012
anchor     functions/mmap.html#DESCRIPTION
anchor     functions/V2_chap02.html#2.8.3.3
class      required
since      2001
says       A store to a PROT_READ mapping (anonymous MAP_SHARED, and
           MAP_SHARED of a file) raises SIGSEGV and leaves the byte
           unchanged.
test       t/012-write-readonly-segv.c

assertion  XSH.mmap.013
anchor     functions/mmap.html#DESCRIPTION
anchor     functions/V2_chap02.html#2.8.3.3
class      required
since      2001
says       A load from, or a store to, a PROT_NONE anonymous mapping
           raises SIGSEGV, and so does a load from a PROT_NONE mapping of
           a file.
test       t/013-prot-none-segv.c

assertion  XSH.mmap.014
anchor     functions/mmap.html#DESCRIPTION
class      required
since      2001
says       MAP_SHARED mappings of a file open for reading and writing
           succeed with each of PROT_NONE, PROT_READ, PROT_WRITE and
           PROT_READ|PROT_WRITE; PROT_READ mappings show the file, and a
           store through the PROT_WRITE one reaches the file.
note       A PROT_WRITE mapping may also allow reads; the test does not
           read it. The test calls msync(MS_SYNC) before it reads the file
           with read(): without it the text promises no consistency between
           a mapping and read() (see the msync() rationale).
test       t/014-required-prot.c

assertion  XSH.mmap.015
anchor     functions/mmap.html#DESCRIPTION
class      required
since      2001
says       A mapping with len one page plus one byte includes all of its
           second page: its last byte can be loaded and stored
           (anonymous) and shows the file's byte (a two-page file).
test       t/015-partial-page.c

assertion  XSH.mmap.016
anchor     functions/mmap.html#DESCRIPTION
class      required
since      2001
says       When a file ends inside a mapped page, the bytes of that page
           after the end read as zero, even when the file was longer
           before and was truncated.
test       t/016-zero-fill-tail.c

assertion  XSH.mmap.017
anchor     functions/mmap.html#DESCRIPTION
anchor     functions/V2_chap02.html#2.8.3.3
class      required
since      2001
says       Stores past the end of a file in its last mapped page (MAP_SHARED)
           do not change the file's size, before or after munmap(), and
           when ftruncate() then extends the file the bytes there read as
           zero.
note       The zero bytes rest also on ftruncate(), which makes an
           extended part read as zero.
test       t/017-tail-not-written.c

assertion  XSH.mmap.018
anchor     functions/mmap.html#DESCRIPTION
class      required
since      2001
says       After close() of the descriptor and unlink() of the file, a
           MAP_SHARED mapping of it can still be loaded (showing the file's
           data) and stored to.
test       t/018-survives-close.c

assertion  XSH.mmap.019
anchor     functions/mmap.html#DESCRIPTION
class      required
since      2001
says       mmap(addr, 1, PROT_READ, MAP_SHARED|MAP_FIXED, fd, 0), with addr
           the second page of a three-page anonymous mapping, returns addr,
           and the whole page there then shows the file while the pages
           on each side keep their data.
note       Any MAP_FIXED request may fail with EINVAL (NOTINUSE), and a
           system without XSI need not support MAP_FIXED (ENOTSUP gives
           NOTINUSE there; on an XSI system it is a FAIL).
test       t/019-map-fixed.c

assertion  XSH.mmap.020
anchor     functions/mmap.html#DESCRIPTION
class      required
since      2001
says       mmap() without MAP_FIXED whose addr is the start of an existing
           two-page mapping returns a mapping that is not at address 0 and
           does not overlap the existing one, whose data stays; mmap()
           with addr 0 does not return address 0.
test       t/020-no-replace.c

assertion  XSH.mmap.021
anchor     functions/mmap.html#ERRORS/ENOMEM
class      required
since      2001
says       mmap() without MAP_FIXED of an anonymous MAP_SHARED mapping two
           pages short of SIZE_MAX bytes returns MAP_FAILED with errno
           ENOMEM.
note       No address space can hold such a mapping next to the program
           itself.
test       t/021-enomem.c

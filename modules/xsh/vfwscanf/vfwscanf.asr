# XSH vfwscanf(), vswscanf(), vwscanf()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.vfwscanf.001
anchor     functions/vfwscanf.html#DESCRIPTION
anchor     functions/fwscanf.html#DESCRIPTION
class      required
says       Through vswscanf(), vfwscanf() on a file and vwscanf() on a file as
           stdin, the format L"%d %ls %lc %s" on "25 hey z abc" returns 4, stores
           25, L"hey", L'z' and "abc" (char array).
test       t/001-equivalence.c

assertion  XSH.vfwscanf.002
anchor     functions/vfwscanf.html#DESCRIPTION
anchor     functions/fwscanf.html#DESCRIPTION
class      required
says       Through all three, L"%*d%l[ab]%n" on "7abba" returns 1, stores L"abba"
           and n = 5.
test       t/002-scanset-n.c

assertion  XSH.vfwscanf.003
anchor     functions/vfwscanf.html#DESCRIPTION
anchor     functions/fwscanf.html#RETURN VALUE
class      required
says       vswscanf() returns EOF for the empty string, 0 for L"x" with L"%d",
           and 1 for L"5" with L"%d %d"; vfwscanf() on an empty file returns EOF
           with feof() true.
test       t/003-return-values.c

assertion  XSH.vfwscanf.004
anchor     functions/vfwscanf.html#DESCRIPTION
anchor     functions/fwscanf.html#DESCRIPTION
class      required
says       On a stream reading "10 20", vfwscanf(f, L"%d", ...) returns 1 with 10
           and the next fgetwc() returns L' '.
test       t/004-stream-position.c

assertion  XSH.vfwscanf.005
anchor     functions/vfwscanf.html#ERRORS
anchor     functions/fwscanf.html#ERRORS
anchor     functions/fgetwc.html#ERRORS/EBADF
class      required
says       On a stream opened "r" whose descriptor was closed, vfwscanf() returns
           EOF, sets errno to EBADF and sets the error indicator.
test       t/005-ebadf.c

assertion  XSH.vfwscanf.006
anchor     functions/vfwscanf.html#DESCRIPTION
anchor     functions/fwscanf.html#DESCRIPTION
class      required
since      2008
says       vswscanf(L"1 2", L"%2$d %1$d", ...) returns 2 with the second pointer
           receiving 1 and the first 2.
test       t/006-numbered.c

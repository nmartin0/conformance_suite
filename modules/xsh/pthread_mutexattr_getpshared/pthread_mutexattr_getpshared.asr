# XSH pthread_mutexattr_getpshared(), pthread_mutexattr_setpshared()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# An out-of-range value is a may-fail error and is not tested. Use of
# another mapping of the same mutex is tested with xsh/pthread_mutex_init.

assertion  XSH.pthread_mutexattr_getpshared.001
anchor     functions/pthread_mutexattr_getpshared.html#DESCRIPTION
anchor     functions/pthread_mutexattr_getpshared.html#RETURN VALUE
class      conditional
when       TSH
since      2001
says       In a newly initialized attributes object,
           pthread_mutexattr_getpshared() returns 0 and stores
           PTHREAD_PROCESS_PRIVATE.
test       t/001-default.c

assertion  XSH.pthread_mutexattr_getpshared.002
anchor     functions/pthread_mutexattr_getpshared.html#DESCRIPTION
anchor     functions/pthread_mutexattr_getpshared.html#RETURN VALUE
class      conditional
when       TSH
since      2001
says       pthread_mutexattr_setpshared() with PTHREAD_PROCESS_SHARED,
           PTHREAD_PROCESS_PRIVATE and PTHREAD_PROCESS_SHARED again each
           returns 0, and pthread_mutexattr_getpshared() then returns 0
           and stores the value set.
test       t/002-round-trip.c

assertion  XSH.pthread_mutexattr_getpshared.003
anchor     functions/pthread_mutexattr_getpshared.html#DESCRIPTION
anchor     functions/V2_chap02.html#2.9.9
class      conditional
when       TSH
since      2001
says       A mutex initialized with PTHREAD_PROCESS_SHARED in memory
           shared with a child process works between the two processes:
           while the parent holds it, the child's pthread_mutex_trylock()
           returns EBUSY and its pthread_mutex_lock() does not return;
           after the parent unlocks it, that lock returns 0.
test       t/003-between-processes.c
timeout    60

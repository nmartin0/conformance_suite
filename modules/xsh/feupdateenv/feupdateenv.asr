# XSH feupdateenv()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Every exception and rounding macro is optional (XBD <fenv.h>): a test that
# uses one is NOTINUSE when it is not defined, or when fewer than two
# rounding directions can be selected.

assertion  XSH.feupdateenv.001
anchor     functions/feupdateenv.html#DESCRIPTION
anchor     functions/feupdateenv.html#RETURN VALUE
class      required
since      2001
says       feupdateenv() returns zero for an environment stored by fegetenv().
test       t/001-getenv.c

assertion  XSH.feupdateenv.002
anchor     functions/feupdateenv.html#DESCRIPTION
anchor     functions/feupdateenv.html#RETURN VALUE
class      required
since      2001
says       feupdateenv() returns zero for an environment stored by
           feholdexcept().
note       The test is UNRESOLVED when feholdexcept() does not return zero (see
           the note of XSH.feholdexcept.001).
test       t/002-holdexcept.c

assertion  XSH.feupdateenv.003
anchor     functions/feupdateenv.html#DESCRIPTION
anchor     functions/feupdateenv.html#RETURN VALUE
anchor     basedefs/fenv.h.html#DESCRIPTION
class      required
since      2001
says       FE_DFL_ENV is a valid argument of feupdateenv(), which returns zero.
test       t/003-default-env.c

assertion  XSH.feupdateenv.004
anchor     functions/feupdateenv.html#DESCRIPTION
class      required
since      2001
says       After the rounding direction is changed, feupdateenv() with an
           environment stored by fegetenv() reinstates the stored direction.
test       t/004-rounding.c

assertion  XSH.feupdateenv.005
anchor     functions/feupdateenv.html#DESCRIPTION
class      required
since      2001
says       An exception raised when feupdateenv() is called is raised again
           after the environment is installed, although the stored environment
           had its flag clear.
test       t/005-reraise.c

assertion  XSH.feupdateenv.006
anchor     functions/feupdateenv.html#DESCRIPTION
class      required
since      2001
says       After feupdateenv(), both a flag that the stored environment had set
           and a different exception raised just before the call are set.
test       t/006-union.c

assertion  XSH.feupdateenv.007
anchor     functions/feupdateenv.html#DESCRIPTION
class      required
since      2001
says       Between feholdexcept() and feupdateenv(), an exception that was
           raised and then cleared is not set after feupdateenv(), while an
           exception set before feholdexcept() is set again.
test       t/007-spurious.c

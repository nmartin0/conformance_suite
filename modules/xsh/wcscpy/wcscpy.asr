# XSH wcscpy() and wcpcpy()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Sources are in arrays and destinations are filled with L'X' first, so that codes written past the terminator show.

assertion  XSH.wcscpy.001
anchor     functions/wcscpy.html#DESCRIPTION
anchor     functions/wcscpy.html#RETURN VALUE
class      required
says       wcscpy() of "", "a" and a 300-code string copies the string and
           its null into the destination, changes nothing after it, and
           returns the destination pointer.
test       t/001-wcscpy.c

assertion  XSH.wcscpy.002
anchor     functions/wcscpy.html#DESCRIPTION
anchor     functions/wcscpy.html#RETURN VALUE
class      required
since      2008
says       wcpcpy() of the same strings copies them the same way and returns
           a pointer to the null code it copied (destination + length).
test       t/002-wcpcpy.c

assertion  XSH.wcscpy.003
anchor     functions/wcscpy.html#DESCRIPTION
class      required
since      2024
says       wcscpy() and wcpcpy() leave errno unchanged on valid input, both
           when it is 0 and when it is EDOM.
test       t/003-errno-kept.c

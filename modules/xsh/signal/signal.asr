# XSH signal()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.signal.001
anchor     functions/signal.html#DESCRIPTION
class      required
since      1988
says       signal(SIGUSR1, h1) after signal(SIGUSR1, SIG_IGN) returns SIG_IGN;
           then signal(SIGUSR1, h2) returns h1, and signal(SIGUSR1,
           SIG_DFL) returns h2.
test       t/001-returns-previous.c

assertion  XSH.signal.002
anchor     functions/signal.html#DESCRIPTION
class      required
since      1988
says       A child that sets SIGUSR1 to SIG_IGN with signal() and sends it to
           itself carries on (it reports so on a pipe); after setting SIG_DFL
           and sending it again it is terminated by SIGUSR1.
test       t/002-dfl-ign.c

assertion  XSH.signal.003
anchor     functions/signal.html#DESCRIPTION
class      required
since      1988
says       A handler installed with signal() for SIGUSR1 is called with
           SIGUSR1 as its argument when the signal is sent, and the program
           goes on after the kill() call.
test       t/003-handler-called.c

assertion  XSH.signal.004
anchor     functions/signal.html#DESCRIPTION
class      required
since      1988
says       In a child, a handler installed with signal() for SIGUSR1
           raises SIGUSR1 again from inside itself: either the child is
           then ended by SIGUSR1 (the action was reset to SIG_DFL), or
           the handler is not re-entered while it runs (the signal is
           held off).
note       Judged by behaviour: after signal() the oact that sigaction()
           returns is unspecified, and "prevent ... from occurring" need
           not show in the signal mask. A held-off signal that is never
           delivered is noted, not failed.
test       t/004-reset-or-block.c

assertion  XSH.signal.005
anchor     functions/signal.html#ERRORS/EINVAL
class      required
since      1988
says       signal() returns SIG_ERR with errno EINVAL for signal numbers -1 and
           100000, for catching SIGKILL and for ignoring SIGSTOP.
test       t/005-einval.c

assertion  XSH.signal.006
anchor     functions/signal.html#DESCRIPTION
class      required
since      2008
says       With errno set to EINTR, a successful signal(SIGUSR1, SIG_IGN) leaves
           errno EINTR.
test       t/006-errno-kept.c

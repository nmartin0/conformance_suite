# XSH mq_close()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Message passing option (MSG). Using a descriptor after mq_close() is
# undefined, so EBADF is tested only with a descriptor that was never valid.

assertion  XSH.mq_close.001
anchor     functions/mq_close.html#DESCRIPTION
anchor     functions/mq_close.html#RETURN VALUE
anchor     functions/mq_open.html#DESCRIPTION
class      conditional
when       MSG
since      2001
says       mq_close() returns 0; the queue and its messages are unaffected
           for the other descriptors, and after the last descriptor is
           closed (the name not unlinked) the name still opens the queue
           with its message.
test       t/001-persists.c

assertion  XSH.mq_close.002
anchor     functions/mq_close.html#ERRORS/EBADF
class      conditional
when       MSG
since      2001
says       mq_close() of an invalid descriptor fails with EBADF.
test       t/002-ebadf.c

assertion  XSH.mq_close.003
anchor     functions/mq_close.html#DESCRIPTION
class      conditional
when       MSG
since      2001
says       When the descriptor through which the process registered for
           notification is closed, the registration is removed: another
           registration for the queue then succeeds (where it failed with
           EBUSY before).
test       t/003-notify-removed.c

assertion  XSH.mq_close.004
anchor     functions/mq_close.html#DESCRIPTION
class      conditional
when       MSG
since      2024
says       Where opening a queue takes a file descriptor (the lowest free
           descriptor moves up), mq_close() gives it back (the lowest free
           descriptor returns to what it was).
note       NOTINUSE where mq_open() takes no file descriptor.
test       t/004-fd-closed.c

# XSH alphasort() and scandir()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.alphasort.001
anchor     functions/alphasort.html#RETURN VALUE
class      required
since      2008
says       In the POSIX locale, alphasort() of entries "apple" and "banana"
           is negative one way and positive the other, and 0 for "apple"
           against "apple"; errno is left unchanged (set to EDOM before).
test       t/001-alphasort.c

assertion  XSH.alphasort.002
anchor     functions/alphasort.html#DESCRIPTION
class      required
since      2008
says       scandir("d", &nl, sel, alphasort), with d holding c, a, b and x.skip
           and sel rejecting names starting with "x" or ".", calls sel for
           each of a, b, c and x.skip, returns 3, and nl holds a, b and c in
           that order.
note       That sel is called only once per entry is XSH.alphasort.010
           (disputed).
test       t/002-scandir-sorted.c

assertion  XSH.alphasort.003
anchor     functions/alphasort.html#DESCRIPTION
class      required
since      2008
says       scandir("d", &nl, NULL, alphasort), with d holding a and b, returns
           the number of entries in nl, which holds a and b once each and
           otherwise only dot and dot-dot (at most once each).
test       t/003-scandir-null-sel.c

assertion  XSH.alphasort.004
anchor     functions/alphasort.html#DESCRIPTION
class      required
since      2008
says       scandir("d", &nl, sel, rev), with rev ordering names in reverse,
           returns c, b and a in that order.
test       t/004-scandir-compar.c

assertion  XSH.alphasort.005
anchor     functions/alphasort.html#ERRORS/ENOENT
class      required
since      2008
says       scandir("missing", ...) and scandir("", ...) return -1 with errno
           ENOENT.
test       t/005-scandir-enoent.c

assertion  XSH.alphasort.006
anchor     functions/alphasort.html#ERRORS/ENOTDIR
class      disputed
since      2008
says       scandir("f", ...) with f a regular file returns -1 with errno
           ENOTDIR.
note       disputed (SI-55): the [ENOENT] entry speaks of a component
           that names no existing directory, which a regular file (or a
           loop of links) also meets, so XSH 2.3 lets ENOENT be reported
           too; every reference system reports the more specific error.
test       t/006-scandir-enotdir.c

assertion  XSH.alphasort.007
anchor     functions/alphasort.html#ERRORS/ENAMETOOLONG
class      disputed
says       scandir() of a name longer than {NAME_MAX} bytes returns -1 with
           errno ENAMETOOLONG.
note       disputed (Q-8): the name also names no existing file, so
           ENOENT applies too and XSH 2.3 lets either error be reported;
           every reference system reports the more specific one. "since"
           left out, as for XSH.open.017: the error is unconditional
           only since _POSIX_NO_TRUNC had to be other than -1.
test       t/007-scandir-enametoolong.c

assertion  XSH.alphasort.008
anchor     functions/alphasort.html#ERRORS/EACCES
class      required
since      2008
says       For an unprivileged process, scandir() of its own directory with
           mode 0300 returns -1 with errno EACCES.
test       t/008-scandir-eacces.c

assertion  XSH.alphasort.009
anchor     functions/alphasort.html#ERRORS/ELOOP
class      disputed
since      2008
says       scandir("a", ...), with a -> b and b -> a, returns -1 with errno
           ELOOP.
note       disputed (SI-55): the [ENOENT] entry speaks of a component
           that names no existing directory, which a regular file (or a
           loop of links) also meets, so XSH 2.3 lets ENOENT be reported
           too; every reference system reports the more specific error.
test       t/009-scandir-eloop.c

assertion  XSH.alphasort.010
anchor     functions/alphasort.html#DESCRIPTION
class      disputed
since      2008
says       scandir("d", &nl, sel, alphasort), with d holding c, a, b and x.skip,
           calls sel exactly once for each of a, b, c and x.skip.
note       disputed (Q-58): the text says sel is called on each entry
           but not that it is called only once; an implementation that reads
           the directory twice (to count, then to fill) calls it twice and
           can be read as conforming. A FAIL is logged as INSPECT.
test       t/010-scandir-sel-once.c

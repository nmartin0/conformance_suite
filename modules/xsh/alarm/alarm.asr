# XSH alarm()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.alarm.001
anchor     functions/alarm.html#DESCRIPTION
class      required
since      1988
says       alarm(1) returns 0 (no earlier alarm) and SIGALRM is generated no
           earlier than 1 s later (10 ms tolerance) (accepted within 10 s).
uses       XSH.sigtimedwait.002 XSH.sigtimedwait.005
note       Scheduling delays may hold the signal back, so only the lower
           bound is tight.
test       t/001-fires.c

assertion  XSH.alarm.002
anchor     functions/alarm.html#DESCRIPTION
class      required
since      1988
says       alarm(0) after alarm(1) returns 1 (rounded up seconds left, at most
           1) and no SIGALRM comes in the next 2 s.
uses       XSH.sigtimedwait.002 XSH.sigtimedwait.005
note       alarm() returns a non-zero value for an alarm with time
           remaining; with under a second left that is 1.
test       t/002-cancel.c

assertion  XSH.alarm.003
anchor     functions/alarm.html#DESCRIPTION
class      required
since      1988
says       After alarm(10) and a 1 s pause, alarm(2) returns the seconds left
           on the first alarm (8 to 10) and SIGALRM comes about 2 s later,
           not 10 s.
uses       XSH.sigtimedwait.002 XSH.sigtimedwait.005
test       t/003-reschedule.c

assertion  XSH.alarm.004
anchor     functions/alarm.html#DESCRIPTION
class      required
since      1988
says       After alarm(2) and then alarm(1), one SIGALRM comes about 1 s
           later (no earlier than 990 ms, and before 1.9 s) and no second
           one follows in the next 2.5 s, when the replaced request would
           have fired.
uses       XSH.sigtimedwait.002 XSH.sigtimedwait.005
test       t/004-not-stacked.c

assertion  XSH.alarm.005
anchor     functions/alarm.html#DESCRIPTION
class      required
since      2001
says       With SIGALRM blocked in the main thread and caught, after alarm(1)
           in the main thread the handler runs in a second thread that does
           not block SIGALRM (within 3 s).
timeout    20
test       t/005-to-process.c

# XSH pthread_rwlock_clockrdlock(), pthread_rwlock_timedrdlock()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# The timed call is made in a helper thread, which gets 10 s before the
# test fails. Reader/writer priority and recursive read locking limits
# are unspecified and not tested.

assertion  XSH.pthread_rwlock_clockrdlock.001
anchor     functions/pthread_rwlock_clockrdlock.html#DESCRIPTION
anchor     functions/pthread_rwlock_clockrdlock.html#RETURN VALUE
class      required
since      2008
says       On an unlocked lock, pthread_rwlock_timedrdlock() with an
           absolute time long past, and pthread_rwlock_clockrdlock() with
           CLOCK_REALTIME and with CLOCK_MONOTONIC and a time long past,
           each return 0 and take a read lock: a lock that can be had at
           once does not time out.
test       t/001-immediate.c

assertion  XSH.pthread_rwlock_clockrdlock.002
anchor     functions/pthread_rwlock_clockrdlock.html#DESCRIPTION
anchor     functions/pthread_rwlock_clockrdlock.html#ERRORS/ETIMEDOUT
class      required
since      2008
says       pthread_rwlock_timedrdlock() on a lock another thread holds for
           writing, with an absolute CLOCK_REALTIME time 150 ms ahead,
           returns ETIMEDOUT and not before that time has passed on
           CLOCK_REALTIME.
test       t/002-timedlock-timeout.c

assertion  XSH.pthread_rwlock_clockrdlock.003
anchor     functions/pthread_rwlock_clockrdlock.html#DESCRIPTION
anchor     functions/pthread_rwlock_clockrdlock.html#ERRORS/ETIMEDOUT
class      required
since      2024
says       pthread_rwlock_clockrdlock() on a lock another thread holds for
           writing, with CLOCK_REALTIME and with CLOCK_MONOTONIC and an
           absolute time 150 ms ahead on that clock, returns ETIMEDOUT and
           not before the time has passed on that clock.
test       t/003-clocklock-timeout.c

assertion  XSH.pthread_rwlock_clockrdlock.004
anchor     functions/pthread_rwlock_clockrdlock.html#DESCRIPTION
class      required
since      2008
says       Timed read locking can be shared: while the main thread holds a
           read lock, a helper thread's timedrdlock and clockrdlock with a
           time ahead return 0.
test       t/004-shared-readers.c

assertion  XSH.pthread_rwlock_clockrdlock.005
anchor     functions/pthread_rwlock_clockrdlock.html#DESCRIPTION
anchor     functions/pthread_rwlock_clockrdlock.html#RETURN VALUE
class      required
since      2008
says       A timed read lock that waits on a write-locked lock returns 0,
           not ETIMEDOUT, when the write lock is released before the
           (generous) time passes.
test       t/005-released-while-waiting.c

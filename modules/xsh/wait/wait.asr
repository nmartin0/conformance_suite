# XSH wait(), waitpid()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Error tests arrange for exactly one error condition (XSH 2.3). A wait
# that blocks when it must not is cut short by a caught SIGALRM and FAILs.

assertion  XSH.wait.001
anchor     functions/wait.html#DESCRIPTION
anchor     functions/wait.html#RETURN VALUE
class      required
since      1988
says       wait() blocks until a child terminates, then returns that
           child's process ID and stores its status: WIFEXITED is true
           and WEXITSTATUS gives the exit value (42).
test       t/001-wait-blocks.c

assertion  XSH.wait.002
anchor     functions/wait.html#DESCRIPTION
class      required
since      1988
says       When a child has already terminated (its SIGCHLD is pending),
           wait() returns its status at once, within 300 ms.
test       t/002-wait-immediate.c

assertion  XSH.wait.003
anchor     functions/wait.html#DESCRIPTION
class      required
since      2001
says       The stored status is 0 exactly for a child that called
           _exit(0) or exit(0), or returned 0 from main(), and not 0 for
           _exit(1).
note       The return-from-main case runs this test's own program again
           through execv(), with argv[0] as its path.
test       t/003-status-zero.c

assertion  XSH.wait.004
anchor     functions/wait.html#DESCRIPTION
class      required
since      1988
says       WEXITSTATUS gives the low-order 8 bits of the value passed to
           _exit() (0x1ff gives 255).
test       t/004-low-8-bits.c

assertion  XSH.wait.005
anchor     functions/wait.html#DESCRIPTION
class      required
since      1988
says       For a child killed by an uncaught signal, WIFSIGNALED is
           true, WIFEXITED false, and WTERMSIG gives the signal
           (SIGTERM).
test       t/005-signaled.c

assertion  XSH.wait.006
anchor     functions/wait.html#DESCRIPTION
class      required
since      1988
says       waitpid() with a positive pid reports only that child, even
           when another child terminated first.
test       t/006-pid-specific.c

assertion  XSH.wait.007
anchor     functions/wait.html#DESCRIPTION
class      required
since      1988
says       waitpid((pid_t)-1, &st, 0) reports any child, as wait() does.
test       t/007-pid-any.c

assertion  XSH.wait.008
anchor     functions/wait.html#DESCRIPTION
class      required
since      1988
says       waitpid(0, ...) reports only children in the caller's process
           group: a child that moved to its own group and exited first
           is not reported.
test       t/008-pid-zero.c

assertion  XSH.wait.009
anchor     functions/wait.html#DESCRIPTION
class      required
since      1988
says       waitpid(-pgid, ...) reports only children in process group
           pgid: a child in the caller's group that exited first is not
           reported.
test       t/009-pid-group.c

assertion  XSH.wait.010
anchor     functions/wait.html#DESCRIPTION/WNOHANG
anchor     functions/wait.html#RETURN VALUE
class      required
since      1988
says       waitpid() with WNOHANG returns 0 at once when the child named
           is still running.
test       t/010-wnohang.c

assertion  XSH.wait.011
anchor     functions/wait.html#DESCRIPTION/WUNTRACED
anchor     functions/wait.html#DESCRIPTION
class      required
since      1988
says       waitpid() with WUNTRACED reports a stopped child: WIFSTOPPED
           is true, WSTOPSIG gives the signal (SIGSTOP), and WIFEXITED
           and WIFSIGNALED are false.
test       t/011-wuntraced.c

assertion  XSH.wait.012
anchor     functions/wait.html#DESCRIPTION/WCONTINUED
anchor     functions/wait.html#DESCRIPTION
class      conditional
when       XSI
since      2001
says       XSI: waitpid() with WCONTINUED reports a child continued by
           SIGCONT from a stop: WIFCONTINUED is true and WIFEXITED,
           WIFSIGNALED and WIFSTOPPED are false.
note       The child must stay alive after it is continued: new status
           replaces the continued status (XSH 2.12), so a child that
           exits at once may rightly be reported as exited.
test       t/012-wcontinued.c

assertion  XSH.wait.013
anchor     functions/wait.html#DESCRIPTION
class      required
since      1988
says       Without WUNTRACED a stopped child is not reported:
           waitpid(pid, &st, WNOHANG) returns 0 while it is stopped.
note       Setup waits for the stop with waitid(WSTOPPED | WNOWAIT),
           which leaves it unconsumed: nothing bounds how soon the child
           stops (variant wait.slow_stop).
test       t/013-stop-not-reported.c

assertion  XSH.wait.014
anchor     functions/wait.html#RETURN VALUE
anchor     functions/wait.html#ERRORS/EINTR
class      required
since      1988
says       wait() interrupted by a caught signal (without SA_RESTART)
           returns -1 with EINTR.
note       The child lives 3 s; a wait() that restarts after the signal
           returns the child instead, and FAILs.
test       t/014-eintr.c

assertion  XSH.wait.015
anchor     functions/wait.html#ERRORS/ECHILD
class      required
since      1988
says       wait() with no children fails with ECHILD.
test       t/015-echild.c

assertion  XSH.wait.016
anchor     functions/wait.html#ERRORS/ECHILD
class      required
since      1988
says       waitpid() for a process that is not a child of the caller
           (its parent) fails with ECHILD, while the caller has a live
           child, so that only the not-a-child condition applies.
test       t/016-echild-not-child.c

assertion  XSH.wait.017
anchor     functions/wait.html#ERRORS/EINVAL
class      required
since      1988
says       waitpid() with an invalid options value fails with EINVAL:
           of WNOHANG plus one bit that no flag in <sys/wait.h> uses (bit
           22, 0x400000, then bits 4 to 30), at least one fails with
           EINVAL.
note       An implementation may define extension flags (W names are
           reserved in <sys/wait.h>, XSH 2.2.2), so a single bit could be
           valid; one accepted bit is not a FAIL, but accepting every
           bit tried is (variant wait.ext_option).
test       t/017-einval.c

assertion  XSH.wait.018
anchor     functions/wait.html#DESCRIPTION
class      required
since      1988
says       Status, once reported, is consumed: a second wait() for the
           same (only) child fails with ECHILD.
test       t/018-consumed.c

assertion  XSH.wait.019
anchor     functions/wait.html#DESCRIPTION
class      required
since      2001
says       With SIGCHLD blocked, a wait() that returns a child's status
           clears the pending SIGCHLD when no other child has status
           available.
note       Applies to implementations that do not queue SIGCHLD; one
           that queues it must discard the SIGCHLD for that child, which
           looks the same here. SIGCHLD is caught, not left at SIG_DFL,
           so that it must stay pending while blocked (XSH 2.4.1). The
           RATIONALE speaks of discarding as if optional; the
           DESCRIPTION says shall (standard issue SI-8).
test       t/019-sigchld-cleared.c

assertion  XSH.wait.020
anchor     functions/wait.html#DESCRIPTION
class      required
since      1988
says       When a process terminates without waiting for its child, that
           child gets a new parent process ID (some system process), no
           longer the dead parent's.
nomutant   reparenting is kernel behaviour that a preload library cannot
           change
test       t/020-orphan.c

assertion  XSH.wait.021
anchor     functions/wait.html#DESCRIPTION
class      required
since      2001
says       A child whose last thread terminates (pthread_exit() in its
           only thread) reports status 0.
test       t/021-last-thread.c

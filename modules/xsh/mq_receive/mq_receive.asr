# XSH mq_receive()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Message passing option (MSG). The page is shared with mq_timedreceive(),
# tested in its own module. Not tested: the result when msg_len exceeds
# SSIZE_MAX (implementation-defined), EBADMSG (may fail, no way to cause it),
# which of several waiting threads is served.

assertion  XSH.mq_receive.001
anchor     functions/mq_receive.html#DESCRIPTION
anchor     functions/mq_receive.html#RETURN VALUE
class      conditional
when       MSG
since      2001
says       mq_receive() returns the length of the message, copies it, stores
           its priority in *msg_prio (and accepts a NULL msg_prio), and
           removes it from the queue.
test       t/001-roundtrip.c

assertion  XSH.mq_receive.002
anchor     functions/mq_receive.html#DESCRIPTION
class      conditional
when       MSG
since      2001
says       With messages 1 to 5 sent with priorities 2,9,9,2,9, they are
           received in the order 2,3,5,1,4: the oldest of the highest
           priority first.
test       t/002-priority.c

assertion  XSH.mq_receive.003
anchor     functions/mq_receive.html#DESCRIPTION
anchor     functions/mq_receive.html#ERRORS/EMSGSIZE
anchor     functions/mq_receive.html#RETURN VALUE
class      conditional
when       MSG
since      2001
says       A buffer of 63 bytes for a queue with mq_msgsize 64 fails with
           EMSGSIZE and the message stays queued; a buffer of exactly 64
           bytes receives a shorter message.
test       t/003-emsgsize.c

assertion  XSH.mq_receive.004
anchor     functions/mq_receive.html#DESCRIPTION
anchor     functions/mq_receive.html#ERRORS/EAGAIN
class      conditional
when       MSG
since      2001
says       On an empty queue with O_NONBLOCK, mq_receive() fails with EAGAIN.
test       t/004-eagain.c

assertion  XSH.mq_receive.005
anchor     functions/mq_receive.html#ERRORS/EBADF
class      conditional
when       MSG
since      2001
says       An invalid descriptor, and one opened O_WRONLY, fail with EBADF
           and remove nothing.
test       t/005-ebadf.c

assertion  XSH.mq_receive.006
anchor     functions/mq_receive.html#DESCRIPTION
class      conditional
when       MSG
since      2001
says       On an empty queue without O_NONBLOCK, mq_receive() waits until a
           message is enqueued (a child sends after 300 ms), then returns it
           and not before.
test       t/006-blocks.c

assertion  XSH.mq_receive.007
anchor     functions/mq_receive.html#DESCRIPTION
anchor     functions/mq_receive.html#ERRORS/EINTR
class      conditional
when       MSG
since      2001
says       A blocked mq_receive() interrupted by a signal whose handler is
           not restarting fails with EINTR.
test       t/007-eintr.c

assertion  XSH.mq_receive.008
anchor     functions/mq_receive.html#RETURN VALUE
class      conditional
when       MSG
since      2001
says       A zero-length message is received with length 0, with its
           priority, and removed.
test       t/008-zero-length.c

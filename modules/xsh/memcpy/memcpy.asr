# XSH memcpy()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# 
# Overlapping objects are never used (undefined). Calls go through volatile function pointers.

assertion  XSH.memcpy.001
anchor     functions/memcpy.html#DESCRIPTION
anchor     functions/memcpy.html#RETURN VALUE
class      required
says       memcpy() copies exactly n bytes, including zero bytes and bytes
           above 0x7f, from the source into the destination and leaves the
           bytes before and after them unchanged (8 bytes copied into the
           middle of a 16-byte array filled with 0xaa).
test       t/001-copy-exact.c

assertion  XSH.memcpy.002
anchor     functions/memcpy.html#DESCRIPTION
anchor     functions/memcpy.html#RETURN VALUE
class      required
says       memcpy() returns its first argument, also when n is 0.
test       t/002-return-value.c

assertion  XSH.memcpy.003
anchor     functions/memcpy.html#DESCRIPTION
anchor     functions/memcpy.html#RETURN VALUE
class      required
says       memcpy() with n 0 leaves the destination unchanged.
test       t/003-n-zero.c

assertion  XSH.memcpy.004
anchor     functions/memcpy.html#DESCRIPTION
anchor     functions/memcpy.html#RETURN VALUE
class      required
says       memcpy() copies exactly n bytes for source and destination
           offsets 0 to 7 and sizes 1, 3, 7, 8, 9, 15, 16, 17, 31, 33 and
           257, leaving a guard of bytes around the destination unchanged.
test       t/004-alignments.c

assertion  XSH.memcpy.005
anchor     functions/memcpy.html#DESCRIPTION
anchor     functions/memcpy.html#RETURN VALUE
class      required
says       memcpy() reads no byte beyond the n of the source and writes none
           beyond the n of the destination: 8 bytes ending at an
           inaccessible page are copied into another 8-byte array and back,
           and n 0 at the boundary touches nothing.
test       t/005-no-overread.c

assertion  XSH.memcpy.006
anchor     functions/memcpy.html#DESCRIPTION
anchor     functions/memcpy.html#RETURN VALUE
class      required
says       memcpy() leaves errno unchanged.
test       t/006-errno-kept.c

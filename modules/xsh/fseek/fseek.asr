# XSH fseek(), fseeko()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.fseek.001
anchor     functions/fseek.html#DESCRIPTION
class      required
since      1988
says       On a stream reading "0123456789": fseek(f, 5, SEEK_SET) returns 0 and
           the next read returns '5'; then fseek(f, -2, SEEK_CUR) (from 6)
           returns 0 and the read returns '4'; fseek(f, -1, SEEK_END) returns
           0 and the read returns '9'.
test       t/001-whence.c

assertion  XSH.fseek.002
anchor     functions/fseek.html#DESCRIPTION
class      required
since      1988
says       On a stream read to its end (feof() true), fseek(f, 0, SEEK_SET)
           returns 0, feof() is then 0 and the next read returns the first
           byte; fseek(f, 0, SEEK_END) after reaching the end again also
           clears it, and so does fseeko(f, 1, SEEK_SET).
test       t/002-clears-eof.c

assertion  XSH.fseek.003
anchor     functions/fseek.html#DESCRIPTION
class      required
since      1988
says       On a stream opened "r+" on "0123456789": fputc('X') (at 0),
           fseek(f, 0, SEEK_CUR), then a read returns '1'; a read of '2',
           fseek(f, 0, SEEK_CUR), fputc('Y') and fclose() leave "X12Y456789".
test       t/003-update-switch.c

assertion  XSH.fseek.004
anchor     functions/fseek.html#DESCRIPTION
class      disputed
says       With fflush() the last operation (or the last but an ftell()):
           on a "w" stream after fputs("abcdef") and fflush(), fseek(f, 2,
           SEEK_SET) leaves lseek(fileno(f), 0, SEEK_CUR) at 2; on an "r"
           stream after one read and fflush(), fseek(f, 7, SEEK_SET) leaves it
           at 7; and with an ftell() between the fflush() and fseek(f, 3,
           SEEK_SET), at 3.
note       disputed (Q-40): the offset can only be seen through another
           handle, and XSH 2.5.1 asks for an fflush() after the stream's
           last use (here the fseek()) before another handle is used; a
           FAIL is logged as INSPECT. The change history does not say
           which edition added the statement, so "since" is left out.
test       t/004-after-fflush.c

assertion  XSH.fseek.005
anchor     functions/fseek.html#DESCRIPTION
class      required
since      1988
says       On a stream opened "r+" on "abc", fseek(f, 10, SEEK_SET) returns 0;
           after fputc('Z') and fclose() the file is 11 bytes: "abc", seven
           zero bytes, then 'Z'.
test       t/005-gap.c

assertion  XSH.fseek.006
anchor     functions/fseek.html#DESCRIPTION
class      required
says       On a "w" stream on an existing file (last changed 2 s before), after
           fputs("abc") with the data still buffered, fseek(f, 0, SEEK_SET)
           returns 0, the file then holds "abc", and its last data
           modification and status change times are later than before.
note       The change history does not say which edition added the CX
           timestamp rule, so "since" is left out.
test       t/006-writes-pending.c

assertion  XSH.fseek.007
anchor     functions/fseek.html#DESCRIPTION
class      required
since      2024
says       On a stream from fmemopen(buf, 64, "w") with its default buffering,
           after fputs("abc") with the data still buffered (not yet in buf),
           fseek(f, 0, SEEK_SET) returns 0 and buf then begins "abc".
note       Austin Group defect 1225 (Issue 8).
test       t/007-memory-stream.c

assertion  XSH.fseek.008
anchor     functions/fseek.html#DESCRIPTION
class      required
since      2001
says       fseeko() with SEEK_SET, SEEK_CUR and SEEK_END behaves as in
           XSH.fseek.001; on an "r+" stream fseeko(f, (off_t)1 << 33, SEEK_SET)
           returns 0 and ftello() then returns 2^33 (when off_t has more than
           33 bits).
test       t/008-fseeko.c

assertion  XSH.fseek.009
anchor     functions/fseek.html#ERRORS/EINVAL
class      disputed
says       On an "r+" stream at position 1 with a byte of output pending,
           fseek(f, -5, SEEK_CUR) returns -1 with errno EINVAL.
note       disputed (Q-35): the ERRORS preamble requires this error only
           when the stream is unbuffered or its buffer needed to be
           flushed AND the call invokes lseek() or write(); output is
           left pending, but a system may detect the error before it
           flushes, so a FAIL is logged as INSPECT.
test       t/009-einval-negative.c

assertion  XSH.fseek.010
anchor     functions/fseek.html#ERRORS/EINVAL
class      disputed
says       On an "r+" stream with a byte of output pending, fseek() with a
           whence that is none of SEEK_SET, SEEK_CUR and SEEK_END returns -1
           with errno EINVAL.
note       disputed (Q-35): the ERRORS preamble requires this error only
           when the stream is unbuffered or its buffer needed to be
           flushed AND the call invokes lseek() or write(); output is
           left pending, but a system may detect the error before it
           flushes, so a FAIL is logged as INSPECT.
test       t/010-einval-whence.c

assertion  XSH.fseek.011
anchor     functions/fseek.html#ERRORS/ESPIPE
class      disputed
says       On a stream from fdopen() of a pipe's write end (the read end kept
           open) with a byte of output pending, fseek(f, 0, SEEK_SET) returns
           -1 with errno ESPIPE.
note       disputed (Q-35): the ERRORS preamble requires this error only
           when the stream is unbuffered or its buffer needed to be
           flushed AND the call invokes lseek() or write(); output is
           left pending, but a system may detect the error before it
           flushes, so a FAIL is logged as INSPECT.
test       t/011-espipe.c

assertion  XSH.fseek.012
anchor     functions/fseek.html#ERRORS/EBADF
class      required
says       On a "w" stream with output pending whose descriptor has been closed
           with close(), fseek(f, 0, SEEK_SET) returns -1 with errno EBADF and
           the stream's error indicator set.
note       The error indicator is set because the write that fseek()
           must do fails (DESCRIPTION). close() does not move the
           offset, so the descriptor is not a second handle (XSH 2.5.1).
           "since" is left out: the change history shows only that the
           error predates Issue 6.
test       t/012-ebadf.c

assertion  XSH.fseek.013
anchor     functions/fseek.html#ERRORS/EFBIG
class      required
since      2024
says       In a child with RLIMIT_FSIZE 100 and SIGXFSZ blocked, on a "w" stream
           with 200 bytes pending, fseek(f, 0, SEEK_SET) returns -1 with errno
           EFBIG, the error indicator is set, and SIGXFSZ is pending (when
           XSI).
note       Austin Group defect 1669 (Issue 8) made the error base; the
           signal is XSI and checked only there.
test       t/013-efbig.c

assertion  XSH.fseek.014
anchor     functions/fseek.html#ERRORS/EINVAL
class      disputed
since      2024
says       On a stream from fmemopen(buf, 10, "r"), fseek(f, 11, SEEK_SET) returns
           -1 with errno EINVAL.
note       disputed (Q-35): the ERRORS preamble requires the failures
           only when an underlying lseek() or write() is invoked, which
           a memory stream has none of, yet this error names fmemopen()
           streams; a FAIL is logged as INSPECT. fmemopen()'s own page
           also requires the failure.
test       t/014-memory-beyond-end.c

assertion  XSH.fseek.015
anchor     functions/fseek.html#ERRORS/EOVERFLOW
class      disputed
since      2001
says       Where off_t is wider than long: on a "w" stream with "abc" pending at
           offset 0, fseek(f, LONG_MAX, SEEK_END) returns -1 with errno
           EOVERFLOW. Otherwise NOTINUSE.
note       disputed (Q-35): the ERRORS preamble requires this error only
           when the stream is unbuffered or its buffer needed to be
           flushed AND the call invokes lseek() or write(); output is
           left pending, but a system may detect the error before it
           flushes, so a FAIL is logged as INSPECT.
test       t/015-eoverflow.c

assertion  XSH.fseek.016
anchor     functions/fseek.html#ERRORS/EOVERFLOW
class      disputed
since      2001
says       On a "w" stream with "abc" pending, fseeko(f, OFF_MAX, SEEK_END)
           (OFF_MAX the largest off_t) returns -1 with errno EOVERFLOW.
note       disputed (Q-35): the ERRORS preamble requires this error only
           when the stream is unbuffered or its buffer needed to be
           flushed AND the call invokes lseek() or write(); output is
           left pending, but a system may detect the error before it
           flushes, so a FAIL is logged as INSPECT.
test       t/016-fseeko-eoverflow.c

assertion  XSH.fseek.017
anchor     functions/fseek.html#ERRORS/ESPIPE
class      disputed
says       On an unbuffered stream (setvbuf(_IONBF), UNRESOLVED if refused) from
           fdopen() of a pipe's write end, with no output, fseek(f, 0,
           SEEK_SET) returns -1 with errno ESPIPE.
note       disputed (Q-35): the unbuffered branch of the ERRORS
           preamble, which still needs an lseek() to be invoked; a FAIL
           is logged as INSPECT. "since" is left out: the change history
           shows only that the error predates Issue 6.
test       t/017-unbuffered-espipe.c

assertion  XSH.fseek.018
anchor     functions/fseek.html#ERRORS/EPIPE
class      required
since      2001
says       On a stream on a pipe's write end whose read end is closed, SIGPIPE
           blocked, with output pending, fseek(f, 0, SEEK_SET) returns -1 with
           errno EPIPE or ESPIPE (both conditions hold); with EPIPE the error
           indicator is set and SIGPIPE is pending.
note       Issue 6 marks EPIPE as a CX error; which of the two errors
           comes first is the implementation's choice (XSH 2.3).
test       t/018-epipe.c

assertion  XSH.fseek.019
anchor     functions/fmemopen.html#DESCRIPTION
class      required
since      2008
says       On a stream from fmemopen(buf, 10, "r"): fseek(f, 10, SEEK_SET) returns
           0; fseek(f, 11, SEEK_SET) and fseek(f, -1, SEEK_SET) return -1 and
           ftell() is still 10.
note       fmemopen() came in Issue 7. The errno is XSH.fseek.014.
test       t/019-memory-bounds.c

assertion  XSH.fseek.020
anchor     functions/fseek.html#ERRORS/EAGAIN
class      required
since      2001
says       On a stream on the write end of a full pipe with O_NONBLOCK set, with
           output pending, fseek(f, 0, SEEK_SET) returns -1 with errno EAGAIN
           or ESPIPE (both conditions hold); with EAGAIN the error indicator
           is set.
note       Which of the two errors comes first is the implementation's
           choice (XSH 2.3).
test       t/020-eagain.c

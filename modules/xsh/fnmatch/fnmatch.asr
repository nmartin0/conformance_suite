# XSH fnmatch()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# All tests run in the POSIX locale (the default for a C program) and use
# only ASCII characters. A pattern ending in an unescaped backslash is
# unspecified and is never used.

assertion  XSH.fnmatch.001
anchor     functions/fnmatch.html#RETURN VALUE
anchor     functions/fnmatch.html#DESCRIPTION
class      required
since      1988
says       A whole-string match returns 0 and a mismatch returns FNM_NOMATCH:
           ("abc","abc") is 0; ("abc","abd"), ("ab","abc") and ("abc","ab")
           are FNM_NOMATCH. FNM_NOMATCH is nonzero.
test       t/001-literal.c

assertion  XSH.fnmatch.002
anchor     functions/fnmatch.html#DESCRIPTION
anchor     utilities/V3_chap02.html#2.14.1
class      required
since      1988
says       The empty pattern matches only the empty string.
test       t/002-empty.c

assertion  XSH.fnmatch.003
anchor     utilities/V3_chap02.html#2.14.1
class      required
since      1988
says       "?" matches exactly one character: ("a?c","abc") is 0; ("a?c","ac")
           and ("a?c","abbc") are FNM_NOMATCH.
test       t/003-question.c

assertion  XSH.fnmatch.004
anchor     utilities/V3_chap02.html#2.14.2
class      required
since      1988
says       "*" matches any string including the empty one: ("a*c","ac"),
           ("a*c","abbbc"), ("*","") and ("a*b*c","aXbYbZc") are 0;
           ("a*","b") and ("a*c","abd") are FNM_NOMATCH; an asterisk followed
           by more pattern still allows a match when the first candidate
           fails: ("*b","abxb") is 0.
test       t/004-star.c

assertion  XSH.fnmatch.005
anchor     utilities/V3_chap02.html#2.14.1
anchor     basedefs/V1_chap09.html#9.3.5
class      required
since      1988
says       A bracket expression with a list or range matches one character of
           it (POSIX locale): ("[abc]","b"), ("[a-c]","b"), ("[%--]","+") and
           ("[--@]","0") are 0; ("[abc]","d"), ("[a-c]","d") and
           ("[abc]","ab") are FNM_NOMATCH.
test       t/005-bracket-list.c

assertion  XSH.fnmatch.006
anchor     utilities/V3_chap02.html#2.14.1
anchor     basedefs/V1_chap09.html#9.3.5
class      required
since      1988
says       A leading "!" in a bracket expression makes it a non-matching list:
           ("[!abc]","d") and ("[!a-c]","m") are 0; ("[!abc]","a") and
           ("[!a-c]","b") are FNM_NOMATCH.
test       t/006-bracket-negate.c

assertion  XSH.fnmatch.007
anchor     utilities/V3_chap02.html#2.14.1
anchor     basedefs/V1_chap09.html#9.3.5
class      required
since      1988
says       A right bracket placed first (after any "!") stands for itself:
           ("[]a]","]") and ("[!]a]","b") are 0; ("[!]a]","]") and
           ("[]a]","b") are FNM_NOMATCH.
test       t/007-bracket-rbracket.c

assertion  XSH.fnmatch.008
anchor     utilities/V3_chap02.html#2.14.1
anchor     basedefs/V1_chap09.html#9.3.5
class      required
since      1988
says       A hyphen placed first or last in a bracket expression stands for
           itself: ("[-ac]","-") and ("[ac-]","-") are 0; ("[-ac]","b") and
           ("[ac-]","b") are FNM_NOMATCH.
test       t/008-bracket-hyphen.c

assertion  XSH.fnmatch.009
anchor     utilities/V3_chap02.html#2.14.1
anchor     basedefs/V1_chap09.html#9.3.5
class      required
since      1988
says       Character class expressions match their class in the POSIX locale:
           alpha, digit, upper, lower, alnum, space, blank, punct, xdigit,
           cntrl, print and graph each match a character of the class and not
           one outside it.
test       t/009-bracket-classes.c

assertion  XSH.fnmatch.010
anchor     utilities/V3_chap02.html#2.14.1
anchor     basedefs/V1_chap09.html#9.3.5
class      required
since      1988
says       Collating symbols and equivalence classes work in the POSIX
           locale: ("[[.a.]b]","a") and ("[[=a=]b]","a") are 0;
           ("[][.-.]-0]","]"), ("[][.-.]-0]","-") and ("[][.-.]-0]","/") are 0
           and ("[][.-.]-0]","a") is FNM_NOMATCH.
test       t/010-bracket-collating.c

assertion  XSH.fnmatch.011
anchor     utilities/V3_chap02.html#2.14.1
anchor     basedefs/V1_chap09.html#9.3.5
class      required
since      1988
says       Asterisk, question mark and left bracket are ordinary inside a
           bracket expression: ("[*]","*"), ("[?]","?") and ("[[]","[") are 0;
           ("[*]","a") and ("[?]","a") are FNM_NOMATCH.
test       t/011-bracket-specials.c

assertion  XSH.fnmatch.012
anchor     utilities/V3_chap02.html#2.14.1
class      required
since      1988
says       A left bracket that does not start a valid bracket expression
           matches itself: ("[","[") and ("[a","[a") are 0 and ("[a","a") is
           FNM_NOMATCH.
test       t/012-bracket-unclosed.c

assertion  XSH.fnmatch.013
anchor     functions/fnmatch.html#DESCRIPTION
anchor     utilities/V3_chap02.html#2.14.1
class      required
since      1988
says       Without FNM_NOESCAPE a backslash makes the next character
           literal: ("\\*","*"), ("\\?","?"), ("a\\b","ab") and ("\\\\","\\") are 0;
           ("\\*","a") and ("\\?","a") are FNM_NOMATCH.
test       t/013-escape.c

assertion  XSH.fnmatch.014
anchor     functions/fnmatch.html#DESCRIPTION
class      required
since      1988
says       With FNM_NOESCAPE a backslash is an ordinary character:
           ("\\*","\\abc"), ("a\\b","a\\b") are 0; ("\\*","*") and
           ("a\\b","ab") are FNM_NOMATCH.
test       t/014-noescape.c

assertion  XSH.fnmatch.015
anchor     functions/fnmatch.html#DESCRIPTION
class      required
since      1988
says       With FNM_PATHNAME a slash in the string is matched only by a slash
           in the pattern: ("a/b","a/b") and ("*/b","a/b") are 0; ("*","a/b"),
           ("a*","a/b"), ("a?b","a/b") and ("a[!x]b","a/b") are FNM_NOMATCH.
test       t/015-pathname-slash.c

assertion  XSH.fnmatch.016
anchor     functions/fnmatch.html#DESCRIPTION
class      required
since      1988
says       Without FNM_PATHNAME a slash is an ordinary character: ("*","a/b"),
           ("a*b","a/b"), ("a?b","a/b") and ("a[!x]b","a/b") are 0.
test       t/016-no-pathname.c

assertion  XSH.fnmatch.017
anchor     functions/fnmatch.html#DESCRIPTION
anchor     utilities/V3_chap02.html#2.14.3
class      required
since      1988
says       With FNM_PERIOD a leading period in the string (first character) is
           matched only by an explicit period: ("*",".a"), ("?a",".a"),
           ("[!x]a",".a"), ("[%-0]a",".a") and ("[[:punct:]]a",".a") are
           FNM_NOMATCH; (".a",".a") and (".*",".a") are 0.
test       t/017-period-leading.c

assertion  XSH.fnmatch.018
anchor     functions/fnmatch.html#DESCRIPTION
class      required
since      1988
says       Without FNM_PERIOD a period has no restriction: ("*",".a") and
           ("?a",".a") are 0.
test       t/018-no-period.c

assertion  XSH.fnmatch.019
anchor     functions/fnmatch.html#DESCRIPTION
class      required
since      1988
says       With FNM_PERIOD and no FNM_PATHNAME only the first character
           counts as leading: ("a*","a/.b") and ("a/?b","a/.b") are 0.
test       t/019-period-nopathname.c

assertion  XSH.fnmatch.020
anchor     functions/fnmatch.html#DESCRIPTION
class      required
since      1988
says       With FNM_PERIOD and FNM_PATHNAME a period right after a slash is
           also leading: ("a/*","a/.b"), ("a/?b","a/.b") and ("*/*","a/.b") are
           FNM_NOMATCH; ("a/.b","a/.b") and ("*/.b","a/.b") are 0.
test       t/020-period-pathname.c

assertion  XSH.fnmatch.021
anchor     functions/fnmatch.html#DESCRIPTION
anchor     basedefs/V1_chap04.html#4.1
class      required
since      2024
says       With FNM_CASEFOLD, pattern and string compare without regard to
           case: ("abc","ABC"), ("ABC","abc"), ("a?c","AXC"), ("[a-c]","B") and
           ("[[:lower:]]","A") are 0; ("abc","abd") is FNM_NOMATCH; the same
           pairs without the flag are FNM_NOMATCH where the case differs.
test       t/021-casefold.c

assertion  XSH.fnmatch.022
anchor     functions/fnmatch.html#DESCRIPTION
anchor     basedefs/V1_chap04.html#4.1
class      required
since      2024
says       With FNM_IGNORECASE, the same pairs as the previous assertion
           give the same results.
test       t/022-ignorecase.c

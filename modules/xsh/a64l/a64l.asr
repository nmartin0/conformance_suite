# XSH a64l() and l64a()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# 
# These functions are XSI. l64a() may return a pointer into a static buffer, so every returned string is used before the next call.
# Calls go through volatile function pointers.

assertion  XSH.a64l.001
anchor     functions/a64l.html#DESCRIPTION
anchor     functions/a64l.html#RETURN VALUE
class      conditional
when       XSI
says       l64a() represents each single digit value 1 to 63 by the one
           character at that position in the sequence ".", "/", "0" to "9",
           "A" to "Z", "a" to "z" (so 1 gives "/", 2 gives "0", 11 gives
           "9", 12 gives "A", 37 gives "Z", 38 gives "a", 63 gives "z"), and
           l64a(0) is an empty string.
test       t/001-digit-alphabet.c

assertion  XSH.a64l.002
anchor     functions/a64l.html#DESCRIPTION
anchor     functions/a64l.html#RETURN VALUE
class      conditional
when       XSI
says       l64a() writes the least significant digit first and no leading
           zero digits: 64 gives "./", 65 gives "//", 4096 gives "../", 4097
           gives "/./", 2147483647 gives "zzzzz/", 0x12345678 gives the
           digits of that value starting from the least significant 6-bit
           group.
test       t/002-least-significant-first.c

assertion  XSH.a64l.003
anchor     functions/a64l.html#DESCRIPTION
anchor     functions/a64l.html#RETURN VALUE
class      conditional
when       XSI
says       a64l() decodes with the first digit least significant: "." gives
           0, "/" gives 1, "0" gives 2, "9" gives 11, "A" gives 12, "Z"
           gives 37, "a" gives 38, "z" gives 63, "./" gives 64, "/." gives
           1, "zzzzz/" gives 2147483647, ".." gives 0, "aA" gives 38 + 12 *
           64, and the empty string gives 0.
test       t/003-a64l-decode.c

assertion  XSH.a64l.004
anchor     functions/a64l.html#DESCRIPTION
anchor     functions/a64l.html#RETURN VALUE
class      conditional
when       XSI
says       a64l(l64a(x)) gives x back for 0, 1, 63, 64, 4095, 4096, 123456,
           1048576, 123456789, 0x12345678 and 2147483647.
test       t/004-round-trip.c

assertion  XSH.a64l.005
anchor     functions/a64l.html#DESCRIPTION
anchor     functions/a64l.html#RETURN VALUE
class      conditional
when       XSI
says       a64l() uses only the first six characters of a longer string:
           "/.....z" gives 1, "//////z" and "//////zzzz" give 1090785345
           (the value of "//////"), and "zzzzz/." gives 2147483647.
test       t/005-more-than-six.c

assertion  XSH.a64l.006
anchor     functions/a64l.html#DESCRIPTION
anchor     functions/a64l.html#RETURN VALUE
class      conditional
when       XSI
says       a64l() stops at a terminator within the first six characters: the
           arrays {/, 0, /, /, /, /, /} give 1, {/, /, 0, /} give 65, and
           {0} gives 0; the characters after the terminator are not used.
test       t/006-terminator-within-six.c

assertion  XSH.a64l.007
anchor     functions/a64l.html#DESCRIPTION
anchor     functions/a64l.html#RETURN VALUE
class      conditional
when       XSI
says       a64l() works on the low-order 32 bits and sign-extends a value
           with the top of those 32 bits set: "zzzzz1" (all 32 bits set)
           gives -1, ".....0" (only bit 31 set) gives -2147483648, "zzzzzz"
           (more than 32 bits, low 32 all set) gives -1, and "zzzzz." (bits
           0 to 29 set) gives 1073741823.
test       t/007-sign-extension.c

assertion  XSH.a64l.008
anchor     functions/a64l.html#DESCRIPTION
anchor     functions/a64l.html#RETURN VALUE
class      conditional
when       XSI
says       When long has more than 32 bits, l64a() uses only the low-order
           32 bits of its argument and a64l(l64a(x)) gives back x in the
           low-order 32 bits: l64a(0x100000001) is "/" and
           a64l(l64a(0x123456789)) is 0x23456789.
test       t/008-low-32-bits.c

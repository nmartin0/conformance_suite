# XSH sigtimedwait() and sigwaitinfo()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.sigtimedwait.001
anchor     functions/sigtimedwait.html#DESCRIPTION
class      required
since      2008
says       With SIGRTMIN (SA_SIGINFO set) queued twice by sigqueue(), with
           values 77 then 78, sigwaitinfo() returns SIGRTMIN with si_signo
           SIGRTMIN, si_code SI_QUEUE, si_pid and si_uid the caller's
           process ID and real user ID, and si_value 77; a second call
           returns the value 78.
uses       XSH.sigqueue.001
test       t/001-info.c

assertion  XSH.sigtimedwait.002
anchor     functions/sigtimedwait.html#ERRORS/EAGAIN
class      required
since      2008
says       With nothing pending, sigtimedwait() with a 300 ms timeout returns
           -1 with errno EAGAIN, no earlier than 300 ms after the call
           (CLOCK_MONOTONIC, in whole milliseconds).
test       t/002-timeout.c

assertion  XSH.sigtimedwait.003
anchor     functions/sigtimedwait.html#DESCRIPTION
class      required
since      2008
says       With nothing pending, sigtimedwait() with a zero timeout returns -1
           with EAGAIN at once (within 100 ms).
test       t/003-zero-timeout.c

assertion  XSH.sigtimedwait.004
anchor     functions/sigtimedwait.html#DESCRIPTION
class      required
since      2008
says       With SIGUSR1 and SIGUSR2 blocked and pending, sigtimedwait() on a
           set holding only SIGUSR1, with a zero timeout, returns SIGUSR1
           with si_signo SIGUSR1, si_code SI_USER and si_pid the caller's,
           as sigwaitinfo() would; SIGUSR2 stays pending.
test       t/004-pending-zero.c

assertion  XSH.sigtimedwait.005
anchor     functions/sigtimedwait.html#DESCRIPTION
class      required
since      2008
says       sigtimedwait() with a 10 s timeout returns SIGUSR1 soon after it is
           sent (300 ms into the wait), not at the timeout.
test       t/005-wakes.c

assertion  XSH.sigtimedwait.006
anchor     functions/sigtimedwait.html#DESCRIPTION
class      required
since      2008
says       With SIGRTMIN+2 and then SIGRTMIN+1 pending, sigwaitinfo() on both
           returns SIGRTMIN+1 first.
test       t/006-lowest-rt.c

assertion  XSH.sigtimedwait.007
anchor     functions/sigtimedwait.html#DESCRIPTION
class      required
since      2008
says       After sigwaitinfo() takes the only occurrence of a blocked SIGUSR1,
           SIGUSR1 is no longer pending, and a zero-timeout sigtimedwait()
           fails with EAGAIN.
uses       XSH.sigpending.001
test       t/007-pending-reset.c

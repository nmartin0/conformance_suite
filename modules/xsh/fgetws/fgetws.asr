# XSH fgetws()
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XSH.fgetws.001
anchor     functions/fgetws.html#DESCRIPTION
anchor     functions/fgetws.html#RETURN VALUE
class      required
says       On a stream reading "ab\ncd\n", fgetws(ws, 10, f) returns ws holding
           L"ab\n" followed by a null wide character, and a second call returns
           ws holding L"cd\n"; the array is filled with a non-zero marker before
           each call.
test       t/001-lines.c

assertion  XSH.fgetws.002
anchor     functions/fgetws.html#DESCRIPTION
class      required
says       On a stream reading "abcdef", fgetws(ws, 4, f) returns ws holding
           L"abc" and a terminator, the elements beyond the fourth stay as they
           were, and the next fgetwc() returns L'd'.
test       t/002-count-limit.c

assertion  XSH.fgetws.003
anchor     functions/fgetws.html#DESCRIPTION
anchor     functions/fgetws.html#RETURN VALUE
class      disputed
says       On a stream reading "xy" (no newline), fgetws(ws, 10, f) returns ws
           holding L"xy"; a second call returns a null pointer with feof() true.
note       disputed (Q-126): the DESCRIPTION ends the read at
           end of file and terminates the string, while the RETURN VALUE returns
           a null pointer for a stream at end-of-file, which is also true after
           the characters were read.
test       t/003-partial-eof.c

assertion  XSH.fgetws.004
anchor     functions/fgetws.html#RETURN VALUE
class      required
says       On a stream at the end of its file (an empty file), fgetws() returns a
           null pointer, feof() is then true and ferror() false.
test       t/004-eof-first.c

assertion  XSH.fgetws.005
anchor     functions/fgetws.html#RETURN VALUE
class      required
since      2001
says       On a stream reading "ab" whose end-of-file indicator is set, after "c"
           is appended through a separate open(), fgetws() returns a null pointer
           and feof() stays true.
test       t/005-eof-sticky.c

assertion  XSH.fgetws.006
anchor     functions/fgetws.html#ERRORS
anchor     functions/fgetwc.html#ERRORS/EBADF
anchor     functions/fgetws.html#RETURN VALUE
class      required
says       On a stream opened "r" whose descriptor was closed before the first
           read, fgetws() returns a null pointer, sets errno to EBADF and sets
           the error indicator.
test       t/006-ebadf-closed.c

assertion  XSH.fgetws.007
anchor     functions/fgetws.html#ERRORS
anchor     functions/fgetwc.html#ERRORS/EBADF
anchor     functions/fgetws.html#RETURN VALUE
class      required
says       On a stream opened "w", fgetws() returns a null pointer, sets errno to
           EBADF and sets the error indicator.
test       t/007-ebadf-write-only.c

assertion  XSH.fgetws.008
anchor     functions/fgetws.html#ERRORS
anchor     functions/fgetwc.html#ERRORS/EAGAIN
anchor     functions/fgetws.html#RETURN VALUE
class      required
says       On a stream on the read end of an empty pipe with O_NONBLOCK set,
           fgetws() returns a null pointer, sets errno to EAGAIN and sets the
           error indicator.
test       t/008-eagain.c

assertion  XSH.fgetws.009
anchor     functions/fgetws.html#ERRORS
anchor     functions/fgetwc.html#ERRORS/EILSEQ
anchor     functions/fgetws.html#RETURN VALUE
class      required
since      2024
says       In a UTF-8 locale, on a stream reading "ab" followed by the byte 0xff,
           fgetws() returns a null pointer, sets errno to EILSEQ and sets the
           error indicator.
test       t/009-eilseq.c

assertion  XSH.fgetws.010
anchor     functions/fgetws.html#DESCRIPTION
class      required
says       After the access time of a file is set to 2001-09-09, the first
           successful fgetws() on a stream reading it moves the access time
           later.
test       t/010-atime.c

# XBD <unistd.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Compile-time checks; the rest of the header comes with the Tier 0
# generator.

assertion  XBD.unistd.h.001
anchor     basedefs/unistd.h.html#DESCRIPTION/POSIX_CLOSE_RESTART
class      required
since      2024
says       <unistd.h> defines POSIX_CLOSE_RESTART as an integer constant
           expression (it may be zero). Its absence is taken to mean
           posix_close() is missing.
note       glibc has neither (docs/linux-deviations.md 1.3).
test       t/001-posix-close-restart.c
nomutant   compile-time presence check; needs the Tier 0 header mutants

assertion  XBD.unistd.h.003
anchor     basedefs/unistd.h.html#DESCRIPTION/SEEK_SET
class      required
since      1988
says       <unistd.h> defines SEEK_SET, SEEK_CUR and SEEK_END as macros
           with integer constant values, all different.
test       t/003-seek-basic.c
nomutant   compile-time presence check; needs the Tier 0 header mutants

assertion  XBD.unistd.h.002
anchor     basedefs/unistd.h.html#DESCRIPTION/SEEK_HOLE
class      required
since      2024
says       <unistd.h> defines SEEK_HOLE and SEEK_DATA as macros with
           integer constant values, different from each other and from
           SEEK_SET, SEEK_CUR and SEEK_END.
note       glibc defines SEEK_HOLE and SEEK_DATA only with _GNU_SOURCE
           (docs/linux-deviations.md 1.12).
uses       XBD.unistd.h.003
test       t/002-seek-constants.c
nomutant   compile-time presence check; needs the Tier 0 header mutants

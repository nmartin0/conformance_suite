# XBD <string.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Semantic content of <string.h> beyond the names the Tier 0 header check
# covers: the types and declarations the page gives, checked at build time.
# The header mutants for these arrive with the Tier 0 generator, so each
# says why it has no mutant yet.

assertion  XBD.string.h.001
anchor     basedefs/string.h.html#DESCRIPTION/NULL
anchor     basedefs/string.h.html#DESCRIPTION/size_t
class      required
says       <string.h> alone defines NULL as a null pointer constant and
           size_t as an unsigned integer type.
note       The page defers to <stddef.h> for both.
test       t/001-null-size.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.string.h.002
anchor     basedefs/string.h.html#DESCRIPTION/locale_t
class      required
says       <string.h> alone defines the type locale_t.
test       t/002-types-locale.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.string.h.003
anchor     basedefs/string.h.html#DESCRIPTION/memchr
anchor     basedefs/string.h.html#DESCRIPTION/strlen
class      required
says       <string.h> declares memchr(), memcmp(), memcpy(), memmove(),
           memset(), memmem(), stpcpy(), stpncpy(), strcat(), strchr(),
           strcmp(), strcoll(), strcoll_l(), strcpy(), strcspn(), strdup(),
           strerror(), strerror_l(), strerror_r(), strlcat(), strlcpy(),
           strlen(), strncat(), strncmp(), strncpy(), strndup(), strnlen(),
           strpbrk(), strrchr(), strsignal(), strspn(), strstr(), strtok(),
           strtok_r(), strxfrm() and strxfrm_l() with the prototypes the page
           gives (a function without a prototype, or with other parameter or
           result types, does not match).
test       t/003-functions.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.string.h.004
anchor     basedefs/string.h.html#DESCRIPTION/memccpy
class      conditional
when       XSI
says       <string.h> declares memccpy() with the prototypes the page gives
           (a function without a prototype, or with other parameter or result
           types, does not match).
test       t/004-functions-xsi.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

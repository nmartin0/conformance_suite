# XBD <sys/socket.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Semantics of <sys/socket.h> that the generated header check cannot
# express: the types, the layout and alignment of sockaddr_storage, the
# families of constants that must differ, and the CMSG macros evaluated on
# a crafted message header. Each says why it has no mutant yet.

assertion  XBD.sys_socket.h.001
anchor     basedefs/sys_socket.h.html#DESCRIPTION/socklen_t
anchor     basedefs/sys_socket.h.html#DESCRIPTION/sa_family_t
class      required
since      2001
says       <sys/socket.h> defines socklen_t as an integer type at least 32 bits
           wide and sa_family_t as an unsigned integer type.
test       t/001-socklen-family.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.sys_socket.h.002
anchor     basedefs/sys_socket.h.html#DESCRIPTION/sockaddr_storage
class      required
since      2001
says       struct sockaddr_storage is at least as large as struct sockaddr_in and
           struct sockaddr_un, is aligned at least as strictly as struct
           sockaddr, sockaddr_in and sockaddr_un, and has ss_family, of type
           sa_family_t, at the same offset as sa_family, sin_family and
           sun_family.
note       Aligned at least as strictly is taken as: the alignment of
           sockaddr_storage is a multiple of the other alignment. The IPv6
           structure is XBD.sys_socket.h.003.
test       t/002-sockaddr-storage.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.sys_socket.h.003
anchor     basedefs/sys_socket.h.html#DESCRIPTION/sockaddr_storage
class      conditional
when       IP6
since      2001
says       With IPv6, struct sockaddr_storage is at least as large as struct
           sockaddr_in6, aligned at least as strictly as it and as struct
           sockaddr, and has ss_family at the same offset as sin6_family and
           sa_family.
uses       XBD.sys_socket.h.002
test       t/003-sockaddr-storage-in6.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.sys_socket.h.004
anchor     basedefs/sys_socket.h.html#DESCRIPTION/SOCK_DGRAM
class      required
since      2001
says       SOCK_DGRAM, SOCK_SEQPACKET and SOCK_STREAM are defined with three
           different values.
test       t/004-sock-types.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.sys_socket.h.005
anchor     basedefs/sys_socket.h.html#DESCRIPTION/SOCK_RAW
class      conditional
when       RS
since      2001
says       With raw sockets, SOCK_RAW is defined and differs from SOCK_DGRAM,
           SOCK_SEQPACKET and SOCK_STREAM.
uses       XBD.sys_socket.h.004
test       t/005-sock-raw.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.sys_socket.h.006
anchor     basedefs/sys_socket.h.html#DESCRIPTION/SOCK_NONBLOCK
class      required
since      2024
says       SOCK_NONBLOCK, SOCK_CLOEXEC and SOCK_CLOFORK are defined, share no bit
           with each other, and share no bit with SOCK_DGRAM, SOCK_SEQPACKET,
           SOCK_STREAM or (where defined) SOCK_RAW.
uses       XBD.sys_socket.h.004
test       t/006-sock-flags.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.sys_socket.h.007
anchor     basedefs/sys_socket.h.html#DESCRIPTION/SO_ACCEPTCONN
class      required
since      2024
says       SO_ACCEPTCONN, SO_BROADCAST, SO_DEBUG, SO_DOMAIN, SO_DONTROUTE,
           SO_ERROR, SO_KEEPALIVE, SO_LINGER, SO_OOBINLINE, SO_PROTOCOL,
           SO_RCVBUF, SO_RCVLOWAT, SO_RCVTIMEO, SO_REUSEADDR, SO_SNDBUF,
           SO_SNDLOWAT, SO_SNDTIMEO and SO_TYPE are defined with eighteen
           different values.
note       SO_DOMAIN and SO_PROTOCOL were added in Issue 8.
test       t/007-so-options.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.sys_socket.h.008
anchor     basedefs/sys_socket.h.html#DESCRIPTION/MSG_CTRUNC
class      required
since      2024
says       MSG_CMSG_CLOEXEC, MSG_CMSG_CLOFORK, MSG_CTRUNC, MSG_DONTROUTE,
           MSG_EOR, MSG_OOB, MSG_NOSIGNAL, MSG_PEEK, MSG_TRUNC and MSG_WAITALL
           are defined with ten different values.
note       MSG_CMSG_CLOEXEC and MSG_CMSG_CLOFORK were added in Issue 8.
test       t/008-msg-flags.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.sys_socket.h.009
anchor     basedefs/sys_socket.h.html#DESCRIPTION/AF_INET
anchor     basedefs/sys_socket.h.html#DESCRIPTION/AF_UNSPEC
class      required
since      2001
says       AF_INET, AF_UNIX and AF_UNSPEC are defined with three different
           values, and AF_UNSPEC is 0.
test       t/009-af-values.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.sys_socket.h.010
anchor     basedefs/sys_socket.h.html#DESCRIPTION/AF_INET6
class      conditional
when       IP6
since      2001
says       With IPv6, AF_INET6 is defined and differs from AF_INET, AF_UNIX and
           AF_UNSPEC.
uses       XBD.sys_socket.h.009

# XBD <utmpx.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Semantic checks of the header: values, relations between constants,
# types and macros used at run time. Presence and type shape of every
# name are the Tier 0 header check's. The header mutants for these arrive
# with the Tier 0 generator, so each says why it has no mutant yet.

assertion  XBD.utmpx.h.001
anchor     basedefs/utmpx.h.html#DESCRIPTION/EMPTY
class      conditional
when       XSI
since      1988
says       EMPTY, BOOT_TIME, OLD_TIME, NEW_TIME, USER_PROCESS,
           INIT_PROCESS, LOGIN_PROCESS and DEAD_PROCESS have eight
           different values that fit in ut_type (a short).
note       Values of the one ut_type member, which getutxid() matches on
           (Q-165).
test       t/001-ut-type.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.utmpx.h.002
anchor     basedefs/utmpx.h.html#DESCRIPTION/utmpx
class      conditional
when       XSI
says       <utmpx.h> defines struct utmpx as a complete type with at
           least the members ut_user (char[]), ut_id (char[]), ut_line
           (char[]), ut_pid (pid_t), ut_type (short), ut_tv (struct
           timeval).
test       t/002-struct-utmpx.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.utmpx.h.003
anchor     basedefs/utmpx.h.html#DESCRIPTION/pid_t
class      conditional
when       XSI
says       <utmpx.h> defines the type pid_t.
test       t/003-types-xsi.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.utmpx.h.004
anchor     basedefs/utmpx.h.html#DESCRIPTION/timeval
class      conditional
when       XSI
says       <utmpx.h> defines struct timeval as a complete type.
test       t/004-complete-timeval.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.utmpx.h.005
anchor     basedefs/utmpx.h.html#DESCRIPTION/endutxent
class      conditional
when       XSI
says       <utmpx.h> declares endutxent(), getutxent(), getutxid(),
           getutxline(), pututxline(), setutxent() with the prototypes
           the page gives.
test       t/005-functions-xsi.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

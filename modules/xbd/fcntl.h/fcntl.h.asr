# XBD <fcntl.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Compile-time checks that the header defines what it must. Mutation for
# these needs a deliberately incomplete header set; that arrives with the
# Tier 0 generator, so each says why it has no mutant yet.

assertion  XBD.fcntl.h.001
anchor     basedefs/fcntl.h.html#DESCRIPTION/FD_CLOEXEC
class      required
since      1988
says       <fcntl.h> defines FD_CLOEXEC, usable in #if.
test       t/001-fd-cloexec.c
nomutant   compile-time presence check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.002
anchor     basedefs/fcntl.h.html#DESCRIPTION/FD_CLOFORK
class      required
since      2024
says       <fcntl.h> defines FD_CLOFORK, usable in #if.
test       t/002-fd-clofork.c
nomutant   compile-time presence check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.003
anchor     basedefs/fcntl.h.html#DESCRIPTION/FD_CLOFORK
class      required
since      2024
says       The file descriptor flags FD_CLOEXEC and FD_CLOFORK are
           bitwise-distinct.
uses       XBD.fcntl.h.001 XBD.fcntl.h.002
test       t/003-fd-flags-distinct.c
nomutant   compile-time value check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.004
anchor     basedefs/fcntl.h.html#DESCRIPTION/O_CLOEXEC
class      required
since      2008
says       <fcntl.h> defines O_CLOEXEC, usable in #if.
test       t/004-o-cloexec.c
nomutant   compile-time presence check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.005
anchor     basedefs/fcntl.h.html#DESCRIPTION/O_CLOFORK
class      required
since      2024
says       <fcntl.h> defines O_CLOFORK, usable in #if.
test       t/005-o-clofork.c
nomutant   compile-time presence check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.006
anchor     basedefs/fcntl.h.html#DESCRIPTION/F_OFD_SETLK
class      required
since      2024
says       <fcntl.h> defines F_OFD_GETLK, F_OFD_SETLK and F_OFD_SETLKW,
           usable in #if.
note       A system that defines them only under an extension feature macro FAILs under the strict build (deviation 1.8).
test       t/006-f-ofd.c
nomutant   compile-time presence check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.007
anchor     basedefs/fcntl.h.html#DESCRIPTION/O_TTY_INIT
class      required
since      2008
says       <fcntl.h> defines O_TTY_INIT, usable in #if. Its value may be
           zero.
test       t/007-o-tty-init.c
nomutant   compile-time presence check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.008
anchor     basedefs/fcntl.h.html#DESCRIPTION/F_GETOWN_EX
class      required
since      2024
says       <fcntl.h> defines F_GETOWN_EX and F_SETOWN_EX, the macros
           F_OWNER_PID and F_OWNER_PGRP with different values, and
           struct f_owner_ex with members type and pid.
note       A symbolic constant is a macro (XBD 3.363); an enumeration
           constant alone does not do. A missing struct member makes the
           test UNINITIATED. A system with F_OWNER_* only as enumeration constants, or with them and the struct only under an extension feature macro, FAILs or is UNINITIATED (deviation O.2).
test       t/008-owner-ex.c
nomutant   compile-time presence check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.009
anchor     basedefs/fcntl.h.html#DESCRIPTION/F_DUPFD
class      required
since      1988
says       The fcntl() command constants are usable in #if and have
           different values (F_DUPFD, F_DUPFD_CLOEXEC, F_DUPFD_CLOFORK,
           F_GETFD, F_SETFD, F_GETFL, F_SETFL, F_GETLK, F_SETLK,
           F_SETLKW, the F_OFD_* three, F_GETOWN, F_SETOWN, F_GETOWN_EX,
           F_SETOWN_EX).
test       t/009-cmd-unique.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.010
anchor     basedefs/fcntl.h.html#DESCRIPTION/F_RDLCK
class      required
since      1988
says       F_RDLCK, F_UNLCK and F_WRLCK are usable in #if, have
           different values and fit in l_type (a short).
note       That they fit a short follows from l_type being a short that
           holds them (struct flock).
test       t/010-lock-types.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.011
anchor     basedefs/fcntl.h.html#DESCRIPTION/O_CLOEXEC
class      required
since      2008
says       O_CLOEXEC, O_CLOFORK, O_CREAT, O_DIRECTORY, O_EXCL, O_NOCTTY,
           O_NOFOLLOW, O_TRUNC and O_TTY_INIT are usable in #if and
           share no bits; each is nonzero except that O_TTY_INIT may be
           zero.
note       Zero is allowed for O_TTY_INIT only, as the page says; a zero
           value is bit-disjoint from all.
test       t/011-creation-flags.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.012
anchor     basedefs/fcntl.h.html#DESCRIPTION/O_RDONLY
class      required
since      1988
says       O_RDONLY, O_WRONLY and O_RDWR (and O_EXEC and O_SEARCH when
           defined) are usable in #if and have different values, except
           that O_EXEC and O_SEARCH may be equal.
note       O_RDONLY is commonly zero, so zero is not rejected.
test       t/012-access-modes.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.013
anchor     basedefs/fcntl.h.html#DESCRIPTION/O_ACCMODE
class      required
since      1988
says       O_ACCMODE is usable in #if and every access mode constant
           lies wholly inside it.
note       The page and fcntl() say the access mode is extracted from
           the F_GETFL value with this mask, which presupposes that each
           mode survives the mask (Q-165).
test       t/013-accmode-mask.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.014
anchor     basedefs/fcntl.h.html#DESCRIPTION/O_ACCMODE
class      required
since      1988
says       For a file opened with each access mode, with and without
           O_APPEND and O_NONBLOCK, the F_GETFL result masked with
           O_ACCMODE equals the access mode.
test       t/014-getfl-accmode.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.015
anchor     basedefs/fcntl.h.html#DESCRIPTION/AT_FDCWD
class      required
since      2008
says       AT_FDCWD is not the number of any descriptor (it differs from
           the descriptors in use and is negative or beyond OPEN_MAX),
           and AT_EACCESS, AT_SYMLINK_NOFOLLOW, AT_SYMLINK_FOLLOW and
           AT_REMOVEDIR are nonzero.
note       Nonzero follows from a flag argument of zero meaning no flag;
           whether the flags are distinct from each other is not needed,
           as no function takes two of them (Q-165).
test       t/015-at-constants.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.016
anchor     basedefs/fcntl.h.html#DESCRIPTION/POSIX_FADV_DONTNEED
class      conditional
when       ADV
since      2001
says       The POSIX_FADV_* advice constants (NORMAL, SEQUENTIAL,
           RANDOM, WILLNEED, DONTNEED, NOREUSE) have six different
           values.
note       Not said in words; six advice values that posix_fadvise()
           must tell apart (Q-165).
test       t/016-fadv-distinct.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.017
anchor     basedefs/fcntl.h.html#DESCRIPTION/flock
class      required
since      1988
says       <fcntl.h> defines struct flock as a complete type with at
           least the members l_type (short), l_whence (short), l_start
           (off_t), l_len (off_t), l_pid (pid_t).
test       t/017-struct-flock.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.018
anchor     basedefs/fcntl.h.html#DESCRIPTION/mode_t
class      required
since      2001
says       <fcntl.h> defines the types mode_t, off_t, pid_t.
test       t/018-types-base.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.019
anchor     basedefs/fcntl.h.html#DESCRIPTION/SEEK_SET
class      required
says       <fcntl.h> defines the macros SEEK_SET, SEEK_CUR, SEEK_END.
test       t/019-macros-seek.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.020
anchor     basedefs/fcntl.h.html#DESCRIPTION/O_APPEND
class      required
says       <fcntl.h> defines the macros O_APPEND, O_NONBLOCK, O_SYNC,
           usable in #if.
test       t/020-macros-status-flags.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.021
anchor     basedefs/fcntl.h.html#DESCRIPTION/O_DSYNC
class      conditional
when       SIO
says       <fcntl.h> defines the macros O_DSYNC, O_RSYNC, usable in #if.
test       t/021-macros-status-flags-sio.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.022
anchor     basedefs/fcntl.h.html#DESCRIPTION
class      required
says       <fcntl.h> defines the macros S_IRWXU, S_IRUSR, S_IWUSR,
           S_IXUSR, S_IRWXG, S_IRGRP, S_IWGRP, S_IXGRP, S_IRWXO,
           S_IROTH, S_IWOTH, S_IXOTH, S_ISUID, S_ISGID.
test       t/022-macros-modes.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.023
anchor     basedefs/fcntl.h.html#DESCRIPTION
class      conditional
when       XSI
says       <fcntl.h> defines the macro S_ISVTX.
test       t/023-macros-modes-xsi.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.024
anchor     basedefs/fcntl.h.html#DESCRIPTION/creat
class      required
says       <fcntl.h> declares creat(), fcntl(), open(), openat() with
           the prototypes the page gives.
test       t/024-functions.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.fcntl.h.025
anchor     basedefs/fcntl.h.html#DESCRIPTION/posix_fadvise
class      conditional
when       ADV
says       <fcntl.h> declares posix_fadvise(), posix_fallocate() with

# XBD <signal.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Compile-time and value checks of what the header defines. Mutation for
# these needs a deliberately incomplete header set; that arrives with the
# Tier 0 generator, so each says why it has no mutant yet.

assertion  XBD.signal.h.001
anchor     basedefs/signal.h.html#DESCRIPTION/SIG_DFL
class      required
since      1988
says       <signal.h> defines SIG_DFL, SIG_ERR and SIG_IGN as macros that are
           constant expressions (usable in a static initializer), have the
           type of signal()'s second argument and return value, are all
           different, and differ from the address of a function.
test       t/001-sig-dfl-err-ign.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.signal.h.002
anchor     basedefs/signal.h.html#DESCRIPTION/sig_atomic_t
class      required
since      2008
says       <signal.h> alone defines sig_atomic_t (an integer type), sigset_t,
           pid_t (signed), uid_t, pthread_t, pthread_attr_t and struct
           timespec (tv_sec, and tv_nsec of type long).
note       size_t comes from <stddef.h> through pc.h as well, so it is
           not shown to come from <signal.h> here; nor is sigset_t shown
           to be an integer or structure type.
test       t/002-types.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.signal.h.003
anchor     basedefs/signal.h.html#DESCRIPTION/sigevent
class      required
since      2008
says       struct sigevent has sigev_notify (int), sigev_signo (int),
           sigev_value (union sigval), sigev_notify_function (void (*)(union
           sigval)) and sigev_notify_attributes (pthread_attr_t *).
test       t/003-sigevent.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.signal.h.004
anchor     basedefs/signal.h.html#DESCRIPTION/SIGEV_NONE
class      required
since      2008
says       <signal.h> defines SIGEV_NONE, SIGEV_SIGNAL and SIGEV_THREAD as
           macros with different integer constant values that fit in
           sigev_notify.
note       That the values are distinct is inferred from their having to
           be told apart, not stated (Q-55).
test       t/004-sigev-constants.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.signal.h.005
anchor     basedefs/signal.h.html#DESCRIPTION/sigval
class      required
since      2008
says       union sigval has the members sival_int (int) and sival_ptr
           (void *).
test       t/005-sigval.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.signal.h.006
anchor     basedefs/signal.h.html#DESCRIPTION/SIGRTMIN
class      required
since      2008
says       SIGRTMIN and SIGRTMAX are macros with type int and positive values;
           SIGRTMAX - SIGRTMIN + 1 is at least {RTSIG_MAX} (from sysconf(),
           and never less than 8), and none of the table's signals that the
           header defines falls in the range.
note       <unistd.h> is included for sysconf(). Missing table signals
           are reported by XBD.signal.h.009 to .012 and .030, not here.
           A system that keeps some real-time signals for its own use may have fewer than {RTSIG_MAX} in the range (deviation O.12).
test       t/006-rt-range.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.signal.h.007
anchor     basedefs/signal.h.html#DESCRIPTION/SIGRTMAX
class      required
since      2024
says       <unistd.h> defines _SC_NSIG and <limits.h> defines {NSIG_MAX};
           SIGRTMAX is less than sysconf(_SC_NSIG), which is at most
           {NSIG_MAX}, and every table signal the header defines is less
           than {NSIG_MAX}.
note       <limits.h> and <unistd.h> are included for {NSIG_MAX} and
           sysconf(); a missing name there is a nonconformance of those
           headers, reported here. A system that does not define
           _SC_NSIG or NSIG_MAX (deviation 1.24).
test       t/007-nsig.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.signal.h.008
anchor     basedefs/signal.h.html#DESCRIPTION/SIG2STR_MAX
class      required
since      2024
says       <signal.h> defines SIG2STR_MAX as a value usable in #if, at least
           the size (with the null byte) of each table signal's name without
           SIG and of "RTMIN+n" for the largest n sig2str() must write that
           way, (SIGRTMIN+SIGRTMAX)/2 - SIGRTMIN.
note       sig2str() writes table names without SIG, and SIGRTMIN+1 up
           to (SIGRTMIN+SIGRTMAX)/2 as RTMIN+n; above that it may use
           RTMAX-m, so only the lower half bounds SIG2STR_MAX.
test       t/008-sig2str-max.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.signal.h.009
anchor     basedefs/signal.h.html#DESCRIPTION/SIGABRT
class      required
since      1988
says       <signal.h> defines SIGABRT, SIGFPE, SIGILL, SIGINT, SIGSEGV,
           SIGTERM, SIGALRM, SIGHUP, SIGKILL, SIGPIPE, SIGQUIT, SIGUSR1 and
           SIGUSR2 as integer constant expressions with type int, positive
           and all different.
test       t/009-signals-1988.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.signal.h.010
anchor     basedefs/signal.h.html#DESCRIPTION/SIGCHLD
class      required
since      2001
says       <signal.h> defines SIGCHLD, SIGCONT, SIGSTOP, SIGTSTP, SIGTTIN,
           SIGTTOU and SIGBUS as positive integer constant expressions with
           type int, different from each other and from the signals in
           XBD.signal.h.009.
uses       XBD.signal.h.009
test       t/010-signals-2001.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.signal.h.011
anchor     basedefs/signal.h.html#DESCRIPTION/SIGWINCH
class      required
since      2024
says       <signal.h> defines SIGWINCH as a positive integer constant
           expression with type int, different from the signals in
           XBD.signal.h.009 and .010.
uses       XBD.signal.h.010
test       t/011-signals-2024.c
nomutant   compile-time check; needs the Tier 0 header mutants

assertion  XBD.signal.h.012
anchor     basedefs/signal.h.html#DESCRIPTION/SIGSYS
class      conditional
when       XSI
since      2001
says       On XSI systems <signal.h> also defines SIGSYS, SIGTRAP, SIGVTALRM,
           SIGXCPU and SIGXFSZ, positive, with type int, and different from
           the signals in XBD.signal.h.009 and .010.
uses       XBD.signal.h.010
test       t/012-signals-xsi.c
nomutant   compile-time check; needs the Tier 0 header mutants


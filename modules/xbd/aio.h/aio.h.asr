# XBD <aio.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Semantic checks of the header: values, relations between constants,
# types and macros used at run time. Presence and type shape of every
# name are the Tier 0 header check's. The header mutants for these arrive
# with the Tier 0 generator, so each says why it has no mutant yet.

assertion  XBD.aio.h.001
anchor     basedefs/aio.h.html#DESCRIPTION/AIO_ALLDONE
class      required
since      2001
says       AIO_ALLDONE, AIO_CANCELED and AIO_NOTCANCELED have three
           different values and none is -1, the error return of
           aio_cancel().
note       Return values that aio_cancel() must report apart, and apart
           from its error return (Q-165).
test       t/001-cancel-results.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.aio.h.002
anchor     basedefs/aio.h.html#DESCRIPTION/LIO_NOP
class      required
since      2001
says       LIO_NOP, LIO_READ and LIO_WRITE have three different values.
note       Element operations that aio_lio_opcode must tell apart
           (Q-165).
test       t/002-lio-opcodes.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.aio.h.003
anchor     basedefs/aio.h.html#DESCRIPTION/LIO_WAIT
class      required
since      2001
says       LIO_WAIT and LIO_NOWAIT have different values.
note       Modes that lio_listio() must tell apart (Q-165).
test       t/003-lio-modes.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.aio.h.004
anchor     basedefs/aio.h.html#DESCRIPTION/aiocb
class      required
since      2001
says       <aio.h> defines struct aiocb as a complete type with at least
           the members aio_fildes (int), aio_offset (off_t), aio_buf
           (volatile void *), aio_nbytes (size_t), aio_reqprio (int),
           aio_sigevent (struct sigevent), aio_lio_opcode (int).
test       t/004-struct-aiocb.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.aio.h.005
anchor     basedefs/aio.h.html#DESCRIPTION/off_t
class      required
says       <aio.h> defines the types off_t, pthread_attr_t, size_t,
           ssize_t.
test       t/005-types-base.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.aio.h.006
anchor     basedefs/aio.h.html#DESCRIPTION/timespec
class      required
says       <aio.h> defines struct timespec as a complete type.
test       t/006-complete-struct-timespec.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.aio.h.007
anchor     basedefs/aio.h.html#DESCRIPTION/sigevent
class      required
says       <aio.h> defines struct sigevent and union sigval as complete
           types.
test       t/007-complete-sigevent.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.aio.h.008
anchor     basedefs/aio.h.html#DESCRIPTION/aio_cancel
class      disputed
says       <aio.h> declares aio_cancel(), aio_error(), aio_read(),
           aio_return(), aio_suspend(), aio_write(), lio_listio() with
           the prototypes the page gives.
note       disputed (Q-209): restrict on the elements of the list parameter of
           lio_listio() may be absent; both forms are accepted and a FAIL is
           logged as INSPECT.
test       t/008-functions.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.aio.h.009
anchor     basedefs/aio.h.html#DESCRIPTION/aio_fsync
class      conditional
when       FSC|SIO
says       <aio.h> declares aio_fsync() with the prototypes the page
           gives.
test       t/009-functions-fsc-sio.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

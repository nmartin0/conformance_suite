# XBD <ftw.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Semantic checks of the header: values, relations between constants,
# types and macros used at run time. Presence and type shape of every
# name are the Tier 0 header check's. The header mutants for these arrive
# with the Tier 0 generator, so each says why it has no mutant yet.

assertion  XBD.ftw.h.001
anchor     basedefs/ftw.h.html#DESCRIPTION/FTW_F
class      conditional
when       XSI
since      1988
says       FTW_F, FTW_D, FTW_DNR, FTW_DP, FTW_NS, FTW_SL and FTW_SLN
           have seven different values.
note       Values of the one typeflag argument that the callback tells
           apart (Q-165).
test       t/001-type-flags.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.ftw.h.002
anchor     basedefs/ftw.h.html#DESCRIPTION/FTW_PHYS
class      conditional
when       XSI
since      1988
says       FTW_PHYS, FTW_MOUNT, FTW_XDEV, FTW_DEPTH and FTW_CHDIR are
           nonzero and share no bits.
note       nftw() flags are the bitwise-inclusive OR of these (nftw
           page) (Q-165).
test       t/002-walk-flags.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.ftw.h.003
anchor     basedefs/ftw.h.html#DESCRIPTION/FTW
class      conditional
when       XSI
since      1988
says       <ftw.h> defines struct FTW as a complete type with at least
           the members base (int), level (int).
test       t/003-struct-ftw.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.ftw.h.004
anchor     basedefs/ftw.h.html#DESCRIPTION/stat
class      conditional
when       XSI
says       <ftw.h> defines struct stat as a complete type.
test       t/004-complete-stat.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.ftw.h.005
anchor     basedefs/ftw.h.html#DESCRIPTION
class      conditional
when       XSI
says       <ftw.h> defines the macros S_IRWXU, S_IRUSR, S_IWUSR,
           S_IXUSR, S_IRWXG, S_IRGRP, S_IWGRP, S_IXGRP, S_IRWXO,
           S_IROTH, S_IWOTH, S_IXOTH, S_ISUID, S_ISGID, S_ISVTX, S_IFMT,
           S_IFBLK, S_IFCHR, S_IFIFO, S_IFREG, S_IFDIR, S_IFLNK,
           S_IFSOCK.
test       t/005-macros-st-mode.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.ftw.h.006
anchor     basedefs/ftw.h.html#DESCRIPTION
class      conditional
when       XSI
says       <ftw.h> defines the macros S_ISBLK, S_ISCHR, S_ISDIR,
           S_ISFIFO, S_ISREG, S_ISLNK, S_ISSOCK.
test       t/006-macros-file-type-tests.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.ftw.h.007
anchor     basedefs/ftw.h.html#DESCRIPTION/nftw
class      conditional
when       XSI
says       <ftw.h> declares nftw() with the prototypes the page gives.
test       t/007-functions-xsi.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

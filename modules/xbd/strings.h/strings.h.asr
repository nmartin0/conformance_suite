# XBD <strings.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Semantic content of <strings.h> beyond the names the Tier 0 header check
# covers: the types and declarations the page gives, checked at build time.
# The header mutants for these arrive with the Tier 0 generator, so each
# says why it has no mutant yet.

assertion  XBD.strings.h.001
anchor     basedefs/strings.h.html#DESCRIPTION/locale_t
class      required
says       <strings.h> alone defines the type locale_t.
test       t/001-types-locale.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.strings.h.002
anchor     basedefs/strings.h.html#DESCRIPTION/size_t
class      required
says       <strings.h> alone defines size_t as an unsigned integer type.
note       The page defers to <sys/types.h>.
test       t/002-types-size.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.strings.h.003
anchor     basedefs/strings.h.html#DESCRIPTION/strcasecmp
class      required
says       <strings.h> declares strcasecmp(), strcasecmp_l(), strncasecmp()
           and strncasecmp_l() with the prototypes the page gives (a function
           without a prototype, or with other parameter or result types, does
           not match).
test       t/003-functions.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.strings.h.004
anchor     basedefs/strings.h.html#DESCRIPTION/ffs
class      conditional
when       XSI
says       <strings.h> declares ffs(), ffsl() and ffsll() with the prototypes
           the page gives (a function without a prototype, or with other
           parameter or result types, does not match).
note       The XSI shading in the page covers the three bit-search functions
           only.
test       t/004-functions-xsi.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

# XBD <ndbm.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Semantic checks of the header: values, relations between constants,
# types and macros used at run time. Presence and type shape of every
# name are the Tier 0 header check's. The header mutants for these arrive
# with the Tier 0 generator, so each says why it has no mutant yet.

assertion  XBD.ndbm.h.001
anchor     basedefs/ndbm.h.html#DESCRIPTION/datum
class      required
says       <ndbm.h> defines datum as a complete structure type with at least the
           members dptr (void *), dsize (size_t).
test       t/001-datum.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.ndbm.h.002
anchor     basedefs/ndbm.h.html#DESCRIPTION/size_t
class      required
says       <ndbm.h> defines the type size_t.
test       t/002-types-size_t.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.ndbm.h.003
anchor     basedefs/ndbm.h.html#DESCRIPTION/DBM
class      required
says       <ndbm.h> defines the type DBM.
test       t/003-types-dbm.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.ndbm.h.004
anchor     basedefs/ndbm.h.html#DESCRIPTION/DBM_INSERT
class      required
says       DBM_INSERT and DBM_REPLACE are integer constant expressions with
           different values that fit the int store_mode argument.
note       Their behaviour in dbm_store() is judged by the assertions of the
           dbm_open page.
test       t/004-store-modes.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.ndbm.h.005
anchor     basedefs/ndbm.h.html#DESCRIPTION/dbm_clearerr
class      required
says       <ndbm.h> declares dbm_clearerr(), dbm_close(), dbm_delete(),
           dbm_error(), dbm_fetch(), dbm_firstkey(), dbm_nextkey(), dbm_open(),
           dbm_store() with the prototypes the page gives.
test       t/005-functions.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.ndbm.h.006
anchor     basedefs/ndbm.h.html#DESCRIPTION/mode_t
class      required
says       <ndbm.h> defines the type mode_t.
test       t/006-types-mode_t.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

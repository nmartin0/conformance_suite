# XBD <sys/times.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Semantic checks of the header: values, relations between constants,
# types and macros used at run time. Presence and type shape of every
# name are the Tier 0 header check's. The header mutants for these arrive
# with the Tier 0 generator, so each says why it has no mutant yet.

assertion  XBD.sys_times.h.001
anchor     basedefs/sys_times.h.html#DESCRIPTION/tms
class      required
says       <sys/times.h> defines struct tms as a complete type with at least the
           members tms_utime, tms_stime, tms_cutime, tms_cstime, all of type
           clock_t.
test       t/001-struct-tms.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.sys_times.h.002
anchor     basedefs/sys_times.h.html#DESCRIPTION/clock_t
class      required
says       <sys/times.h> defines the type clock_t.
test       t/002-types-base.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.sys_times.h.003
anchor     basedefs/sys_times.h.html#DESCRIPTION/times
class      required
says       <sys/times.h> declares times() with the prototype the page gives,
           taking a pointer to struct tms.
test       t/003-functions.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

# XBD <sys/msg.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Semantic checks of the header: values, relations between constants,
# types and macros used at run time. Presence and type shape of every
# name are the Tier 0 header check's. The header mutants for these arrive
# with the Tier 0 generator, so each says why it has no mutant yet.

assertion  XBD.sys_msg.h.001
anchor     basedefs/sys_msg.h.html#DESCRIPTION/MSG_NOERROR
class      conditional
when       XSI
since      1988
says       MSG_NOERROR is nonzero and shares no bits with IPC_NOWAIT,
           the other flag of msgrcv().
note       msgflg is tested with & against each of them (msgrcv page)
           (Q-165).
test       t/001-noerror.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.sys_msg.h.002
anchor     basedefs/sys_msg.h.html#DESCRIPTION/msgqnum_t
class      conditional
when       XSI
since      1988
says       msgqnum_t and msglen_t are unsigned integer types at least as
           large as unsigned short.
test       t/002-types.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.sys_msg.h.003
anchor     basedefs/sys_msg.h.html#DESCRIPTION/msqid_ds
class      conditional
when       XSI
says       <sys/msg.h> defines struct msqid_ds as a complete type with
           at least the members msg_perm (struct ipc_perm), msg_qnum
           (msgqnum_t), msg_qbytes (msglen_t), msg_lspid (pid_t),
           msg_lrpid (pid_t), msg_stime (time_t), msg_rtime (time_t),
           msg_ctime (time_t).
test       t/003-struct-msqid_ds.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.sys_msg.h.004
anchor     basedefs/sys_msg.h.html#DESCRIPTION/pid_t
class      conditional
when       XSI
says       <sys/msg.h> defines the types pid_t, size_t, ssize_t, time_t.
test       t/004-types-xsi.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.sys_msg.h.005
anchor     basedefs/sys_msg.h.html#DESCRIPTION/msgctl
class      conditional
when       XSI
says       <sys/msg.h> declares msgctl(), msgget(), msgrcv(), msgsnd()
           with the prototypes the page gives.
test       t/005-functions-xsi.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.sys_msg.h.006
anchor     basedefs/sys_msg.h.html#DESCRIPTION/sys/ipc.h
class      conditional
when       XSI
says       <sys/msg.h> makes what <sys/ipc.h> defines visible: struct
           ipc_perm and the IPC_ macros.
test       t/006-includes-ipc.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

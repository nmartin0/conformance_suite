# XBD <dirent.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Semantic checks of the header: values, relations between constants,
# types and macros used at run time. Presence and type shape of every
# name are the Tier 0 header check's. The header mutants for these arrive
# with the Tier 0 generator, so each says why it has no mutant yet.

assertion  XBD.dirent.h.001
anchor     basedefs/dirent.h.html#DESCRIPTION/DT_BLK
class      required
since      2024
says       DT_BLK, DT_CHR, DT_DIR, DT_FIFO, DT_LNK, DT_REG, DT_SOCK and
           DT_UNKNOWN are usable in #if, have eight different values and
           fit in d_type (an unsigned char).
note       Fitting unsigned char follows from d_type being the member
           that returns them.
test       t/001-dt-distinct.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.dirent.h.002
anchor     basedefs/dirent.h.html#DESCRIPTION/DT_MQ
class      required
since      2024
says       In a directory holding only a regular file, a directory, a
           FIFO and a symbolic link, no posix_getdents() entry has
           d_type DT_MQ, DT_SEM, DT_SHM or DT_TMO, and each of the four
           has its own DT_ value or DT_UNKNOWN.
note       The page lets DT_MQ and the others be equal to nothing else,
           or, when the system has no such file type, any value that is
           never returned; either way no entry of these four ordinary
           files may carry one.
test       t/002-dt-never-returned.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.dirent.h.003
anchor     basedefs/dirent.h.html#DESCRIPTION/DIR
class      required
says       <dirent.h> defines the types DIR, ino_t, size_t, ssize_t.
test       t/003-types-base.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.dirent.h.004
anchor     basedefs/dirent.h.html#DESCRIPTION/reclen_t
class      required
since      2024
says       <dirent.h> defines the type reclen_t.
test       t/004-types-reclen.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.dirent.h.005
anchor     basedefs/dirent.h.html#DESCRIPTION/dirent
class      required
since      1988
says       <dirent.h> defines struct dirent as a complete type with at
           least the members d_ino (ino_t), d_name (char[]).
test       t/005-struct-dirent.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.dirent.h.006
anchor     basedefs/dirent.h.html#DESCRIPTION/posix_dent
class      required
since      2024
says       <dirent.h> defines struct posix_dent as a complete type with
           at least the members d_ino (ino_t), d_reclen (reclen_t),
           d_type (unsigned char), d_name (char[]).
test       t/006-struct-posix_dent.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.dirent.h.007
anchor     basedefs/dirent.h.html#DESCRIPTION/alphasort
class      required
says       <dirent.h> declares alphasort(), closedir(), dirfd(),
           fdopendir(), opendir(), readdir(), readdir_r(), rewinddir(),
           scandir() with the prototypes the page gives.
test       t/007-functions-base.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.dirent.h.008
anchor     basedefs/dirent.h.html#DESCRIPTION/posix_getdents
class      required
since      2024
says       <dirent.h> declares posix_getdents() with the prototypes the
           page gives.
test       t/008-functions-posix-getdents.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.dirent.h.009
anchor     basedefs/dirent.h.html#DESCRIPTION/seekdir
class      conditional
when       XSI
says       <dirent.h> declares seekdir(), telldir() with the prototypes
           the page gives.
test       t/009-functions-xsi.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

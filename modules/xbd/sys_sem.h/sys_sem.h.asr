# XBD <sys/sem.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Semantic checks of the header: values, relations between constants,
# types and macros used at run time. Presence and type shape of every
# name are the Tier 0 header check's. The header mutants for these arrive
# with the Tier 0 generator, so each says why it has no mutant yet.

assertion  XBD.sys_sem.h.001
anchor     basedefs/sys_sem.h.html#DESCRIPTION/SEM_UNDO
class      conditional
when       XSI
since      1988
says       SEM_UNDO is nonzero, fits in a short and shares no bits with
           IPC_NOWAIT, the other flag in sem_flg.
note       sem_flg is a short and is tested with & against both flags
           (semop page) (Q-165).
test       t/001-undo.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.sys_sem.h.002
anchor     basedefs/sys_sem.h.html#DESCRIPTION/GETVAL
class      conditional
when       XSI
since      1988
says       GETNCNT, GETPID, GETVAL, GETALL, GETZCNT, SETVAL, SETALL,
           IPC_RMID, IPC_SET and IPC_STAT have ten different values.
note       All are values of the one cmd argument of semctl() (Q-165).
test       t/002-semctl-cmds.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.sys_sem.h.003
anchor     basedefs/sys_sem.h.html#DESCRIPTION/semid_ds
class      conditional
when       XSI
says       <sys/sem.h> defines struct semid_ds as a complete type with
           at least the members sem_perm (struct ipc_perm), sem_nsems
           (unsigned short), sem_otime (time_t), sem_ctime (time_t).
test       t/003-struct-semid_ds.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.sys_sem.h.004
anchor     basedefs/sys_sem.h.html#DESCRIPTION/pid_t
class      conditional
when       XSI
says       <sys/sem.h> defines the types pid_t, size_t, time_t.
test       t/004-types-xsi.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.sys_sem.h.005
anchor     basedefs/sys_sem.h.html#DESCRIPTION/sembuf
class      conditional
when       XSI
says       <sys/sem.h> defines struct sembuf as a complete type with at
           least the members sem_num (unsigned short), sem_op (short),
           sem_flg (short).
test       t/005-struct-sembuf.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.sys_sem.h.006
anchor     basedefs/sys_sem.h.html#DESCRIPTION/semctl
class      conditional
when       XSI
says       <sys/sem.h> declares semctl(), semget(), semop() with the
           prototypes the page gives.
test       t/006-functions-xsi.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

assertion  XBD.sys_sem.h.007
anchor     basedefs/sys_sem.h.html#DESCRIPTION/sys/ipc.h
class      conditional
when       XSI
says       <sys/sem.h> makes what <sys/ipc.h> defines visible: struct
           ipc_perm and the IPC_ macros.
test       t/007-includes-ipc.c
nomutant   compile-time check of header content; needs the Tier 0 header mutants

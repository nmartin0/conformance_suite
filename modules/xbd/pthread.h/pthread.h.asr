# XBD <pthread.h>
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Semantic checks of the header: values, relations between constants,
# types and macros used at run time. Presence and type shape of every
# name are the Tier 0 header check's. The header mutants for these arrive
# with the Tier 0 generator, so each says why it has no mutant yet.

assertion  XBD.pthread.h.001
anchor     basedefs/pthread.h.html#DESCRIPTION/PTHREAD_CANCEL_ENABLE
class      required
since      2001
says       PTHREAD_CANCEL_ENABLE and PTHREAD_CANCEL_DISABLE have
           different values.
note       Alternatives that a get function must report apart (Q-165).
test       t/001-cancel-state.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.pthread.h.002
anchor     basedefs/pthread.h.html#DESCRIPTION/PTHREAD_CANCEL_DEFERRED
class      required
since      2001
says       PTHREAD_CANCEL_DEFERRED and PTHREAD_CANCEL_ASYNCHRONOUS have
           different values.
note       Alternatives that a get function must report apart (Q-165).
test       t/002-cancel-type.c
nomutant   header content check; needs the Tier 0 header mutants

assertion  XBD.pthread.h.003
anchor     basedefs/pthread.h.html#DESCRIPTION/PTHREAD_CREATE_DETACHED
class      required

# XCU tail
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XCU.tail.001
anchor     utilities/tail.html#OPTIONS
class      required
since      1992
says       Without options tail writes the last ten lines of the file, or the
           whole file when it has fewer.
test       t/001-default-ten-lines.sh

assertion  XCU.tail.002
anchor     utilities/tail.html#OPTIONS/-n
class      required
since      1992
says       tail -n number with no sign or a minus sign starts that many lines
           before the end; with a plus sign it starts at the numberth line,
           counting from 1.
test       t/002-line-count.sh

assertion  XCU.tail.003
anchor     utilities/tail.html#OPTIONS/-c
class      required
since      1992
says       tail -c number with no sign or a minus sign starts that many bytes
           before the end; with a plus sign it starts at the numberth byte,
           counting from 1.
test       t/003-byte-count.sh

assertion  XCU.tail.004
anchor     utilities/tail.html#OPTIONS/-r
class      required
since      2024
says       tail -r writes the lines in reverse order, all of them, or only the
           last number given by -n.
test       t/004-reverse.sh

assertion  XCU.tail.005
anchor     utilities/tail.html#OPERANDS
anchor     utilities/tail.html#STDIN
class      required
since      1992
says       With no file operand tail reads standard input.
test       t/005-standard-input.sh

assertion  XCU.tail.006
anchor     utilities/tail.html#EXIT STATUS
class      required
since      1992
says       A file operand that cannot be read gives a nonzero status.
test       t/006-unreadable-file.sh

assertion  XCU.tail.007
anchor     utilities/tail.html#OPTIONS/-f
class      required
since      1992
says       tail -f on a regular file does not end after copying the last
           lines but goes on copying bytes appended to the file; the test
           waits up to thirty seconds for them because no bound is stated.
note       No time bound is stated for the appearance of new data; data that
           does not arrive in time gives UNRESOLVED, an exit of tail gives
           FAIL.
timeout    120
test       t/007-follow.sh

# XCU make
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# make on small makefiles that start with the .POSIX special target.
# Everything is conditional on the Software Development option. Commands are
# plain echo, touch, cp and false so no compiler is needed except where
# noted. File times are set explicitly with touch -t.

assertion  XCU.make.001
anchor     utilities/make.html#EXTENDED DESCRIPTION
anchor     utilities/make.html#OPTIONS/-f
class      conditional
when       SD
since      1992
says       With both ./makefile and ./Makefile present, ./makefile is used;
           with only ./Makefile it is used; -f NAME uses that file instead;
           -f - reads the makefile from standard input; with several -f
           options the first target found in the first file is the default.
test       t/001-makefile-selection.sh

assertion  XCU.make.002
anchor     utilities/make.html#OPERANDS
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       With no operand make builds the first target that is not special;
           "make b a" builds b then a; a target with no rule that does not
           exist is an error (nonzero status); an existing file with no rule
           is up to date (status 0).
test       t/002-targets-and-defaults.sh

assertion  XCU.make.003
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       A target older than a prerequisite is rebuilt; a target newer
           than its prerequisites is not; prerequisites are brought up to
           date in the order listed before the target's own commands; a
           missing target is built.
test       t/003-up-to-date.sh

assertion  XCU.make.004
anchor     utilities/make.html#STDOUT
anchor     utilities/make.html#EXTENDED DESCRIPTION
anchor     utilities/make.html#OPTIONS/-s
class      conditional
when       SD
since      1992
says       Commands are written to standard output before execution except
           those with a @ prefix; with -s, or with .SILENT without
           prerequisites, or with the target listed after .SILENT, none is
           written; the commands' own output is unaffected.
test       t/004-echo-and-silence.sh

assertion  XCU.make.005
anchor     utilities/make.html#OPTIONS/-n
class      conditional
when       SD
since      1992
says       With -n the commands are written but not run (including @ lines,
           which are written), except that a + prefixed line is run.
test       t/005-dry-run.sh

assertion  XCU.make.006
anchor     utilities/make.html#EXTENDED DESCRIPTION
anchor     utilities/make.html#OPTIONS/-i
anchor     utilities/make.html#EXIT STATUS
class      conditional
when       SD
since      1992
says       A failing command stops make with nonzero status before later
           commands; a - prefix, -i, or a .IGNORE special target make the
           failure ignored (status 0, later commands run); a command line is
           run with the shell -e option unless errors are ignored.
test       t/006-error-handling.sh

assertion  XCU.make.007
anchor     utilities/make.html#OPTIONS/-k
anchor     utilities/make.html#OPTIONS/-S
class      conditional
when       SD
since      1992
says       After a failure, make -k still builds independent targets and
           ends with nonzero status; without -k, or with -S after -k, it
           stops; with -S before -k it keeps going.
test       t/007-keep-going.sh

assertion  XCU.make.008
anchor     utilities/make.html#OPTIONS/-q
anchor     utilities/make.html#EXIT STATUS
class      conditional
when       SD
since      1992
says       "make -q" exits 0 when the target is up to date and 1 when it is
           not, and does not run its commands, except that a + prefixed
           command is run.
test       t/008-question.sh

assertion  XCU.make.009
anchor     utilities/make.html#OPTIONS/-t
class      conditional
when       SD
since      1992
says       "make -t" does not run an out-of-date target's commands but
           updates the target's modification time and writes a message
           naming it; a target with prerequisites but no commands is not
           touched.
test       t/009-touch.sh

assertion  XCU.make.010
anchor     utilities/make.html#EXTENDED DESCRIPTION
anchor     utilities/make.html#OPTIONS/-e
anchor     utilities/make.html#ENVIRONMENT VARIABLES
class      conditional
when       SD
since      1992
says       Macros come from the command line, MAKEFLAGS, the environment,
           the makefile; a makefile definition overrides the environment
           unless -e is given; a command-line definition overrides both; a
           null environment value overrides with -e.
test       t/010-macro-precedence.sh

assertion  XCU.make.011
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       "=" is delayed, "::=" and ":::=" expand at definition, "!=" takes
           the shell output (newlines become spaces, failure is not an
           error), "?=" assigns only if not defined, "+=" appends with a
           space.
test       t/011-macro-forms.sh

assertion  XCU.make.012
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       $(X:.c=.o) and ${X:.c=.o} replace a suffix of each word, $$ gives
           a dollar sign for the shell, a one-character macro needs no
           parentheses, and an undefined macro gives an empty string.
test       t/012-macro-expansion.sh

assertion  XCU.make.013
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       In a target rule $@ is the target, $? only the prerequisites
           newer than the target, and $(@D) and $(@F) the directory part (.
           when there is none) and the file name part.
test       t/013-internal-macros.sh

assertion  XCU.make.014
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       With .SUFFIXES listing .in and .out, a .in.out rule builds x.out
           from an existing x.in with $< and $* set accordingly and rebuilds
           when x.in is newer; a single-suffix rule builds tool from
           tool.one; an empty .SUFFIXES clears the list so the rule is no
           longer used; -r removes the built-in rules.
test       t/014-inference-rules.sh

assertion  XCU.make.015
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       An existing file with no prerequisites is up to date and its
           commands do not run; .DEFAULT commands build any target with no
           rule, with $< the target name; the first target after special
           ones is the default.
test       t/015-special-targets.sh

assertion  XCU.make.016
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2008
says       include FILE reads FILE as if in place (also through a macro and
           nested); a missing file is an error.
test       t/016-include.sh

assertion  XCU.make.017
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       A backslash-newline in a macro definition joins the lines, and
           one in a command line is passed to the shell with the next line
           (minus a leading tab).
test       t/017-line-continuation.sh

assertion  XCU.make.018
anchor     utilities/make.html#OPTIONS/-n
anchor     utilities/make.html#ENVIRONMENT VARIABLES
class      conditional
when       SD
since      1992
says       Under -n a command line using $(MAKE) is still run, and the sub-
           make also behaves as if -n, so the sub-make's own command is
           written and not run; MAKEFLAGS=n and MAKEFLAGS=-n in the
           environment act as -n.
test       t/018-sub-make.sh

assertion  XCU.make.019
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       $(CURDIR) is the working directory (the same as pwd -L or pwd
           -P); the SHELL environment variable does not change the SHELL
           macro or stop commands running.
test       t/019-special-macros.sh

assertion  XCU.make.020
anchor     utilities/make.html#OPTIONS/-j
class      conditional
when       SD
since      2024
says       "make -j 2" with four independent targets builds them all and
           exits 0, and a .WAIT prerequisite makes the targets to its right
           start after those to its left are done.
test       t/020-parallel.sh

assertion  XCU.make.021
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       A target lib.a(f.o) is a member of an archive: in its commands $@
           is lib.a and $% is f.o; building it adds the member f.o to lib.a.
test       t/021-archive-members.sh

assertion  XCU.make.022
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       In a target rule $^ is the list of prerequisites without
           duplicates and $+ the list with duplicates.
test       t/022-caret-plus-macros.sh

assertion  XCU.make.023
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       $(X:%.c=%.x) and $(X:a.%=new_%) replace by pattern, and nested
           references like $($(N)) are expanded inside out.
test       t/023-pattern-nested-macros.sh

assertion  XCU.make.024
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       A target named in .PHONY always runs even if a file of that name
           exists.
test       t/024-phony.sh

assertion  XCU.make.025
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       A missing file named on an -include line is ignored, and a file
           that exists is still read.
test       t/025-silent-include.sh

assertion  XCU.make.026
anchor     utilities/make.html#OPTIONS
class      conditional
when       SD
since      1992
says       With -p make writes the macro definitions and target descriptions to
           standard output; the layout is not specified.
test       t/026-print-database.sh

assertion  XCU.make.027
anchor     utilities/make.html#ASYNCHRONOUS EVENTS
class      conditional
when       SD
since      2024
says       When make receives SIGTERM while a command of a target runs, it
           removes that target if its modification time changed, unless the
           target is a prerequisite of .PRECIOUS or .PHONY (or .PRECIOUS has no
           prerequisites), and it ends with an error status or by the signal.
test       t/027-signal-removal.sh

assertion  XCU.make.028
anchor     utilities/make.html#ENVIRONMENT VARIABLES
anchor     utilities/make.html#OPTIONS
class      conditional
when       SD
since      1992
says       MAKEFLAGS can hold option letters with or without leading hyphens, its
           options are taken before those of the command line, and of -k and -S
           given together the last one wins.
test       t/028-makeflags-options.sh

assertion  XCU.make.029
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       Macros given on the command line are added to the environment of the
           commands while macros defined only in the makefile are not, and the
           options and command line macros are passed to a sub-make.
test       t/029-environment-and-submake.sh

assertion  XCU.make.030
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       .IGNORE with prerequisites makes errors from the commands of those
           targets ignored only, and later .IGNORE lines add targets to the list.
test       t/030-ignore-prerequisites.sh

assertion  XCU.make.031
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       Prerequisites given for a target on several lines add up while one
           rule supplies the commands, and an inference rule defined twice has
           the last definition.
test       t/031-rule-accumulation.sh

assertion  XCU.make.032
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       A number sign starts a comment that is not part of a macro value nor
           of the prerequisites of a target; blank lines and lines beginning with
           # are skipped.
test       t/032-comments.sh

assertion  XCU.make.033
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       A rule naming several targets gives each of them the commands, a
           command after a semicolon is the first command and tab lines add more,
           and a rule with only a semicolon is an empty rule that does nothing.
test       t/033-multiple-targets.sh

assertion  XCU.make.034
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       Macros in a target line are expanded when the line is read and in
           command lines when they run, a macro in the name part of a definition
           is expanded at the definition, and at least 100 levels of indirection
           work.
test       t/034-macro-timing.sh

assertion  XCU.make.035
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       A substitution on an unset or empty macro gives an empty string, the
           first equals sign after the colon is the separator, and words that do
           not match are left unchanged.
test       t/035-substitution-edges.sh

assertion  XCU.make.036
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       A CURDIR variable in the environment does not change the CURDIR macro
           unless -e is given and is itself set to the macro value otherwise, and
           CURDIR on the command line replaces the macro without changing the
           directory.
test       t/036-curdir-environment.sh

assertion  XCU.make.037
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       Defining SHELL in the makefile or on the command line does not change
           the SHELL environment variable seen by commands.
test       t/037-shell-macro.sh

assertion  XCU.make.038
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       The built-in .sh rule copies a script and makes the copy executable,
           and a .c.o rule in the makefile replaces the built-in rule.
test       t/038-default-rules.sh

assertion  XCU.make.039
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       An inference rule made only of a semicolon is an empty rule that is
           found and runs without effect, so no file is made and there is no
           error.
test       t/039-empty-inference-rule.sh

assertion  XCU.make.040
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       For lib.a(m.o) made by a .x.a rule the internal macros are m.x for $<,
           m for $*, lib.a for $@, m.x for $^ and $?, and m.o for $%.
test       t/040-library-inference.sh

assertion  XCU.make.041
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       With .NOTPARALLEL in the makefile make updates one target at a time
           even when -j asks for more.
test       t/041-notparallel.sh

assertion  XCU.make.042
anchor     utilities/make.html#OPTIONS
class      conditional
when       SD
since      2024
says       With -j 1 targets are updated one at a time, and when -j is given
           several times the last value is used.
test       t/042-jobs-one.sh

assertion  XCU.make.043
anchor     utilities/make.html#OPTIONS
class      conditional
when       SD
since      1992
says       Options can be grouped, an option-argument can be attached to its
           option or separate, and -- ends the options before the operands.
test       t/043-option-syntax.sh

assertion  XCU.make.044
anchor     utilities/make.html#OPERANDS
class      conditional
when       SD
since      2024
says       Macro definition operands in the delayed and immediate forms are
           processed in the order given, later ones replacing earlier ones.
test       t/044-macro-operands.sh

assertion  XCU.make.045
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       An include line can name several files and end in a comment, and a
           relative name is taken from the working directory and not from the
           directory of the makefile.
test       t/045-include-forms.sh

assertion  XCU.make.046
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       Include files can be nested to a depth of sixteen.
test       t/046-include-depth.sh

assertion  XCU.make.047
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       An include file that does not exist is made with the rule for it and
           then read, and with -n the commands that make it are still run.
test       t/047-include-generated.sh

assertion  XCU.make.048
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       A backslash-newline in a target line joins the next line to it so that
           its words are prerequisites.
test       t/048-target-continuation.sh

assertion  XCU.make.049
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      1992
says       A target that does not exist after its commands succeeded is treated
           as newer than the targets that need it, so those are made too.
test       t/049-target-not-created.sh

assertion  XCU.make.050
anchor     utilities/make.html#ENVIRONMENT VARIABLES
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       Variables of the environment, also those with a null value, are macros
           and are in the environment of the commands.
test       t/050-environment-macros.sh

assertion  XCU.make.051
anchor     utilities/make.html#OPTIONS
anchor     utilities/make.html#EXTENDED DESCRIPTION
class      conditional
when       SD
since      2024
says       With -t a phony target is neither touched nor run, while an ordinary
           target with commands is touched; a command with a + prefix is
           still run.
test       t/051-touch-phony.sh

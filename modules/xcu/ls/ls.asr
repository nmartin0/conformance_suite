# XCU ls
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Tests run in the private directory the driver gives. Scaffolding uses only POSIX utilities; setup problems are UNRESOLVED.

assertion  XCU.ls.001
anchor     utilities/ls.html#DESCRIPTION
anchor     utilities/ls.html#STDOUT
anchor     utilities/ls.html#OPTIONS
class      required
says       ls lists the visible entries of a directory one per line,
           sorted by the collating sequence (byte order in the POSIX
           locale), omitting names that start with a period; -1 and a
           later -1 after -C give the same.
test       t/001-default.sh

assertion  XCU.ls.002
anchor     utilities/ls.html#OPTIONS
anchor     utilities/ls.html#DESCRIPTION
class      required
says       ls -a also lists names that start with a period.
test       t/002-option-a.sh

assertion  XCU.ls.003
anchor     utilities/ls.html#OPTIONS
class      required
says       ls -A lists names that start with a period but never dot or
           dot-dot.
test       t/003-option-A.sh

assertion  XCU.ls.004
anchor     utilities/ls.html#OPTIONS
anchor     utilities/ls.html#STDOUT
class      required
says       ls -m writes the names across the page separated by a comma and
           a space, ending with a newline.
test       t/004-option-m.sh

assertion  XCU.ls.005
anchor     utilities/ls.html#STDOUT
anchor     utilities/ls.html#ENVIRONMENT VARIABLES
class      required
says       ls -m starts a new line, after the comma, when the next name
           does not fit the line length given by COLUMNS.
test       t/005-option-m-wrap.sh

assertion  XCU.ls.006
anchor     utilities/ls.html#OPTIONS
class      required
says       ls -p writes a slash after each directory name.
test       t/006-option-p.sh

assertion  XCU.ls.007
anchor     utilities/ls.html#OPTIONS
class      required
says       ls -F marks directories with /, executables with *, FIFOs with
           | and symbolic links with @.
test       t/007-option-F.sh

assertion  XCU.ls.008
anchor     utilities/ls.html#OPTIONS
anchor     utilities/ls.html#STDOUT
class      required
says       ls -l of a directory starts with a total line and then one line
           per file with mode, link count, owner, group, size, a
           three-part date and the name.
test       t/008-long-format.sh

assertion  XCU.ls.009
anchor     utilities/ls.html#STDOUT
class      required
says       The first character of the long format mode is d for a
           directory, p for a FIFO, l for a symbolic link and - for a
           regular file.
test       t/009-entry-types.sh

assertion  XCU.ls.010
anchor     utilities/ls.html#STDOUT
class      required
says       In the long format mode, the owner execute position shows s for
           set-user-ID with execute and S without.
test       t/010-setuid-chars.sh

assertion  XCU.ls.011
anchor     utilities/ls.html#STDOUT
class      conditional
when       XSI
says       On a directory, the other-execute position shows t for the
           sticky bit with search permission and T without.
test       t/011-sticky-chars.sh

assertion  XCU.ls.012
anchor     utilities/ls.html#STDOUT
class      required
says       In the long format a symbolic link is shown as name, space,
           arrow, space, link contents.
test       t/012-symlink-long.sh

assertion  XCU.ls.013
anchor     utilities/ls.html#OPTIONS
anchor     utilities/ls.html#STDOUT
class      required
says       ls -n shows the numeric user ID and a numeric group ID instead
           of names.
test       t/013-option-n.sh

assertion  XCU.ls.014
anchor     utilities/ls.html#OPTIONS
anchor     utilities/ls.html#STDOUT
class      conditional
when       XSI
says       ls -g writes the long format without the owner.
test       t/014-option-g.sh

assertion  XCU.ls.015
anchor     utilities/ls.html#OPTIONS
anchor     utilities/ls.html#STDOUT
class      conditional
when       XSI
says       ls -o writes the long format without the group.
test       t/015-option-o.sh

assertion  XCU.ls.016
anchor     utilities/ls.html#OPTIONS
anchor     utilities/ls.html#STDOUT
class      required
says       ls -i puts the file serial number before each name: equal for
           names of one file, different for different files.
test       t/016-option-i.sh

assertion  XCU.ls.017
anchor     utilities/ls.html#OPTIONS
anchor     utilities/ls.html#STDOUT
class      required
says       ls -s puts a total line first and the block count before each
           name.
test       t/017-option-s.sh

assertion  XCU.ls.018
anchor     utilities/ls.html#OPTIONS
anchor     utilities/ls.html#STDOUT
class      required
says       With -k, the block size for -s and for the total line of the
           long format is 1024 bytes.
test       t/018-option-k.sh

assertion  XCU.ls.019
anchor     utilities/ls.html#OPTIONS
anchor     utilities/ls.html#STDOUT
class      required
says       ls -R lists a directory and then each subdirectory below it,
           each preceded by a blank line and a header with its pathname.
test       t/019-option-R.sh

assertion  XCU.ls.020
anchor     utilities/ls.html#OPTIONS
class      required
says       ls -R descends into a subdirectory whose name starts with a
           period only if that name was listed.
test       t/020-R-hidden.sh

assertion  XCU.ls.021
anchor     utilities/ls.html#OPTIONS
class      required
says       ls -R does not descend through a symbolic link to a directory
           unless -L is given.
test       t/021-R-symlink.sh

assertion  XCU.ls.022
anchor     utilities/ls.html#OPTIONS
anchor     utilities/ls.html#DESCRIPTION
class      required
says       ls -d writes a directory operand itself instead of its
           contents; with no operand it writes dot.
test       t/022-option-d.sh

assertion  XCU.ls.023
anchor     utilities/ls.html#DESCRIPTION
anchor     utilities/ls.html#STDOUT
class      required
says       With several operands ls writes the non-directories first, then
           each directory (sorted) under a blank line and a header with
           its pathname.
test       t/023-operand-order.sh

assertion  XCU.ls.024
anchor     utilities/ls.html#OPTIONS
class      required
says       ls -r reverses the collating order.
test       t/024-option-r.sh

assertion  XCU.ls.025
anchor     utilities/ls.html#OPTIONS
class      required
says       ls -S sorts by size, largest first, ties by name; with -r the
           smallest comes first.
test       t/025-option-S.sh

assertion  XCU.ls.026
anchor     utilities/ls.html#OPTIONS
class      required
says       ls -t sorts by modification time, newest first, ties by name;
           with -r the oldest comes first.
test       t/026-option-t.sh

assertion  XCU.ls.027
anchor     utilities/ls.html#OPTIONS
class      required
says       With -t, -u sorts by the time of last access instead of
           modification.
test       t/027-option-u.sh

assertion  XCU.ls.028
anchor     utilities/ls.html#STDOUT
class      required
says       In the POSIX locale the long format date is month, day and
           hour:minute for a recent file and month, day and year for an
           old or future one.
note       The year of a future file rests on touch -t accepting a date in
           2037, which the touch page requires.
test       t/028-date-format.sh

assertion  XCU.ls.029
anchor     utilities/ls.html#OPTIONS
anchor     utilities/ls.html#STDOUT
class      required
says       For a symbolic link to a file, ls -l describes the link itself;
           with -L or -H it describes the file but still writes the name
           of the link.
test       t/029-L-H-file.sh

assertion  XCU.ls.030
anchor     utilities/ls.html#DESCRIPTION
class      required
says       A symbolic link to a directory given as operand is followed
           (its contents listed) when none of -d, -F, -l is used.
test       t/030-dirlink-follow.sh

assertion  XCU.ls.031
anchor     utilities/ls.html#DESCRIPTION
anchor     utilities/ls.html#OPTIONS
class      required
says       With -d, -F or -l, a symbolic link to a directory given as
           operand is not followed.
test       t/031-dirlink-nofollow.sh

assertion  XCU.ls.032
anchor     utilities/ls.html#OPTIONS
anchor     utilities/ls.html#DESCRIPTION
class      required
says       With -H, a symbolic link to a directory given as operand is
           followed even with -l.
test       t/032-H-dirlink.sh

assertion  XCU.ls.033
anchor     utilities/ls.html#OPTIONS
class      required
says       ls -f lists every entry, including those starting with a
           period, in unspecified order.
test       t/033-option-f.sh

assertion  XCU.ls.034
anchor     utilities/ls.html#OPTIONS
class      required
says       ls -q writes a question mark for each nonprintable character of
           a file name, including a newline.
test       t/034-option-q.sh

assertion  XCU.ls.035
anchor     utilities/ls.html#OPTIONS
class      required
says       -C, -x and -m turn long format off and a later -l turns it on
           again: the total line shows which one wins.
test       t/035-long-vs-columns.sh

assertion  XCU.ls.036
anchor     utilities/ls.html#OPERANDS
anchor     utilities/ls.html#EXIT STATUS
class      required
says       A nonexistent operand gets a diagnostic and a non-zero status,
           and the other operands are still listed.
test       t/036-nonexistent.sh

assertion  XCU.ls.037
anchor     utilities/ls.html#DESCRIPTION
anchor     utilities/ls.html#STDOUT
class      required
says       With no operand ls lists the current directory; a file operand
           is written as given, and a dot file is listed when named.
test       t/037-operands-as-given.sh

assertion  XCU.ls.038
anchor     utilities/ls.html#OPTIONS/-C
anchor     utilities/ls.html#OPTIONS/-x
anchor     utilities/ls.html#ENVIRONMENT VARIABLES
class      required
since      1992
says       With 12 names of different lengths and COLUMNS=40, ls -C writes
           them so that reading down the columns gives the collating order and
           ls -x so that reading across the rows does; every name appears
           once and whole, no line is longer than 40 columns and the names of
           one column start at the same position in every line.
test       t/038-multicolumn.sh

assertion  XCU.ls.039
anchor     utilities/ls.html#OPTIONS/-f
class      required
since      1992
says       ls -f lists dot and dot-dot and the hidden names (it turns on -a),
           and -r, -t and -S given with -f leave the order exactly as
           without them.
test       t/039-option-f-ignores.sh

assertion  XCU.ls.040
anchor     utilities/ls.html#OPTIONS/-c
anchor     utilities/ls.html#OPTIONS/-S
class      required
since      1992
says       With files whose modification time, status change time and size
           give three different orders: -t sorts by modification time, -t -c
           by status change time, -t -c -S by size (the last of -c, -u and
           -S wins) and -S -c by size; the time written by -l is the status change time with -c (even after
           -S) and the modification time without it.
test       t/040-option-c.sh

assertion  XCU.ls.041
anchor     utilities/ls.html#STDOUT
class      required
since      1992
says       In the long format mode each of the nine permission positions
           shows r, w or x only for its own bit (modes 400, 200, 100, 040,
           020, 010, 004, 002, 001 and 000 give one letter or none); with
           set-group-ID the group position shows s when the group may execute
           and S when it may not.
test       t/041-permission-letters.sh

assertion  XCU.ls.042
anchor     utilities/ls.html#STDOUT
class      required
since      1992
says       "ls -l /dev/null" writes a line for a character special file: the
           mode starts with c, the link count is a number, the owner and
           group follow, and the line ends with the pathname as given.
test       t/042-char-special.sh

assertion  XCU.ls.043
anchor     utilities/ls.html#STDOUT
anchor     utilities/ls.html#OPTIONS/-F
class      required
since      1992
says       "ls -lF" of symbolic links writes name, @, arrow and contents,
           optionally followed by the indicator of the target (/ for a
           directory, * for an executable file, nothing for a plain file or
           a missing target, which is not an error); "ls -lp" writes no @
           and, optionally, the slash of a directory target only.
test       t/043-symlink-indicators.sh

assertion  XCU.ls.044
anchor     utilities/ls.html#STDOUT
anchor     utilities/ls.html#OPTIONS/-i
anchor     utilities/ls.html#OPTIONS/-s
class      required
since      1992
says       "ls -i -s -l" writes the total line and then lines that start with
           the serial number and the block count before the mode; "ls -i -s
           -1" writes serial number, block count and name.
test       t/044-inode-blocks-long.sh

assertion  XCU.ls.045
anchor     utilities/ls.html#DESCRIPTION
class      required
since      1992
says       "ls -RL" on a tree with a symbolic link to an ancestor directory
           writes a diagnostic to standard error and does not run on: it
           recovers or terminates.
test       t/045-loop.sh

assertion  XCU.ls.046
anchor     utilities/ls.html#OPTIONS/-S
anchor     utilities/ls.html#OPTIONS/-t
anchor     utilities/ls.html#OPTIONS/-H
class      required
since      1992
says       -S and -t use the size and time of a symbolic link itself unless
           -H (for operands) or -L evaluates it as the file it refers to.
test       t/046-sort-symlinks.sh

assertion  XCU.ls.047
anchor     utilities/ls.html#ENVIRONMENT VARIABLES
anchor     utilities/ls.html#STDOUT
class      required
since      1992
says       The hour in the long format time of a recent file follows TZ:
           with TZ=XYZ-3 it is three hours later than with TZ=UTC0 and the
           minutes are the same.
test       t/047-tz.sh

assertion  XCU.ls.048
anchor     utilities/ls.html#OPTIONS/-A
anchor     utilities/ls.html#OPTIONS/-F
class      required
since      1992
says       Of two options from one exclusive set the last decides: "-A -a"
           lists dot and dot-dot and "-a -A" does not; "-F -p" marks
           directories only and "-p -F" also marks executables; "-m -1"
           writes one name per line and "-1 -m" a comma list; "-C -x" is the
           same as -x and "-x -C" the same as -C.
test       t/048-last-option-wins.sh

assertion  XCU.ls.049
anchor     utilities/ls.html#EXIT STATUS
anchor     utilities/ls.html#STDERR
class      required
since      1992
says       A successful ls exits with status 0 and writes nothing to standard
           error.
test       t/049-success.sh

assertion  XCU.ls.050
anchor     utilities/ls.html#OPTIONS/-n
anchor     utilities/ls.html#OPTIONS/-1
class      required
since      1992
says       -n written after -C, -m or -x switches the long format on and
           written before them is switched off by them (the total line shows
           which one wins), and -1 does not switch the long format off
           ("-l -1" and "-1 -l" still write the total line and the long
           lines).
test       t/050-long-enablers.sh

assertion  XCU.ls.051
anchor     utilities/ls.html#OPTIONS/-g
anchor     utilities/ls.html#OPTIONS/-o
class      conditional
when       XSI
since      1992
says       -g and -o behave as -n does for the long format: written after -C,
           -m or -x they switch it on, written before them they are switched
           off, and -1 does not switch it off.
test       t/051-long-enablers-xsi.sh

assertion  XCU.ls.052
anchor     utilities/ls.html#STDOUT
class      required
since      1992
says       "ls -lR d" with a subdirectory d/sub writes a blank line, the
           header "d/sub:" and then the total line of that directory, in
           this order.
test       t/052-R-header-total.sh

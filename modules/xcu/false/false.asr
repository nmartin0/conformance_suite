# XCU false
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# As for true: each test checks both the way the shell runs the name and
# a direct exec (XCU 1.6), and "Not used." follows XCU 1.4.

assertion  XCU.false.001
anchor     utilities/false.html#EXIT STATUS
anchor     utilities/V3_chap01.html#1.6
class      required
since      1992
says       false exits with a non-zero status.
test       t/001-status.sh

assertion  XCU.false.002
anchor     utilities/false.html#STDOUT
anchor     utilities/V3_chap01.html#1.6
class      required
since      1992
says       false writes nothing to standard output.
test       t/002-no-stdout.sh

assertion  XCU.false.003
anchor     utilities/false.html#STDERR
anchor     utilities/V3_chap01.html#1.6
class      required
since      1992
says       false writes nothing to standard error.
test       t/003-no-stderr.sh

assertion  XCU.false.004
anchor     utilities/false.html#EXIT STATUS
anchor     utilities/V3_chap01.html#1.6
class      required
since      2024
says       false exits with a status from 1 to 125 inclusive.
note       Austin Group defect 1321 (Issue 8) set the range; before, the
           status had only to be non-zero (XCU.false.001).
test       t/004-status-range.sh

# Locale, time zone and message variables (h2a). A locale other than the POSIX locale is made with
# localedef (core/pcloc.sh); making locales is optional (POSIX2_LOCALEDEF), so those tests report
# NOTINUSE without it.

assertion  XCU.false.005
anchor     utilities/false.html#ENVIRONMENT VARIABLES
anchor     utilities/false.html#STDERR
class      required
says       No environment variable affects false: with locale and catalog
           variables set to a made locale and to catalog names that do not exist it still exits 1 and
           writes nothing.
timeout    60
test       t/005-odd-environment.sh

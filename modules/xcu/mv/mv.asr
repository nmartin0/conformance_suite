# XCU mv
# Copyright (c) 2026 Nicholas Martin. All rights reserved.
#
# Tests run in the private directory the driver gives. Scaffolding uses only POSIX utilities; setup problems are UNRESOLVED.

assertion  XCU.mv.001
anchor     utilities/mv.html#DESCRIPTION
anchor     utilities/mv.html#STDOUT
class      required
says       mv source_file target_file renames a file: the target has the
           contents, the source name is gone, nothing is written to
           standard output.
test       t/001-rename.sh

assertion  XCU.mv.002
anchor     utilities/mv.html#DESCRIPTION
class      required
says       mv onto an existing file replaces it, without prompting when
           standard input is not a terminal.
test       t/002-overwrite.sh

assertion  XCU.mv.003
anchor     utilities/mv.html#DESCRIPTION
class      required
says       mv source_file... target_dir moves each source to
           target_dir/basename.
test       t/003-into-directory.sh

assertion  XCU.mv.004
anchor     utilities/mv.html#DESCRIPTION
class      required
says       mv renames a directory with everything below it.
test       t/004-directory.sh

assertion  XCU.mv.005
anchor     utilities/mv.html#OPTIONS
anchor     utilities/mv.html#STDERR
class      required
says       With -i, an existing destination triggers a prompt naming it on
           standard error; a negative reply leaves both files alone.
test       t/005-option-i-no.sh

assertion  XCU.mv.006
anchor     utilities/mv.html#OPTIONS
class      required
says       With -i, an affirmative reply makes mv replace the destination.
test       t/006-option-i-yes.sh

assertion  XCU.mv.007
anchor     utilities/mv.html#OPTIONS
class      required
says       The last of -f and -i decides: -i -f does not prompt, -f -i
           does.
test       t/007-f-i-last-wins.sh

assertion  XCU.mv.008
anchor     utilities/mv.html#DESCRIPTION
class      required
says       When source and destination are the same file, mv does not
           remove the destination and the contents survive; with two
           distinct names the source name may be removed, with one entry
           nothing changes.
test       t/008-same-file.sh

assertion  XCU.mv.009
anchor     utilities/mv.html#DESCRIPTION
class      required
says       mv of a directory onto an existing non-directory is an error
           that changes neither.
test       t/009-dir-onto-file.sh

assertion  XCU.mv.010
anchor     utilities/mv.html#DESCRIPTION
class      required
says       mv of a non-directory to a target_file with a trailing slash is
           an error and the source is not moved.
test       t/010-trailing-slash.sh

assertion  XCU.mv.011
anchor     utilities/mv.html#DESCRIPTION
class      required
says       mv moves a symbolic link as a link, not what it refers to.
test       t/011-symlink.sh

assertion  XCU.mv.012
anchor     utilities/mv.html#EXIT STATUS
anchor     utilities/V3_chap01.html#1.4
class      required
says       If one source cannot be moved, mv diagnoses it, moves the
           remaining sources, and exits non-zero.
test       t/012-error-continue.sh

assertion  XCU.mv.013
anchor     utilities/mv.html#DESCRIPTION
class      required
says       A final operand that is a symbolic link to an existing
           directory is used as the target directory.
test       t/013-dir-symlink-target.sh

assertion  XCU.mv.014
anchor     utilities/mv.html#DESCRIPTION
class      required
says       mv keeps the modification time and permission bits of the file
           it moves.
test       t/014-attributes.sh

# Locale, time zone and message variables (h2a). A locale other than the POSIX locale is made with
# localedef (core/pcloc.sh); making locales is optional (POSIX2_LOCALEDEF), so those tests report
# NOTINUSE without it.

assertion  XCU.mv.015
anchor     utilities/mv.html#ENVIRONMENT VARIABLES
anchor     basedefs/V1_chap07.html#7.3.6
anchor     basedefs/V1_chap08.html#8.2
class      required
says       The response to the question of mv -i is affirmative when it
           matches the yesexpr of the locale that LC_MESSAGES names, with
           LC_ALL, LANG and a null LC_ALL treated as XBD 8.2 says.
timeout    120
test       t/015-locale-messages-yesexpr.sh

assertion  XCU.mv.016
anchor     utilities/mv.html#ENVIRONMENT VARIABLES
anchor     basedefs/V1_chap08.html#8.2
class      required
says       A collating element in the yesexpr of the locale named by
           LC_MESSAGES is interpreted in the collating sequence of the locale
           that LC_COLLATE names.
timeout    120
test       t/016-locale-collate-yesexpr.sh

assertion  XCU.mv.017
anchor     utilities/mv.html#ENVIRONMENT VARIABLES
anchor     basedefs/V1_chap08.html#8.2
class      required
says       A character class in the yesexpr of the locale named by
           LC_MESSAGES is the class of the locale that LC_CTYPE names.
timeout    120
test       t/017-locale-ctype-yesexpr.sh

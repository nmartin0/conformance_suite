# XCU sh-simple-commands
# Copyright (c) 2026 Nicholas Martin. All rights reserved.

assertion  XCU.sh-simple-commands.001
anchor     utilities/V3_chap02.html#2.9.1.2
class      required
says       A command made only of variable assignments sets the variables in
           the current shell environment.
test       t/001-assign-only.sh

assertion  XCU.sh-simple-commands.002
anchor     utilities/V3_chap02.html#2.9.1.2
class      required
says       Assignments before a regular utility or built-in are exported to
           that command only: the utility sees them and the shell's own
           value is unchanged afterwards.
test       t/002-prefix-utility.sh

assertion  XCU.sh-simple-commands.003
anchor     utilities/V3_chap02.html#2.9.1.2
class      required
says       Assignments before a special built-in affect the current
           environment and stay after it finishes.
test       t/003-prefix-special.sh

assertion  XCU.sh-simple-commands.004
anchor     utilities/V3_chap02.html#2.9.1.2
class      required
says       An assignment before a function call is in effect while the
           function runs.
test       t/004-prefix-function.sh

assertion  XCU.sh-simple-commands.005
anchor     utilities/V3_chap02.html#2.9.1.2
anchor     utilities/V3_chap02.html#2.8.1
class      required
says       An assignment before a command to a read-only variable is a
           variable assignment error: a non-interactive shell exits with a
           non-zero status, whether the command is a built-in or an external
           utility.
test       t/005-readonly-prefix.sh

assertion  XCU.sh-simple-commands.006
anchor     utilities/V3_chap02.html#2.9.1.1
class      required
says       The command name is the first field produced by expanding the
           words in order: a word that expands to nothing is skipped, and
           with no command name left the assignments apply to the current
           environment.
test       t/006-name-from-expansion.sh

assertion  XCU.sh-simple-commands.007
anchor     utilities/V3_chap02.html#2.9.1.1
class      required
says       The value of an assignment gets tilde expansion (also after a
           colon), parameter expansion, command and arithmetic substitution
           and quote removal, but no field splitting and no pathname
           expansion.
test       t/007-assign-expansions.sh

assertion  XCU.sh-simple-commands.008
anchor     utilities/V3_chap02.html#2.9.1.3
class      required
says       A simple command with no command name has status zero, or the
           status of the last command substitution it ran.
test       t/008-no-name-status.sh

assertion  XCU.sh-simple-commands.009
anchor     utilities/V3_chap02.html#2.9.1.3
class      required
says       Redirections of a command with no command name are done in a
           subshell: an output redirection creates or truncates the file,
           and a descriptor opened that way is not open afterwards.
test       t/009-no-name-redirection.sh

assertion  XCU.sh-simple-commands.010
anchor     utilities/V3_chap02.html#2.9.1.3
class      required
says       A failing redirection of a command with no command name fails
           with a non-zero status and a diagnostic.
test       t/010-no-name-redirect-error.sh

assertion  XCU.sh-simple-commands.011
anchor     utilities/V3_chap02.html#2.9.1.4
class      required
says       A special built-in is found before any file in PATH: an
           executable named exit in a PATH directory is not run for exit 3.
test       t/011-special-first.sh

assertion  XCU.sh-simple-commands.012
anchor     utilities/V3_chap02.html#2.9.1.4
class      required
says       A function is used before a utility found in PATH, and once the
           function is removed the utility is found.
test       t/012-function-before-path.sh

assertion  XCU.sh-simple-commands.013
anchor     utilities/V3_chap02.html#2.9.1.4
anchor     utilities/V3_chap01.html#1.7
class      required
says       An intrinsic utility such as umask is not looked up in PATH: an
           executable named umask in a PATH directory is not run.
test       t/013-intrinsic-no-path.sh

assertion  XCU.sh-simple-commands.014
anchor     utilities/V3_chap02.html#2.9.1.4
class      required
says       A command name with a slash is run as given with no PATH search,
           and a name without a slash is searched in PATH, not in the
           working directory.
test       t/014-slash-no-path.sh

assertion  XCU.sh-simple-commands.015
anchor     utilities/V3_chap02.html#2.9.1.4
class      required
says       A command that is not found gives status 127 and a message on
           standard error.
test       t/015-not-found-status.sh

assertion  XCU.sh-simple-commands.016
anchor     utilities/V3_chap02.html#2.8.2
class      required
says       A file that exists but cannot be executed (no execute permission)
           gives status 126.
test       t/016-not-executable-status.sh

assertion  XCU.sh-simple-commands.017
anchor     utilities/V3_chap02.html#2.9.1.6
class      required
says       A file that is not in an executable format (a script with no #!
           line) is run by a shell, with its arguments, and its exit status
           is returned; for a name with a slash $0 is that name.
test       t/017-script-fallback.sh

assertion  XCU.sh-simple-commands.018
anchor     utilities/V3_chap02.html#2.8.2
class      required
says       A command ended by a signal gives a status above 128.
test       t/018-signal-status.sh

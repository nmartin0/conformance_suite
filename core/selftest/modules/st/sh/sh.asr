assertion  ST.sh.001
says       A shell test reporting PASS is PASS.
test       t/001-pass.sh
expect     PASS

assertion  ST.sh.002
says       pc_fail in the test phase is FAIL.
test       t/002-fail.sh
expect     FAIL

assertion  ST.sh.003
says       pc_fail in the setup phase is UNRESOLVED.
test       t/003-setup-fail.sh
expect     UNRESOLVED

assertion  ST.sh.004
says       A shell test exiting without a result is UNINITIATED.
test       t/004-no-result.sh
expect     UNINITIATED

assertion  ST.sh.005
says       A function shadowing printf cannot corrupt the helper's output.
test       t/005-shadow-printf.sh
expect     PASS

assertion  ST.sh.006
says       pc_need_file on a missing file in the test phase is FAIL.
test       t/006-need-file-test.sh
expect     FAIL

assertion  ST.sh.007
says       pc_need_file on a missing file in the setup phase is UNRESOLVED.
test       t/007-need-file-setup.sh
expect     UNRESOLVED

assertion  ST.sh.008
says       pc_need_file on files that exist is silent.
test       t/008-need-file-present.sh
expect     PASS
